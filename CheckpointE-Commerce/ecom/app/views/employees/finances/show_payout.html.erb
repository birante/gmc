<% content_for :active_tab, 'finances' %>

<!-- Container principal -->
<div class="flex flex-col min-h-screen bg-gray-50">
  <main class="flex-1 px-4 sm:px-6 lg:px-12 xl:px-28 py-6">
    <% if @vendor && @payout %>
      <!-- En-tête -->
      <div class="mb-6">
        <%= link_to url_with_shop(payouts_employees_finances_path, @current_shop), class: "inline-flex items-center text-sm text-gray-600 hover:text-[#551694] mb-3" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Retour aux reversements
        <% end %>
        <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
          Reversement <%= @payout.payout_month %>/<%= @payout.payout_year %>
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          Détails du reversement
        </p>
      </div>

      <!-- Informations du reversement -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <div class="lg:col-span-2 space-y-6">
          <!-- Détails du reversement -->
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Informations du reversement</h2>
            <dl class="space-y-3">
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Montant</dt>
                <dd class="text-sm font-semibold text-gray-900">
                  <%= number_with_delimiter(@payout.amount, delimiter: ' ') %> FCFA
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Statut</dt>
                <dd>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                    <%= case @payout.status
                        when 'paid' then 'bg-green-100 text-green-800'
                        when 'pending' then 'bg-yellow-100 text-yellow-800'
                        when 'processing' then 'bg-blue-100 text-blue-800'
                        when 'failed' then 'bg-red-100 text-red-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= @payout.status.humanize %>
                  </span>
                </dd>
              </div>
              <% if @payout.reference_number %>
                <div class="flex justify-between">
                  <dt class="text-sm text-gray-500">Numéro de référence</dt>
                  <dd class="text-sm font-medium text-gray-900"><%= @payout.reference_number %></dd>
                </div>
              <% end %>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Boutique</dt>
                <dd class="text-sm font-medium text-gray-900"><%= @payout.shop.name %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Créé le</dt>
                <dd class="text-sm font-medium text-gray-900"><%= @payout.created_at.strftime("%d/%m/%Y à %H:%M") %></dd>
              </div>
              <% if @payout.paid_at %>
                <div class="flex justify-between">
                  <dt class="text-sm text-gray-500">Payé le</dt>
                  <dd class="text-sm font-medium text-gray-900"><%= @payout.paid_at.strftime("%d/%m/%Y à %H:%M") %></dd>
                </div>
              <% end %>
            </dl>
          </div>

          <!-- Transactions associées -->
          <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
              <h2 class="text-lg font-semibold text-gray-900">Transactions associées</h2>
            </div>
            <div class="divide-y divide-gray-200">
              <% credit_transactions = @payout.shop_transactions.where(transaction_type: 'credit').includes(:order) %>
              <% if credit_transactions.any? %>
                <% credit_transactions.each do |transaction| %>
                  <div class="px-6 py-4 hover:bg-gray-50">
                    <div class="flex items-center justify-between">
                      <div>
                        <p class="font-medium text-gray-900"><%= transaction.description %></p>
                        <p class="text-sm text-gray-500">
                          <%= transaction.created_at.strftime("%d/%m/%Y à %H:%M") %>
                          <% if transaction.order %>
                            - Commande #<%= transaction.order.id %>
                          <% end %>
                        </p>
                      </div>
                      <div class="text-right">
                        <p class="font-semibold text-[#551694]">
                          +<%= number_with_delimiter(transaction.amount, delimiter: ' ') %> FCFA
                        </p>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="px-6 py-12 text-center">
                  <p class="text-gray-500">Aucune transaction associée</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Résumé -->
        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Résumé</h2>
            <div class="space-y-3">
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Nombre de transactions</span>
                <span class="font-medium text-gray-900"><%= credit_transactions.count %></span>
              </div>
              <div class="border-t border-gray-200 pt-3 flex justify-between">
                <span class="text-base font-semibold text-gray-900">Total</span>
                <span class="text-base font-bold text-[#551694]">
                  <%= number_with_delimiter(@payout.amount, delimiter: ' ') %> FCFA
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-4">Reversement non trouvé</p>
        <%= link_to "Retour aux reversements", url_with_shop(payouts_employees_finances_path, @current_shop),
            class: "inline-block px-6 py-3 bg-[#551694] text-white rounded-md hover:bg-[#451384] transition-colors" %>
      </div>
    <% end %>
  </main>
  
  <!-- Footer -->
</div>
