<%= form_with model: @shop_color,
              url: (@shop_color.persisted? ? url_with_shop(vendors_color_path(@shop_color), @current_shop) : url_with_shop(vendors_colors_path, @current_shop)),
              method: (@shop_color.persisted? ? :patch : :post),
              class: "space-y-5",
              data: { controller: "color-picker" } do |f| %>
  <% if @shop_color.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-3 text-sm">
      <ul class="list-disc list-inside">
        <% @shop_color.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nom de la couleur", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name,
        placeholder: "ex. Rouge cerise",
        class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500" %>
    <p class="text-xs text-gray-500 mt-1">Ce nom sera affiché aux acheteurs sur la fiche produit.</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Couleur</label>
    <div class="flex items-center gap-3">
      <%= f.color_field :hex_code,
          value: @shop_color.hex_code.presence || "#551694",
          data: { color_picker_target: "picker", action: "input->color-picker#syncFromPicker" },
          class: "h-12 w-14 border border-gray-300 rounded-md cursor-pointer" %>
      <%= f.text_field :hex_code,
          placeholder: "#551694",
          data: { color_picker_target: "hex", action: "input->color-picker#syncFromHex" },
          class: "block w-40 px-3 py-2 text-sm font-mono uppercase border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500" %>
    </div>
    <p class="text-xs text-gray-500 mt-1">Format hexadécimal (ex. #D2042D). Utilisé pour la pastille couleur sur les fiches produit.</p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit (@shop_color.persisted? ? "Enregistrer" : "Ajouter à la palette"),
        class: "inline-flex items-center px-4 py-2 bg-[#551694] text-white rounded-lg hover:bg-[#4a1468] transition-colors cursor-pointer" %>
    <%= link_to "Annuler", url_with_shop(vendors_colors_path, @current_shop),
        class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
