<%# Partial pour afficher une alerte de limite atteinte %>
<% if shop %>
  <% capabilities = shop.capabilities %>
  
  <%# Alerte produits %>
  <% max_products = capabilities.max_products %>
  <% current_products = shop.items_count %>
  <% if max_products && current_products.to_i >= max_products.to_i %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-red-700">
            <%= t('vendors.plan_limits.products_limit_reached_alert', max: max_products) %>
            <%= link_to t('vendors.plan_limits.upgrade_plan'), "#", class: "font-medium underline hover:text-red-600" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%# Alerte employés %>
  <% max_employees = capabilities.max_employees %>
  <% current_employees = shop.employees.active.count %>
  <% if max_employees && current_employees.to_i >= max_employees.to_i %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-red-700">
            <%= t('vendors.plan_limits.employees_limit_reached_alert', max: max_employees) %>
            <%= link_to t('vendors.plan_limits.upgrade_plan'), "#", class: "font-medium underline hover:text-red-600" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

