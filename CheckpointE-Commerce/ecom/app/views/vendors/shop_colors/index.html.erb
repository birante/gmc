<% content_for :active_tab, "couleurs" %>

<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Mes couleurs</h1>
      <p class="text-gray-600 mt-1">
        Palette privée de <strong><%= @current_shop.name %></strong> — réutilisez ces couleurs sur toutes vos fiches produit.
      </p>
    </div>

    <%= link_to url_with_shop(new_vendors_color_path, @current_shop),
        class: "inline-flex items-center px-4 py-2 bg-[#551694] text-white rounded-lg hover:bg-[#4a1468] transition-colors" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Ajouter une couleur
    <% end %>
  </div>

  <% if @active_colors.any? %>
    <section class="mb-10">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Palette active (<%= @active_colors.size %>)</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
        <% @active_colors.each do |color| %>
          <%= render "color_card", color: color %>
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="bg-white border border-dashed border-gray-300 rounded-lg p-10 text-center mb-10">
      <div class="mx-auto w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center mb-4">
        <svg class="w-7 h-7 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-1">Aucune couleur enregistrée</h3>
      <p class="text-sm text-gray-600 mb-4">Créez votre première couleur pour la réutiliser lors de la création de vos variantes produit.</p>
      <%= link_to "Ajouter une couleur", url_with_shop(new_vendors_color_path, @current_shop),
          class: "inline-flex items-center px-4 py-2 bg-[#551694] text-white rounded-lg hover:bg-[#4a1468] transition-colors" %>
    </div>
  <% end %>

  <% if @archived_colors.any? %>
    <section>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Archivées (<%= @archived_colors.size %>)</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
        <% @archived_colors.each do |color| %>
          <%= render "color_card", color: color %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
