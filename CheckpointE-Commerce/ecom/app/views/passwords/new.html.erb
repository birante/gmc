<div class="flex flex-col items-center justify-center text-center mb-6 md:mb-8">
  <%= link_to root_path do %>
    <%= image_tag "logo-2.svg", alt: "aa", class: "mb-3 md:mb-4 h-[24px] md:h-[26px] w-auto cursor-pointer hover:opacity-80 transition-opacity", loading: "eager", fetchpriority: "high", decoding: "async", width: 96, height: 26 %>
  <% end %>
  <h1 class="text-xl md:text-2xl font-bold px-2"><%= t('.title') %></h1>
  <p class="text-xs md:text-sm text-gray-600 px-2"><%= t('.subtitle') %></p>
</div>
<div class="w-full max-w-md mx-auto">
  <%= form_with url: passwords_path, local: true do |f| %>
    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-3 md:px-4 py-2 md:py-3 rounded mb-4 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-3 md:px-4 py-2 md:py-3 rounded mb-4 text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <div class="my-4 md:my-5">
      <%= f.label :email_address, t('.email_label'), class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.email_field :email_address, placeholder: t('.email_placeholder'), required: true, autofocus: true, autocomplete: "email", value: params[:email_address], class: "block bg-[#F9F9F9] rounded-md border border-[#E9E9E9] px-3 py-2.5 md:py-3 mt-2 w-full focus:outline-blue-600 text-base" %>
    </div>
    <div class="mt-8 md:mt-12">
      <%= f.submit t('.submit'), class: "btn bg-[#F8F5FF] !border border-[#8953FF] w-full text-[#551694] py-3 md:py-4 rounded hover:bg-[#8953FF] hover:text-white transition-colors text-base md:text-lg font-medium" %>
    </div>
    <div class="mt-4 md:mt-6 text-center">
      <p class="text-xs md:text-sm text-gray-600">
        <%= link_to t('.back_to_login'), new_client_session_path, class: "text-[#551694] hover:text-[#8953FF] font-medium" %>
      </p>
    </div>
  <% end %>
</div>
