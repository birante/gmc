<%# Footer - Design avec accessibilité %>
<footer class="bg-black text-white" role="contentinfo">
  <!-- Services Bar - Icônes arrondis -->
  <section class="container mx-auto px-4 lg:px-[50px] pt-12 pb-8" aria-labelledby="footer-services-heading">
    <h2 id="footer-services-heading" class="sr-only"><%= t('footer.services_title', default: 'Nos services') %></h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4" role="list">
      <!-- Livraison Express -->
      <div class="flex items-center justify-center gap-3 border border-[#DBDFE9] rounded-full py-2.5 px-4 md:py-3 md:px-6" role="listitem">
        <%= image_tag "storefront/icons/delivery-truck.svg", 
            alt: "", 
            aria: { hidden: "true" },
            class: "w-8 h-8 md:w-10 md:h-10 flex-shrink-0",
            loading: "lazy",
            width: 40,
            height: 40 %>
        <span class="text-[#B5B5C3] font-medium text-sm md:text-base"><%= t('footer.express_delivery', default: 'Livraison Express partout à Dakar') %></span>
      </div>
      <!-- Assistance à l'achat -->
      <div class="flex items-center justify-center gap-3 border border-[#DBDFE9] rounded-full py-2.5 px-4 md:py-3 md:px-6" role="listitem">
        <%= image_tag "storefront/icons/customer-support.svg", 
            alt: "", 
            aria: { hidden: "true" },
            class: "w-8 h-8 md:w-10 md:h-10 flex-shrink-0",
            loading: "lazy",
            width: 40,
            height: 40 %>
        <span class="text-[#B5B5C3] font-medium text-sm md:text-base"><%= t('footer.purchase_assistance', default: "Assistance à l'achat") %></span>
      </div>
      <!-- Paiements sécurisés -->
      <div class="flex items-center justify-center gap-3 border border-[#DBDFE9] rounded-full py-2.5 px-4 md:py-3 md:px-6" role="listitem">
        <%= image_tag "storefront/icons/payment-secure.svg", 
            alt: "", 
            aria: { hidden: "true" },
            class: "w-8 h-8 md:w-10 md:h-10 flex-shrink-0",
            loading: "lazy",
            width: 40,
            height: 40 %>
        <span class="text-[#B5B5C3] font-medium text-sm md:text-base"><%= t('footer.secure_payments', default: 'Paiements sécurisés') %></span>
      </div>
    </div>
  </section>
  <!-- Main Footer Content -->
  <div class="container mx-auto px-4 lg:px-[50px] py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Column 1: Contact Info -->
      <section class="lg:col-span-1" aria-labelledby="footer-contact-heading">
        <h3 id="footer-contact-heading" class="text-lg font-bold text-white uppercase mb-4 tracking-wide">
          aa - <%= t('footer.your_marketplace', default: 'Vendez plus facilement. Acheter en toute confiance.') %>
        </h3>
        <!-- Assistance -->
        <p class="text-[#B4BFDA] text-sm uppercase mb-2"><%= t('footer.support_247', default: 'Assistance 24/7') %></p>
        <a href="tel:+221778818383" 
           class="block text-white text-2xl md:text-3xl font-bold tracking-tight mb-6 hover:text-[#551694] transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded"
           aria-label="<%= t('footer.call_support', default: 'Appelez le support au +221 77 881 83 83') %>">
          +221 77 881 83 83
        </a>
        <!-- Address -->
        <address class="not-italic">
          <p class="text-[#B4BFDA] text-sm leading-relaxed mb-2">
            Quartier Ouakam, Mamelles, Lot numéro<br>
            752, Cité El Hadj Malick SY
          </p>
          <a href="mailto:contact@aa.com" 
             class="text-[#B4BFDA] text-sm hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded">
            contact@aa.com
          </a>
        </address>
        <!-- Social Links -->
        <nav class="flex items-center gap-3 mt-6" aria-label="<%= t('footer.social_links', default: 'Réseaux sociaux') %>">
          <%= link_to coming_soon_path, 
              class: "w-[35px] h-[35px] rounded-full bg-[#E1E3EB] flex items-center justify-center hover:bg-[#551694] group transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 focus:ring-offset-black",
              "aria-label": "Twitter / X" do %>
            <svg class="w-3.5 h-3.5 text-black group-hover:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          <% end %>
          <%= link_to coming_soon_path, 
              class: "w-[35px] h-[35px] rounded-full bg-[#E1E3EB] flex items-center justify-center hover:bg-[#551694] group transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 focus:ring-offset-black",
              "aria-label": "Facebook" do %>
            <svg class="w-3.5 h-3.5 text-black group-hover:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          <% end %>
          <%= link_to coming_soon_path, 
              class: "w-[35px] h-[35px] rounded-full bg-[#E1E3EB] flex items-center justify-center hover:bg-[#551694] group transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 focus:ring-offset-black",
              "aria-label": "Instagram" do %>
            <svg class="w-3.5 h-3.5 text-black group-hover:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          <% end %>
          <%= link_to coming_soon_path, 
              class: "w-[35px] h-[35px] rounded-full bg-[#E1E3EB] flex items-center justify-center hover:bg-[#551694] group transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 focus:ring-offset-black",
              "aria-label": "YouTube" do %>
            <svg class="w-3.5 h-3.5 text-black group-hover:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          <% end %>
          <%= link_to coming_soon_path, 
              class: "w-[35px] h-[35px] rounded-full bg-[#E1E3EB] flex items-center justify-center hover:bg-[#551694] group transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 focus:ring-offset-black",
              "aria-label": "TikTok" do %>
            <svg class="w-4 h-4 text-black group-hover:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
            </svg>
          <% end %>
        </nav>
      </section>
      <!-- Column 2: aa Infos -->
      <nav aria-labelledby="footer-infos-heading">
        <h3 id="footer-infos-heading" class="text-lg font-bold text-white uppercase mb-6">aa Infos</h3>
        <ul class="space-y-3">
          <li>
            <%= link_to t('footer.about', default: 'À Propos de aa'), about_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.contact', default: 'Contact'), contact_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.careers', default: 'Carrières'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.blog', default: 'Blog'), blog_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.sitemap', default: 'Plan du site'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.stores', default: 'Nos boutiques'), client_shops_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
        </ul>
      </nav>
      <!-- Column 3: Assistance -->
      <nav aria-labelledby="footer-assistance-heading">
        <h3 id="footer-assistance-heading" class="text-lg font-bold text-white uppercase mb-6"><%= t('footer.assistance', default: 'Assistance') %></h3>
        <ul class="space-y-3">
          <li>
            <%= link_to t('footer.customer_service', default: 'Service Client'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.track_order', default: 'Suivi de Commande'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.faqs', default: 'FAQs'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.my_account', default: 'Mon Compte'), client_dashboard_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.terms', default: "Conditions d'utilisation"), terms_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.privacy', default: 'Vie Privée'), privacy_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.personal_data', default: 'Données Personnelles'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.cookies', default: 'Cookies'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
        </ul>
      </nav>
      <!-- Column 4: Partenaires -->
      <nav aria-labelledby="footer-partners-heading">
        <h3 id="footer-partners-heading" class="text-lg font-bold text-white uppercase mb-6"><%= t('footer.partners', default: 'Partenaires') %></h3>
        <ul class="space-y-3">
          <li>
            <%= link_to t('footer.become_seller', default: 'Devenir Vendeur'), become_vendor_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.affiliations', default: 'Affiliations'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.advertising', default: 'Publicité'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
          <li>
            <%= link_to t('footer.partnerships', default: 'Partenariats'), coming_soon_path, class: "text-[#B4BFDA] hover:text-white text-sm capitalize transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] rounded" %>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <!-- Bottom Bar -->
  <div class="container mx-auto px-4 lg:px-[50px] py-6 border-t border-gray-800">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Copyright -->
      <p class="text-[#78829D] text-sm opacity-80">
        © <%= Time.current.year %> <span class="text-[#B5B5C3] font-semibold">aa SARL</span> . <%= t('footer.all_rights', default: 'Tous droits réservés') %>
      </p>
      <!-- Payment Methods -->
      <ul class="flex items-center gap-3 list-none p-0 m-0" aria-label="<%= t('footer.payment_methods', default: 'Moyens de paiement acceptés') %>">
        <li><%= image_tag "storefront/payment/payment-1.png", alt: "Milad", class: "h-[22px] w-auto rounded-sm", loading: "lazy", width: 50, height: 22 %></li>
        <li><%= image_tag "storefront/payment/payment-2.png", alt: "Orange Money", class: "h-[22px] w-auto rounded-sm", loading: "lazy", width: 50, height: 22 %></li>
        <li><%= image_tag "storefront/payment/payment-3.png", alt: "Wave", class: "h-[19px] w-auto", loading: "lazy", width: 50, height: 19 %></li>
        <li><%= image_tag "storefront/payment/payment-4.png", alt: "Visa", class: "h-[17px] w-auto", loading: "lazy", width: 50, height: 17 %></li>
        <li><%= image_tag "storefront/payment/payment-5.png", alt: "Mastercard", class: "h-[22px] w-auto rounded-sm", loading: "lazy", width: 50, height: 22 %></li>
      </ul>
    </div>
  </div>
</footer>
