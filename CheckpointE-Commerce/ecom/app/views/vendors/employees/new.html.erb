<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <!-- En-tête avec bouton retour -->
  <div class="mb-6">
    <%= link_to vendors_employees_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-[#551694] transition-colors mb-4" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <%= t('.back_to_list') %>
    <% end %>
    
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
      <p class="text-gray-600 mt-2 text-sm sm:text-base">
        <%= t('.subtitle') %>
      </p>
    </div>
  </div>
  
  <!-- Formulaire -->
  <div class="bg-gray-50 rounded-lg p-4 sm:p-6">
    <%= render 'form', employee: @employee %>
  </div>
</div>
