<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
      const slides = carousel.querySelectorAll('.carousel-slide');
      const indicators = carousel.querySelectorAll('.carousel-indicator');
      const prevBtn = carousel.querySelector('.carousel-prev');
      const nextBtn = carousel.querySelector('.carousel-next');
      if (!slides.length) return;

      let currentSlide = 0;
      let autoplayInterval;

      function showSlide(n) {
        if (n >= slides.length) currentSlide = 0;
        if (n < 0) currentSlide = slides.length - 1;
        slides.forEach((slide, index) => { slide.style.opacity = index === currentSlide ? '1' : '0'; });
        indicators.forEach((indicator, index) => {
          indicator.style.backgroundColor = index === currentSlide ? 'white' : 'rgba(255,255,255,0.5)';
          indicator.style.width = index === currentSlide ? '32px' : '12px';
        });
      }
      function nextSlide() { currentSlide++; showSlide(currentSlide); resetAutoplay(); }
      function prevSlide() { currentSlide--; showSlide(currentSlide); resetAutoplay(); }
      function startAutoplay() { autoplayInterval = setInterval(nextSlide, 8000); }
      function resetAutoplay() { clearInterval(autoplayInterval); startAutoplay(); }

      prevBtn?.addEventListener('click', prevSlide);
      nextBtn?.addEventListener('click', nextSlide);
      indicators.forEach((indicator, index) => { indicator.addEventListener('click', () => { currentSlide = index; showSlide(currentSlide); resetAutoplay(); }); });
      carousel.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
      carousel.addEventListener('mouseleave', startAutoplay);
      startAutoplay();
    });
  });
</script>
<style>
  @keyframes progress { 0% { width: 0%; } 100% { width: 100%; } }
</style>
