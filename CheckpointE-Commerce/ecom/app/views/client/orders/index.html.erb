<% content_for :client_content do %>
  <div>
    <!-- Breadcrumb -->
    <div class="mb-4">
      <nav class="text-sm text-gray-500 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
        <%= link_to "Accueil", root_path, class: "hover:text-[#551694] transition-colors duration-150" %> 
        <span class="text-gray-400">/</span>
        <%= link_to "Mon compte", client_account_path, class: "hover:text-[#551694] transition-colors duration-150" %>
        <span class="text-gray-400">/</span>
        <span class="text-gray-900 font-medium">Mes commandes</span>
      </nav>
    </div>

    <!-- Titre de la page -->
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">Mes commandes</h1>

    <!-- Tabs de filtrage -->
    <div class="mb-6 overflow-x-auto">
      <nav class="flex space-x-1 bg-gray-100 p-1 rounded-lg min-w-max shadow-inner" role="tablist">
        <%= link_to client_orders_path(status: 'in_progress'), 
            class: "px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 #{params[:status] == 'in_progress' || params[:status].blank? ? 'bg-white text-[#551694] shadow-sm font-semibold' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
          En cours
        <% end %>
        <%= link_to client_orders_path(status: 'delivered'), 
            class: "px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 #{params[:status] == 'delivered' ? 'bg-white text-[#551694] shadow-sm font-semibold' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
          Livrées
        <% end %>
        <%= link_to client_orders_path(status: 'all'), 
            class: "px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 #{params[:status] == 'all' ? 'bg-white text-[#551694] shadow-sm font-semibold' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
          Toutes les commandes
        <% end %>
      </nav>
    </div>

    <% if @orders.any? %>
      <div class="space-y-6">
        <% @orders.each_with_index do |order, index| %>
          <!-- Carte de commande -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-all duration-200 animate-slide-in-right" style="animation-delay: <%= index * 0.05 %>s;">
            <!-- En-tête de la commande -->
            <div class="px-6 py-4 bg-white border-b border-gray-200">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
                  <span><strong>Commandé le:</strong> <%= l(order.created_at, format: "%d %b %Y") %></span>
                  <span><strong>Panier:</strong> <%= order.order_items.size %> <%= order.order_items.size > 1 ? 'Articles' : 'Article' %></span>
                  <span><strong>Total:</strong> <%= number_to_currency(order.final_amount, unit: "FCFA", precision: 0) %></span>
                </div>
                <div class="flex items-center gap-4">
                  <%= link_to client_order_path(order), class: "inline-flex items-center gap-2 text-[#551694] hover:text-[#451384] text-sm font-medium underline transition-colors" do %>
                    Suivre la commande
                  <% end %>
                  <%= link_to coming_soon_path, class: "text-[#551694] hover:text-[#451384] text-sm font-medium underline transition-colors" do %>
                    Facture
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Articles de la commande -->
            <div class="divide-y divide-gray-200">
              <% order.order_items.each do |order_item| %>
                <div class="p-6">
                  <div class="bg-gray-50 rounded-lg p-5">
                  <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Informations du merchant -->
                      <div class="lg:w-1/4 flex-shrink-0">
                      <div class="flex items-start gap-3">
                        <!-- Logo merchant -->
                          <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0 overflow-hidden">
                            <% if order_item.shop.logo.attached? %>
                              <%= storage_image_tag(order_item.shop.logo, variant_name: :logo_small, alt: order_item.shop.name, class: "w-full h-full object-cover", width: 48, height: 48) %>
                            <% else %>
                              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                              </svg>
                            <% end %>
                          </div>
                          <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-gray-900 mb-1.5 text-sm"><%= order_item.shop.name %></h3>
                            <!-- Rating temporairement désactivé -->
                            <p class="text-xs text-gray-500">
                            <%= order_item.item.product_sub_category&.name || 'Catégorie' %>
                          </p>
                          </div>
                        </div>
                      </div>

                      <!-- Détails du produit -->
                      <div class="lg:w-3/4 flex gap-4">
                        <!-- Image produit -->
                        <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-200 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden">
                          <% if order_item.item.has_image? %>
                            <%= storage_image_tag(order_item.item.display_image, variant_name: :thumbnail, alt: order_item.item.name, class: "w-full h-full object-cover rounded-lg", width: 96, height: 96) %>
                          <% else %>
                            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                          <% end %>
                        </div>

                        <div class="flex-1 min-w-0">
                          <!-- Nom du produit -->
                          <h4 class="font-semibold text-gray-900 text-sm mb-1.5"><%= order_item.item.name %></h4>
                          
                          <!-- Statut badge -->
                          <div class="mb-2">
                            <% status_class = case order_item.delivery_status
                                when 'pending_shipment' then 'bg-yellow-100 text-yellow-700'
                                when 'shipped' then 'bg-[#551694]/10 text-[#551694]'
                                when 'delivered' then 'bg-green-100 text-green-700'
                                when 'failed' then 'bg-red-100 text-red-700'
                                when 'returned' then 'bg-orange-100 text-orange-700'
                                else 'bg-gray-100 text-gray-700'
                                end %>
                            <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full <%= status_class %>">
                              • <%= case order_item.delivery_status
                                  when 'pending_shipment' then 'En attente d\'expédition'
                                  when 'shipped' then 'Expédition en cours'
                                  when 'delivered' then 'Livré'
                                  when 'failed' then 'Échoué'
                                  when 'returned' then 'Retourné'
                                  else order_item.delivery_status.humanize
                                  end %>
                            </span>
                          </div>
                        
                        <!-- Attributs/Variantes -->
                        <% if order_item.item_variant %>
                          <% attrs = order_item.item_variant.attribute_display_hash %>
                          <% if attrs.any? %>
                            <div class="flex flex-wrap gap-2 mb-3">
                              <% attrs.each do |name, value| %>
                                  <span class="px-2.5 py-1 text-xs bg-gray-200 text-gray-700 rounded-full">
                                  <%= value %>
                                </span>
                              <% end %>
                            </div>
                          <% end %>
                        <% end %>

                        <!-- Quantité et prix -->
                        <div class="flex items-center gap-4 mb-3">
                          <span class="text-sm text-gray-600">
                            <span class="font-medium">Qté:</span> 
                            <span class="font-semibold text-gray-900"><%= order_item.quantity %></span>
                          </span>
                          <span class="text-base font-bold text-gray-900">
                            <%= number_to_currency(order_item.unit_price, unit: "FCFA", precision: 0, separator: " ", delimiter: " ") %>
                          </span>
                        </div>

                        <!-- Actions : noter le produit (uniquement si livré et pas encore noté) -->
                        <% if order_item.delivery_status == "delivered" %>
                          <% existing_review = @reviews_by_item_id&.dig(order_item.item_id) %>
                          <% if existing_review %>
                            <details class="group/review">
                              <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-xs font-medium hover:bg-emerald-100 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span>Avis publié</span>
                                <span class="text-emerald-600/70 group-open/review:hidden">— voir</span>
                                <svg class="w-3.5 h-3.5 transition-transform group-open/review:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                              </summary>

                              <div class="mt-3 p-4 bg-gray-50 rounded-lg border border-gray-200 space-y-3">
                                <%# Affichage lecture seule : étoiles + commentaire + date %>
                                <div class="flex items-center gap-2">
                                  <div class="flex items-center">
                                    <% (1..5).each do |i| %>
                                      <svg class="w-5 h-5 <%= i <= existing_review.rating ? 'text-yellow-400' : 'text-gray-300' %> fill-current" viewBox="0 0 20 20">
                                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                                      </svg>
                                    <% end %>
                                  </div>
                                  <span class="text-sm font-semibold text-gray-900"><%= existing_review.rating %>/5</span>
                                  <span class="text-xs text-gray-500">· <%= l(existing_review.created_at.to_date, format: :long) rescue existing_review.created_at.strftime("%d/%m/%Y") %></span>
                                </div>

                                <% if existing_review.comment.present? %>
                                  <p class="text-sm text-gray-700 italic leading-relaxed">« <%= existing_review.comment %> »</p>
                                <% else %>
                                  <p class="text-xs text-gray-400 italic">Aucun commentaire</p>
                                <% end %>

                                <% if existing_review.can_be_edited_by?(current_user) %>
                                  <div class="flex items-center justify-between gap-2 pt-2 border-t border-gray-200">
                                    <details class="group/edit">
                                      <summary class="list-none cursor-pointer text-xs font-medium text-[#551694] hover:text-[#451384] inline-flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        <span class="group-open/edit:hidden">Modifier</span>
                                        <span class="hidden group-open/edit:inline">Annuler</span>
                                      </summary>

                                      <%= form_with model: existing_review, url: client_review_path(existing_review), method: :patch, local: true, html: { multipart: false }, data: { turbo: false }, class: "mt-3 space-y-3" do |form| %>
                                        <div data-controller="star-rating" data-star-rating-selected-value="<%= existing_review.rating %>" class="flex items-center gap-2">
                                          <% (1..5).each do |rating| %>
                                            <button type="button"
                                                    data-star-rating-target="star"
                                                    data-rating="<%= rating %>"
                                                    data-action="click->star-rating#selectRating mouseenter->star-rating#hoverStar mouseleave->star-rating#resetStars"
                                                    class="focus:outline-none focus:ring-2 focus:ring-yellow-400 rounded"
                                                    aria-label="<%= rating %> étoile<%= 's' if rating > 1 %>">
                                              <svg class="w-7 h-7 text-gray-300 fill-current transition-colors" viewBox="0 0 20 20">
                                                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                                              </svg>
                                            </button>
                                          <% end %>
                                          <%= hidden_field_tag "review[rating]", existing_review.rating, data: { star_rating_target: "ratingInput" }, required: true %>
                                        </div>

                                        <div data-controller="char-counter" data-char-counter-max-value="2000">
                                          <label class="block text-xs font-medium text-gray-700 mb-1.5">Votre commentaire <span class="text-gray-400 font-normal">(optionnel)</span></label>
                                          <%= text_area_tag "review[comment]", existing_review.comment,
                                              rows: 3,
                                              maxlength: 2000,
                                              placeholder: "Qu'avez-vous pensé de ce produit ?",
                                              data: { action: "input->char-counter#updateCounter", char_counter_target: "textarea" },
                                              class: "w-full text-sm rounded-lg border-2 border-gray-200 bg-white focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/15 resize-none px-3 py-2 placeholder-gray-400 transition-colors" %>
                                          <div class="mt-1 text-right">
                                            <span class="text-[11px] text-gray-400" data-char-counter-target="counter"><%= existing_review.comment.to_s.length %> / 2000</span>
                                          </div>
                                        </div>

                                        <div class="flex justify-end">
                                          <%= form.submit "Enregistrer",
                                              class: "px-4 py-1.5 bg-[#551694] text-white text-xs font-semibold rounded-md hover:bg-[#451384] transition-colors disabled:opacity-50",
                                              data: { disable_with: "Enregistrement…" } %>
                                        </div>
                                      <% end %>
                                    </details>

                                    <%= button_to client_review_path(existing_review), method: :delete,
                                        data: { turbo_confirm: "Supprimer cet avis ?" },
                                        form: { data: { turbo: false } },
                                        class: "text-xs font-medium text-red-600 hover:text-red-700 inline-flex items-center gap-1 bg-transparent border-0 p-0 cursor-pointer" do %>
                                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"></path>
                                      </svg>
                                      Supprimer
                                    <% end %>
                                  </div>
                                <% else %>
                                  <p class="text-xs text-gray-400 italic pt-2 border-t border-gray-200">Cet avis n'est plus modifiable (au-delà de 7 jours).</p>
                                <% end %>
                              </div>
                            </details>
                          <% else %>
                            <details class="group/review">
                              <summary class="list-none cursor-pointer inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#551694] text-white text-xs font-semibold hover:bg-[#451384] transition-colors">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                                <span class="group-open/review:hidden">Noter ce produit</span>
                                <span class="hidden group-open/review:inline">Fermer</span>
                              </summary>

                              <%= form_with url: client_reviews_path, method: :post, local: true, html: { multipart: false }, data: { turbo: false }, class: "mt-3 p-4 bg-gray-50 rounded-lg border border-gray-200 space-y-3" do |form| %>
                                <%= hidden_field_tag :item_id, order_item.item_id %>
                                <%= hidden_field_tag "review[order_item_id]", order_item.id %>

                                <div data-controller="star-rating" class="flex items-center gap-2">
                                  <% (1..5).each do |rating| %>
                                    <button type="button"
                                            data-star-rating-target="star"
                                            data-rating="<%= rating %>"
                                            data-action="click->star-rating#selectRating mouseenter->star-rating#hoverStar mouseleave->star-rating#resetStars"
                                            class="focus:outline-none focus:ring-2 focus:ring-yellow-400 rounded"
                                            aria-label="<%= rating %> étoile<%= 's' if rating > 1 %>">
                                      <svg class="w-7 h-7 text-gray-300 fill-current transition-colors" viewBox="0 0 20 20">
                                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                                      </svg>
                                    </button>
                                  <% end %>
                                  <%= hidden_field_tag "review[rating]", "", data: { star_rating_target: "ratingInput" }, required: true %>
                                  <span class="ml-2 text-xs text-gray-500" data-star-rating-target="ratingText">Votre note</span>
                                </div>

                                <div data-controller="char-counter" data-char-counter-max-value="2000">
                                  <label class="block text-xs font-medium text-gray-700 mb-1.5">Votre commentaire <span class="text-gray-400 font-normal">(optionnel)</span></label>
                                  <%= text_area_tag "review[comment]", nil,
                                      rows: 3,
                                      maxlength: 2000,
                                      placeholder: "Qu'avez-vous pensé de ce produit ? Qualité, livraison, conformité…",
                                      data: { action: "input->char-counter#updateCounter", char_counter_target: "textarea" },
                                      class: "w-full text-sm rounded-lg border-2 border-gray-200 bg-white focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/15 resize-none px-3 py-2 placeholder-gray-400 transition-colors" %>
                                  <div class="mt-1 text-right">
                                    <span class="text-[11px] text-gray-400" data-char-counter-target="counter">0 / 2000</span>
                                  </div>
                                </div>

                                <div class="flex justify-end">
                                  <%= form.submit "Publier mon avis",
                                      class: "px-4 py-1.5 bg-[#551694] text-white text-xs font-semibold rounded-md hover:bg-[#451384] transition-colors disabled:opacity-50",
                                      data: { disable_with: "Publication…" } %>
                                </div>
                              <% end %>
                            </details>
                          <% end %>
                        <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @orders.total_pages > 1 %>
        <div class="mt-8 pt-6 border-t border-gray-200">
          <div class="flex items-center justify-center gap-2">
            <%= link_to client_orders_path(page: @orders.current_page - 1, status: params[:status]), 
                class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-[#551694] transition-colors #{'opacity-50 cursor-not-allowed pointer-events-none' if @orders.current_page <= 1}",
                disabled: @orders.current_page <= 1 do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            <% end %>

            <div class="flex items-center gap-1">
              <% (1..@orders.total_pages).each do |page_num| %>
                <% if page_num == @orders.current_page %>
                  <span class="w-10 h-10 flex items-center justify-center text-sm font-semibold text-white bg-[#551694] rounded-full">
                    <%= sprintf('%02d', page_num) %>
                  </span>
                <% elsif page_num == 1 || page_num == @orders.total_pages || (page_num >= @orders.current_page - 1 && page_num <= @orders.current_page + 1) %>
                  <%= link_to sprintf('%02d', page_num), client_orders_path(page: page_num, status: params[:status]), 
                      class: "w-10 h-10 flex items-center justify-center text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-full hover:bg-gray-50 hover:border-[#551694] transition-colors" %>
                <% elsif page_num == @orders.current_page - 2 || page_num == @orders.current_page + 2 %>
                  <span class="px-2 text-gray-500">...</span>
                <% end %>
              <% end %>
            </div>

            <%= link_to client_orders_path(page: @orders.current_page + 1, status: params[:status]), 
                class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-[#551694] transition-colors #{'opacity-50 cursor-not-allowed pointer-events-none' if @orders.current_page >= @orders.total_pages}",
                disabled: @orders.current_page >= @orders.total_pages do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <div class="relative inline-block mb-6">
          <div class="relative">
            <svg class="w-32 h-32 mx-auto text-gray-200 animate-pulse-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
              <span class="text-3xl font-bold text-gray-400">0</span>
            </div>
          </div>
          <!-- Question marks as decorative elements -->
          <div class="absolute -top-2 -left-2 text-2xl text-gray-300 animate-bounce-slow">?</div>
          <div class="absolute -top-2 -right-2 text-2xl text-gray-300 animate-bounce-slow-delay">?</div>
        </div>
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Aucune commande</h2>
        <p class="text-gray-500 mb-8 max-w-md mx-auto">Vous n'avez pas de commande en cours pour l'instant. Parcourez nos produits et trouvez ce qui vous plaît !</p>
        <%= link_to client_items_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 font-medium shadow-sm" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>Découvrir les produits</span>
        <% end %>
      </div>
    <% end %>
  </div>
