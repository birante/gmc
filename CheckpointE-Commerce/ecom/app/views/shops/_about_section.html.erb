<%# Section "À propos" - Design amélioré %>
<div class="-mx-4 lg:-mx-[50px] bg-gradient-to-b from-gray-50 to-white px-4 lg:px-[50px] py-8 md:py-12">
  <div class="flex items-center gap-3 mb-2">
    <svg class="w-6 h-6" style="color: <%= primary_color %>;" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0z" clip-rule="evenodd"/>
    </svg>
    <h2 class="text-2xl md:text-3xl font-bold" style="color: var(--primary-color);">À propos de cette boutique</h2>
  </div>
  <p class="text-gray-500 text-sm mb-6 ml-9">Découvrez qui se cache derrière ces produits</p>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    <%# Description principale %>
    <div class="md:col-span-2 lg:col-span-2" itemprop="description">
      <div class="bg-white rounded-xl p-6 md:p-8 border border-gray-200 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <svg class="w-5 h-5" style="color: <%= primary_color %>;" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
          </svg>
          Notre histoire
        </h3>
        <p class="text-gray-700 leading-relaxed text-base">
          <%= shop.description.present? ? shop.description : "Une boutique dédiée à la qualité et au service client. Nous vous proposons une sélection rigoureuse de produits pour garantir votre satisfaction." %>
        </p>
      </div>
    </div>
    
    <%# Infos rapides - Colonne de droite %>
    <div class="lg:col-span-1">
      <div class="space-y-4">
        <%# Statut de boutique %>
        <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-2.77 3.066 3.066 0 00-3.58 3.03A3.066 3.066 0 006.267 3.455zm9.8 8.334c.652-.264 1.335-.622 2.01-1.067a3.066 3.066 0 001.735-2.749 3.066 3.066 0 00-3.58 3.03 3.066 3.066 0 00-.165 1.786zm5.108-5.618a3.066 3.066 0 11-6.132 0 3.066 3.066 0 016.132 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium text-gray-900">Vérifiée</span>
          </div>
          <p class="text-xs text-gray-600">Boutique officielle certifiée</p>
        </div>
        
        <%# Horaires d'ouverture %>
        <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium text-gray-900">Ouvert</span>
          </div>
          <p class="text-xs text-gray-600">Lun - Dim: 8h - 20h</p>
        </div>
      </div>
    </div>
  </div>
  
  <%# Informations de contact complètes %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mt-8">
    <%# Adresse %>
    <% if shop.address.present? %>
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 mt-0.5 flex-shrink-0" style="color: <%= primary_color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            <div class="text-sm font-semibold text-gray-900 mb-1">Localisation</div>
            <div class="text-sm text-gray-600 leading-relaxed"><%= shop.address %></div>
          </div>
        </div>
      </div>
    <% end %>

    <%# Téléphone %>
    <% if shop.contacts.any? && shop.contacts.first.phone_number.present? %>
      <% contact = shop.contacts.first %>
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 mt-0.5 flex-shrink-0" style="color: <%= primary_color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <div>
            <div class="text-sm font-semibold text-gray-900 mb-1">Contactez-nous</div>
            <a href="tel:+<%= contact.country_code %><%= contact.phone_number %>" class="text-sm font-medium transition-colors hover:underline" style="color: <%= primary_color %>;">
              +<%= contact.country_code %> <%= contact.phone_number %>
            </a>
            <p class="text-xs text-gray-500 mt-1">24h/24, 7j/7</p>
          </div>
        </div>
      </div>
    <% end %>

    <%# Secteurs %>
    <% if shop.sectors.any? %>
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-3 flex-col">
          <svg class="w-6 h-6" style="color: <%= primary_color %>;" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"/>
          </svg>
          <div class="w-full">
            <div class="text-sm font-semibold text-gray-900 mb-2">Nos secteurs</div>
            <div class="flex flex-wrap gap-2">
              <% shop.sectors.each do |sector| %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" style="background-color: <%= primary_color %>15; color: <%= primary_color %>;">
                  <%= sector.name %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
