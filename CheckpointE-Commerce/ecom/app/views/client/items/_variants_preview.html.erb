<% if item.variants_count > 1 %>
  <div class="text-xs text-gray-600 mb-2">
    <span class="font-medium"><%= item.variants_count %> variantes disponibles</span>
    
    <!-- Mini aperçu des variantes -->
    <div class="mt-1 flex flex-wrap gap-1">
      <% item.variants.first(3).each do |variant| %>
        <% if variant.display_name.present? %>
          <span class="inline-block px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
            <%= variant.display_name.truncate(20) %>
          </span>
        <% end %>
      <% end %>
      <% if item.variants_count > 3 %>
        <span class="inline-block px-2 py-1 bg-gray-200 text-gray-600 rounded text-xs">
          +<%= item.variants_count - 3 %>
        </span>
      <% end %>
    </div>
  </div>
<% elsif item.variants_count == 1 %>
  <% variant = item.variants.first %>
  <% if variant && variant.display_name.present? %>
    <div class="text-xs text-gray-600 mb-2">
      <%= variant.display_name %>
    </div>
  <% end %>
<% end %>
