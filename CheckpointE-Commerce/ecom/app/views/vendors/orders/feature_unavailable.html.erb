<div class="w-full px-4 sm:px-6 lg:px-8 py-6">
  <div class="w-full">
    <!-- En-tête simple -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-2">
        <%= t('vendors.orders.feature_unavailable.title') %>
      </h1>
      <p class="text-base sm:text-lg text-gray-600">
        <%= t('vendors.orders.feature_unavailable.subtitle') %>
      </p>
    </div>

    <!-- Contenu -->
    <div class="bg-white rounded-lg shadow-lg border border-gray-200 px-6 sm:px-8 lg:px-12 py-8 sm:py-10">
      <!-- Message explicatif simple -->
      <p class="text-base sm:text-lg text-gray-700 mb-8">
        <%= t('vendors.orders.feature_unavailable.explanation', 
              current_plan: @current_plan&.name || t('vendors.orders.feature_unavailable.no_plan')) %>
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Plan actuel -->
        <div class="lg:col-span-1">
          <% if @current_plan %>
            <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4">
              <%= t('vendors.orders.feature_unavailable.current_plan') %>
            </h2>
            <div class="bg-gray-50 rounded-lg p-4 sm:p-6 border border-gray-200">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex-1">
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-1"><%= @current_plan.name %></h3>
                  <p class="text-sm sm:text-base text-gray-600"><%= @current_plan.description %></p>
                </div>
                <span class="inline-flex items-center justify-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800 w-fit">
                  <%= t('vendors.orders.feature_unavailable.current') %>
                </span>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Plans disponibles avec gestion des commandes -->
        <div class="lg:col-span-2">
          <% if @available_plans&.any? %>
            <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4 sm:mb-6">
              <%= t('vendors.orders.feature_unavailable.upgrade_title') %>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              <% @available_plans.each do |plan| %>
                <% next if plan.code == "ACCESS" %>
                
                <div class="bg-white border-2 border-purple-200 rounded-lg p-4 sm:p-6 hover:border-purple-400 hover:shadow-lg transition-all">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900"><%= plan.name %></h3>
                    <span class="inline-flex items-center justify-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 w-fit">
                      <%= t('vendors.orders.feature_unavailable.includes_feature') %>
                    </span>
                  </div>
                  <p class="text-sm sm:text-base text-gray-600 mb-4"><%= plan.description %></p>
                  <div class="space-y-2 mb-4 sm:mb-6">
                    <div class="flex items-center text-sm sm:text-base text-gray-700">
                      <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      <%= t('vendors.orders.feature_unavailable.order_management_included') %>
                    </div>
                  </div>
                  <%= button_to t('vendors.orders.feature_unavailable.upgrade_button'), 
                      upgrade_plan_vendors_orders_path(shop_slug: @current_shop&.slug), 
                      method: :post,
                      params: { plan_id: plan.id },
                      class: "w-full inline-flex justify-center items-center px-4 py-2 sm:py-3 border border-transparent rounded-md shadow-sm text-sm sm:text-base font-medium text-white bg-[#551694] hover:bg-[#451384] transition-colors" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-4 mt-8 sm:mt-10 pt-6 sm:pt-8 border-t border-gray-200">
        <%= link_to t('vendors.orders.feature_unavailable.back_to_dashboard'), 
            url_with_shop(vendors_dashboard_path, @current_shop), 
            class: "flex-1 inline-flex justify-center items-center px-4 py-2 sm:py-3 border border-gray-300 rounded-md shadow-sm text-sm sm:text-base font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" %>
        <%= link_to t('vendors.orders.feature_unavailable.contact_support'), 
            "#", 
            class: "flex-1 inline-flex justify-center items-center px-4 py-2 sm:py-3 border border-transparent rounded-md shadow-sm text-sm sm:text-base font-medium text-white bg-[#551694] hover:bg-[#451384] transition-colors" %>
      </div>
    </div>
  </div>
</div>

