<%= form_with model: post, local: true, class: "space-y-4" do |f| %>
  <% if post.errors.any? %>
    <div class="rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-700">
      <div class="font-medium mb-1"><%= pluralize(post.errors.count, "error") %>:</div>
      <ul class="list-disc list-inside"><% post.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :title, class: "w-full px-3 py-2 rounded-md border border-gray-300", required: true %>
  </div>

  <div>
    <%= f.label :content, class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :content, rows: 14, class: "w-full px-3 py-2 rounded-md border border-gray-300 font-mono text-sm" %>
    <p class="text-xs text-slate-500 mt-1">HTML tags allowed: p, br, strong, em, a, img, h1-h4, ul, ol, li, blockquote, code, pre, hr.</p>
  </div>

  <div>
    <%= f.label :excerpt, class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :excerpt, rows: 2, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
  </div>

  <div class="grid sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :category_id, "Category", class: "block text-sm font-medium mb-1" %>
      <%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: "—" }, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium mb-1" %>
      <%= f.select :status, Post.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
    </div>
    <div>
      <label for="post_tag_names" class="block text-sm font-medium mb-1">Tags (comma-separated)</label>
      <input type="text" id="post_tag_names" name="post[tag_names]" value="<%= post.tags.map(&:name).join(', ') %>" class="w-full px-3 py-2 rounded-md border border-gray-300">
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <label class="inline-flex items-center gap-2 text-sm">
      <%= f.check_box :is_featured, class: "rounded" %> Featured
    </label>
    <label class="inline-flex items-center gap-2 text-sm">
      <%= f.check_box :allow_comments, class: "rounded" %> Allow comments
    </label>
  </div>

  <details class="rounded-md border border-gray-200 p-4">
    <summary class="text-sm font-medium cursor-pointer text-slate-700">SEO</summary>
    <div class="mt-3 space-y-3">
      <%= f.text_field :meta_title,        class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm", placeholder: "Meta title" %>
      <%= f.text_area  :meta_description, rows: 2, class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm", placeholder: "Meta description" %>
      <%= f.text_field :meta_keywords,    class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm", placeholder: "Meta keywords" %>
    </div>
  </details>

  <div class="flex gap-2 justify-end">
    <%= link_to "Cancel", (post.persisted? ? post : posts_path), class: "px-3 py-1.5 rounded-md text-sm text-slate-600 hover:text-slate-900" %>
    <%= f.submit (post.persisted? ? "Save changes" : "Create post"), class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-500" %>
  </div>
<% end %>
