{
  "name": "dom-benchmark",
  "version": "1.0.0",
  "description": "Puppeteer harness benchmarking the four to-do apps",
  "scripts": {
    "bench": "node run.mjs",
    "bench:quick": "node run.mjs --iterations 5 --warmup 2 --memory-runs 2",
    "bench:no-build": "node run.mjs --skip-build",
    "install-browser": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.3",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "25.12.0"
  },
  "private": true,
  "type": "module"
}
