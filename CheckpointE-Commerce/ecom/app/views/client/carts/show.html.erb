<div class="container mx-auto px-4 lg:px-[50px] py-6 sm:py-10">

  <!-- En-tête -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
      <% if @cart.cart_items.any? %>
        <p class="text-sm text-gray-500 mt-1">
          <%= t('.item_count', count: @cart.cart_items.sum(:quantity)) %>
        </p>
      <% end %>
    </div>
    <%= link_to client_items_path, class: "inline-flex items-center gap-1.5 text-[#551694] hover:text-[#6a1fa8] transition-colors text-sm font-medium group" do %>
      <svg class="w-4 h-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <%= t('.continue_shopping') %>
    <% end %>
  </div>

  <div id="cart-content" data-controller="cart-total">
    <% if @cart.cart_items.any? %>

      <div class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-8">

        <!-- Table des articles (gauche) -->
        <div class="flex-1 min-w-0 lg:basis-[70%] lg:max-w-[70%]">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="border-b border-gray-100 bg-gray-50/70 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                    <th class="py-3 pl-4 sm:pl-6 pr-3 text-left" colspan="2"><%= t('.product') %></th>
                    <th class="hidden sm:table-cell py-3 pr-4 text-right"><%= t('.unit_price') %></th>
                    <th class="py-3 pr-4 text-center"><%= t('.quantity') %></th>
                    <th class="py-3 pr-2 text-right"><%= t('.item_total') %></th>
                    <th class="py-3 pl-2 pr-4 sm:pr-6 w-10"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% @cart.cart_items.each do |cart_item| %>
                    <%= render partial: 'client/carts/cart_item', locals: { cart_item: cart_item } %>
                  <% end %>
                </tbody>
              </table>
            </div>

            <!-- Footer : vider le panier -->
            <div class="px-4 sm:px-6 py-3 bg-gray-50 border-t border-gray-100 flex justify-end">
              <%= button_to clear_client_cart_path, method: :delete,
                    class: "inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-red-500 transition-colors font-medium",
                    data: { turbo: true, turbo_confirm: t('.clear_cart_confirm') } do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <%= t('.clear_cart') %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Résumé de commande (droite, sticky) -->
        <div class="w-full lg:basis-[30%] lg:max-w-[30%] lg:min-w-[280px] flex-shrink-0 lg:self-start" id="cart-summary">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-5 sticky top-6">
            <h2 class="text-sm font-bold text-gray-900 mb-3"><%= t('.summary') %></h2>

            <div class="space-y-2 mb-4">
              <div class="flex justify-between items-center text-sm text-gray-700">
                <span><%= t('.subtotal') %></span>
                <span id="cart-subtotal" class="font-semibold text-gray-900" data-cart-total-target="subtotal">
                  <%= number_to_currency(@cart.total_amount, unit: @cart.cart_items.first&.item&.currency&.symbol || 'FCFA', precision: 0) %>
                </span>
              </div>
              <div class="flex justify-between items-start gap-3 text-sm text-gray-700">
                <span class="flex-shrink-0"><%= t('.delivery') %></span>
                <span class="text-gray-500 italic text-xs text-right"><%= t('.to_calculate') %></span>
              </div>
            </div>

            <div class="border-t border-gray-200 pt-3 mb-4">
              <div class="flex justify-between items-center">
                <span class="font-bold text-gray-900 text-sm"><%= t('.total') %></span>
                <span class="text-xl font-bold text-[#551694]" id="cart-total" data-cart-total-target="total">
                  <%= number_to_currency(@cart.total_amount, unit: @cart.cart_items.first&.item&.currency&.symbol || 'FCFA', precision: 0) %>
                </span>
              </div>
            </div>

            <% if user_signed_in? %>
              <%= link_to new_client_order_path,
                    class: "w-full flex items-center justify-center gap-2 px-5 py-3.5 bg-[#551694] text-white rounded-xl hover:bg-[#6a1fa8] transition-all duration-200 font-semibold text-sm shadow-sm hover:shadow-md" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <%= t('.place_order') %>
              <% end %>
            <% else %>
              <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                <p class="text-xs text-amber-800 text-center leading-relaxed">
                  <svg class="w-3.5 h-3.5 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= t('.login_to_checkout') %>
                </p>
              </div>
              <div class="space-y-2">
                <% return_to_url = url_for(controller: 'client/orders', action: 'new', only_path: true) %>
                <%= link_to new_client_session_path(return_to: return_to_url),
                      class: "w-full flex items-center justify-center gap-2 px-5 py-3 bg-[#551694] text-white rounded-xl hover:bg-[#6a1fa8] transition-all duration-200 font-semibold text-sm" do %>
                  <%= t('.login') %>
                <% end %>
                <%= link_to new_client_registration_path(return_to: return_to_url),
                      class: "w-full flex items-center justify-center gap-2 px-5 py-3 bg-white text-[#551694] border border-[#551694] rounded-xl hover:bg-purple-50 transition-all duration-200 font-semibold text-sm" do %>
                  <%= t('.signup') %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

      </div>

    <% else %>
      <!-- Panier vide -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 py-20 px-6 text-center">
        <div class="max-w-sm mx-auto">
          <div class="w-20 h-20 mx-auto mb-6 bg-purple-50 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-800 mb-2"><%= t('.empty_cart_title') %></h2>
          <p class="text-gray-500 mb-8 text-sm"><%= t('.empty_cart_message') %></p>
          <%= link_to client_items_path,
                class: "inline-flex items-center gap-2 px-6 py-3 bg-[#551694] text-white rounded-xl hover:bg-[#6a1fa8] transition-all duration-200 font-semibold text-sm shadow-sm hover:shadow-md" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <%= t('.view_catalog') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
