<% content_for :title, "Devenir vendeur sur aa - Vendez en ligne simplement" %>
<% content_for :meta_description, "Lancez votre boutique sur aa, gérez votre catalogue, vos commandes et vos paiements depuis une interface pensée pour les vendeurs." %>
<% content_for :meta_keywords, "devenir vendeur, aa, boutique en ligne, vendre sur aa, marketplace sénégal" %>
<% content_for :canonical_url, request.original_url.split("?").first %>
<% content_for :structured_data do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "<%= request.original_url.split('?').first %>#webpage",
          "url": "<%= request.original_url.split('?').first %>",
          "name": "<%= j content_for(:title) %>",
          "description": "<%= j content_for(:meta_description) %>",
          "inLanguage": "<%= I18n.locale == :fr ? 'fr' : 'en' %>",
          "isPartOf": {
            "@type": "WebSite",
            "name": "aa",
            "url": "<%= root_url %>"
          },
          "breadcrumb": { "@id": "<%= request.original_url.split('?').first %>#breadcrumb" }
        },
        {
          "@type": "BreadcrumbList",
          "@id": "<%= request.original_url.split('?').first %>#breadcrumb",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "<%= root_url %>" },
            { "@type": "ListItem", "position": 2, "name": "Devenir vendeur", "item": "<%= request.original_url.split('?').first %>" }
          ]
        }
      ]
    }
  </script>
<% end %>
