<% content_for :title, "Dashboard" %>
<h1 class="text-2xl font-semibold mb-6">Dashboard</h1>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% @stats.each do |label, value| %>
    <div class="rounded-xl bg-white border border-gray-200 p-5">
      <div class="text-xs text-slate-500 uppercase tracking-wider"><%= label.to_s.titleize %></div>
      <div class="mt-1 text-3xl font-bold"><%= value %></div>
    </div>
  <% end %>
</div>

<div class="grid gap-6 mt-8 md:grid-cols-2">
  <section class="rounded-xl bg-white border border-gray-200 p-5">
    <h2 class="font-semibold mb-3">Recent posts</h2>
    <ul class="space-y-2 text-sm">
      <% @recent_posts.each do |p| %>
        <li>
          <%= link_to p.title, post_path(p), class: "text-slate-800 hover:text-indigo-600 font-medium" %>
          <span class="text-slate-500 text-xs">· <%= p.status %> · <%= p.author&.full_name %></span>
        </li>
      <% end %>
    </ul>
  </section>
  <section class="rounded-xl bg-white border border-gray-200 p-5">
    <h2 class="font-semibold mb-3">Recent comments</h2>
    <ul class="space-y-2 text-sm">
      <% @recent_comments.each do |c| %>
        <li>
          <span class="text-slate-500 text-xs"><%= c.user&.full_name || "Guest" %>:</span>
          <%= truncate(c.content, length: 100) %>
          <span class="text-xs text-slate-400">(<%= c.status %>)</span>
        </li>
      <% end %>
    </ul>
  </section>
</div>
