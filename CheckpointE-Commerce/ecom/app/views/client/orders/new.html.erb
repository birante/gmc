<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 w-full">
  <!-- En-tête -->
  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2"><%= t('.title') %></h1>
    <button type="button" onclick="document.dispatchEvent(new CustomEvent('cart-sheet:open'))" class="inline-flex items-center gap-2 text-[#551694] hover:text-[#6a1fa8] transition-colors text-sm sm:text-base font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span><%= t('.back_to_cart') %></span>
    </button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-6 lg:gap-8"
       data-controller="order"
       data-order-currency-symbol-value="<%= @cart.cart_items.first.item.currency.symbol %>"
       data-order-cart-total-value="<%= @cart.total_amount %>"
       data-order-initial-delivery-fee-value="<%= @initial_delivery_fee || 0 %>">
    <!-- Colonne gauche : LIVRAISON & PAIEMENT -->
    <div class="lg:col-span-1">

      <%= form_with url: client_orders_path, method: :post, local: true, data: { turbo: false }, class: "space-y-8", id: "order-form" do |form| %>
        
        <!-- Section 1 : Livraison -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8 mb-8">
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">1- Livraison</h2>
          
          <!-- Adresse de livraison -->
          <div class="mb-6" id="address-section">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-sm sm:text-base font-semibold text-gray-900">Adresse de livraison</label>
              <button 
                type="button"
                id="toggle-new-address-btn"
                onclick="toggleNewAddressForm()"
                class="text-sm text-[#551694] hover:text-[#6a1fa8] font-medium flex items-center gap-1 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>Nouvelle adresse</span>
              </button>
            </div>

            <!-- Placeholder pour le formulaire d'adresse (sera rempli par JavaScript) -->
            <div id="new-address-form-placeholder"></div>

            <!-- Sélection d'adresse existante -->
            <div id="existing-addresses">
              <% if @addresses.any? %>
                <% selected_address = @addresses.find { |a| a.slug == @selected_address_slug } || @addresses.first %>
                <div class="relative">
                  <input 
                    type="text" 
                    value="<%= selected_address&.street_address %>" 
                    readonly
                    id="selected-address-display"
                    class="w-full px-4 py-3 pr-12 text-sm sm:text-base border-2 border-gray-200 rounded-lg focus:outline-none focus:border-[#551694] bg-gray-50 text-gray-900 font-medium"
                  />
                  <button 
                    type="button"
                    class="absolute right-3 top-1/2 -translate-y-1/2 p-2 text-gray-400 hover:text-[#551694] transition-colors"
                    onclick="document.getElementById('address-modal').classList.remove('hidden')"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </button>
                </div>
                <%= hidden_field_tag :address_id, selected_address.slug, id: "selected-address-id" %>
                
                <!-- Modal pour changer d'adresse -->
                <div id="address-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                  <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                    <div class="p-6 border-b border-gray-200 flex items-center justify-between">
                      <h3 class="text-xl font-bold text-gray-900">Choisir une adresse</h3>
                      <button type="button" onclick="document.getElementById('address-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                      </button>
                    </div>
                    <div class="p-6 space-y-3" id="addresses-list">
                      <% @addresses.each do |address| %>
                        <label class="flex items-start gap-3 p-4 border-2 rounded-lg cursor-pointer hover:border-[#551694] transition-colors <%= 'border-[#551694] bg-[#551694]/5' if address.slug == @selected_address_slug %>">
                          <%= radio_button_tag :address_id_modal, address.slug, address.slug == @selected_address_slug, 
                              class: "mt-1 w-4 h-4 text-[#551694] focus:ring-[#551694]",
                              onchange: "selectAddress('#{address.slug}', '#{address.street_address.gsub("'", "\\'")}');" %>
                          <div class="flex-1">
                            <p class="font-semibold text-gray-900"><%= address.street_address %></p>
                          </div>
                        </label>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="text-center py-8 bg-gray-50 rounded-lg border border-gray-200" id="no-addresses-message">
                  <p class="text-gray-600 mb-4">Vous n'avez pas encore d'adresse enregistrée</p>
                  <button 
                    type="button"
                    onclick="toggleNewAddressForm()"
                    class="inline-block px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] transition-colors font-medium"
                  >
                    Ajouter une adresse
                  </button>
                </div>
              <% end %>
            </div>
          </div>

          <script>
            function toggleNewAddressForm() {
              const form = document.getElementById('new-address-form');
              const btn = document.getElementById('toggle-new-address-btn');
              const existing = document.getElementById('existing-addresses');
              const placeholder = document.getElementById('new-address-form-placeholder');
              
              if (form && form.classList.contains('hidden')) {
                // Déplacer le formulaire dans le placeholder pour qu'il apparaisse au bon endroit visuellement
                if (placeholder && form.parentNode !== placeholder) {
                  form.style.display = 'none';
                  form.classList.remove('hidden');
                  placeholder.appendChild(form);
                  form.style.display = '';
                } else {
                  form.classList.remove('hidden');
                }
                
                // Animation d'ouverture
                form.style.opacity = '0';
                form.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                  form.style.transition = 'all 0.3s ease-out';
                  form.style.opacity = '1';
                  form.style.transform = 'translateY(0)';
                }, 10);
                
                if (btn) btn.classList.add('hidden');
                if (existing) {
                  existing.style.opacity = '0';
                  setTimeout(() => {
                    existing.classList.add('hidden');
                  }, 200);
                }
                
                // Focus sur le premier champ
                setTimeout(() => {
                  const firstInput = form.querySelector('textarea, input[type="text"]');
                  if (firstInput) firstInput.focus();
                }, 350);
              } else if (form) {
                // Fermer avec animation
                form.style.transition = 'all 0.3s ease-in';
                form.style.opacity = '0';
                form.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                  form.classList.add('hidden');
                  // Remettre le formulaire à sa position d'origine (hors du formulaire de commande)
                  const orderFormContainer = document.querySelector('[data-controller="order"]');
                  if (orderFormContainer && form.parentNode === placeholder) {
                    orderFormContainer.appendChild(form);
                  }
                  
                  if (btn) btn.classList.remove('hidden');
                  if (existing) {
                    existing.classList.remove('hidden');
                    existing.style.opacity = '0';
                    setTimeout(() => {
                      existing.style.transition = 'opacity 0.3s ease-out';
                      existing.style.opacity = '1';
                    }, 10);
                  }
                }, 300);
              }
            }

            function selectAddress(slug, streetAddress) {
              document.getElementById('selected-address-id').value = slug;
              document.getElementById('selected-address-display').value = streetAddress;
              document.getElementById('address-modal').classList.add('hidden');
            }
          </script>
          
          <!-- Zone de livraison -->
          <div class="mb-8">
            <%= hidden_field_tag :delivery_zone_id, @selected_zone&.id, id: "zone-select" %>
            <label class="block text-sm sm:text-base font-semibold text-gray-900 mb-3">Zone de livraison</label>
            <div class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p id="selected-zone-name" class="font-semibold text-base text-gray-900"><%= @selected_zone&.name || 'Aucune zone sélectionnée' %></p>
                  <div id="selected-zone-description" class="text-sm text-gray-600 mt-1 leading-relaxed">
                    <%= format_delivery_zone_description(@selected_zone&.description.presence || @selected_zone&.name || 'Choisissez une zone pour voir la description.') %>
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2 shrink-0">
                  <span id="selected-zone-fee" class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold bg-[#efe8fb] text-[#551694] whitespace-nowrap">
                    <%= @selected_zone ? "#{number_with_delimiter(@selected_zone.base_fee.to_i)} FCFA" : '—' %>
                  </span>
                  <button type="button" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-[#D9CCE8] text-[#551694] text-sm font-medium hover:bg-[#f5f0ff] transition" data-action="click->order#openZoneModal">
                    Choisir
                  </button>
                </div>
              </div>
            </div>

            <div id="delivery-zone-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" data-action="click->order#closeZoneModal">
              <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto" data-action="click->order#stopPropagation">
                <div class="p-6 border-b border-gray-200 flex items-center justify-between">
                  <h3 class="text-xl font-bold text-gray-900">Choisir une zone de livraison</h3>
                  <button type="button" class="text-gray-400 hover:text-gray-600" data-action="click->order#closeZoneModal">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
                <div id="delivery-zones-container" class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <% @delivery_zones.each do |zone| %>
                    <% is_selected_zone = @selected_zone&.id == zone.id %>
                    <label class="zone-card flex items-start gap-3 p-4 sm:p-5 border-2 rounded-xl cursor-pointer transition-all hover:border-[#551694] hover:shadow-md <%= is_selected_zone ? 'border-[#551694] bg-[#551694]/5 shadow-sm' : 'border-gray-200 bg-white' %>" data-zone-id="<%= zone.id %>" data-zone-name="<%= zone.name %>" data-zone-description="<%= zone.description.presence || zone.name %>" data-zone-fee="<%= number_with_delimiter(zone.base_fee.to_i) %> FCFA">
                      <%= radio_button_tag :delivery_zone_id, zone.id, is_selected_zone,
                          id: "delivery_zone_#{zone.id}",
                          class: "mt-1 w-5 h-5 text-[#551694] focus:ring-[#551694] focus:ring-2 border-gray-300 cursor-pointer",
                          data: { action: "change->order#zoneSelected" } %>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                          <p class="font-semibold text-base text-gray-900 whitespace-normal break-words"><%= zone.name %></p>
                          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold bg-[#efe8fb] text-[#551694] whitespace-nowrap">
                            <%= number_with_delimiter(zone.base_fee.to_i) %> FCFA
                          </span>
                        </div>
                        <div class="zone-description text-sm text-gray-600 leading-relaxed"><%= format_delivery_zone_description(zone.description.presence || zone.name) %></div>
                      </div>
                      <div class="zone-check <%= is_selected_zone ? '' : 'hidden' %>">
                        <svg class="w-5 h-5 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Créneau de livraison -->
          <div data-order-target="slotSelect" data-selected-slot-id="<%= @selected_slot_id %>" class="mb-6">
            <label class="block text-sm sm:text-base font-semibold text-gray-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Créneau de livraison</span>
            </label>
            <% if @delivery_slots.present? %>
              <div class="grid grid-cols-2 gap-3" id="delivery-slots-container">
                <% @delivery_slots.each do |slot| %>
                  <label class="flex items-center gap-3 p-4 border-2 rounded-xl cursor-pointer transition-all hover:border-[#551694] hover:shadow-md group <%= 'border-[#551694] bg-[#551694]/5 shadow-sm' if slot.id.to_s == @selected_slot_id.to_s %> <%= 'border-gray-200 bg-white' unless slot.id.to_s == @selected_slot_id.to_s %>">
                    <%= radio_button_tag :delivery_slot_id, slot.id, slot.id.to_s == @selected_slot_id.to_s, 
                        class: "w-5 h-5 text-[#551694] focus:ring-[#551694] focus:ring-2 border-gray-300 cursor-pointer transition-all",
                        required: true,
                        data: { action: "change->order#slotSelected" } %>
                    <div class="flex-1 flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br <%= slot.id.to_s == @selected_slot_id.to_s ? 'from-[#551694] to-[#6a1fa8]' : 'from-gray-100 to-gray-200 group-hover:from-[#551694]/20 group-hover:to-[#6a1fa8]/20' %> rounded-lg flex items-center justify-center transition-all shadow-sm">
                          <svg class="w-5 h-5 <%= slot.id.to_s == @selected_slot_id.to_s ? 'text-white' : 'text-gray-400 group-hover:text-[#551694]' %> transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </div>
                        <div>
                          <p class="font-semibold text-sm sm:text-base text-gray-900"><%= slot.time_range %></p>
                          <p class="text-xs text-gray-500 mt-0.5">Disponible pour la livraison</p>
                        </div>
                      </div>
                      <% if slot.id.to_s == @selected_slot_id.to_s %>
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                        </div>
                      <% end %>
                    </div>
                  </label>
                <% end %>
              </div>
            <% else %>
              <div class="p-6 bg-gray-50 border-2 border-gray-200 rounded-xl text-center">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p class="text-sm text-gray-500 font-medium"><%= t('.select_zone_first') %></p>
                <p class="text-xs text-gray-400 mt-1">Sélectionnez d'abord une zone de livraison</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Section 2 : Méthode de paiement -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6" data-controller="payment-selection">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-4">2- Méthode de paiement</h2>
          <p class="text-xs sm:text-sm text-gray-500 mb-4 sm:mb-5">Choisissez comment vous souhaitez payer votre commande.</p>

          <% if @cart_effective_payment_codes == [] %>
            <div class="mb-4 p-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 text-sm">
              Aucun mode de paiement en ligne n’est compatible avec tous les articles du panier. Modifiez le panier ou contactez le service client.
            </div>
          <% end %>

          <% payment_options = checkout_payment_options(
            cart_effective_payment_codes: @cart_effective_payment_codes,
            cart_cash_delivery_blocked: @cart_cash_delivery_blocked
          ) %>

          <% if payment_options.empty? %>
            <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-900 text-sm">
              Aucun mode de paiement n’est disponible actuellement pour ce panier.
            </div>
          <% end %>
          
          <div class="grid grid-cols-2 sm:grid-cols-2 gap-2 sm:gap-3 mb-5">
            <% payment_options.each do |option| %>
              <% is_cash = option[:payment_type] == "cash" %>
              <% online_target = is_cash ? nil : "onlineLabel" %>
              <% label_classes = [
                "flex flex-col items-center justify-between gap-2 p-2.5 sm:p-3 border-2 border-gray-200 rounded-lg cursor-pointer transition-all hover:border-[#551694] hover:shadow-sm group min-h-[132px] sm:min-h-[144px]",
                is_cash ? "payment-cash" : "payment-online"
              ].join(" ") %>

              <label class="<%= label_classes %>" data-payment-type="<%= option[:payment_type] %>" data-payment-selection-target="<%= online_target %>">
                <%= radio_button_tag :payment_method, option[:value], false,
                    data: {
                      payment_selection_target: (is_cash ? "cashRadio" : "onlineRadio"),
                      action: (is_cash ? "change->payment-selection#cashSelected" : "change->payment-selection#onlineSelected")
                    },
                    required: true,
                    class: "w-4 h-4 text-[#551694] focus:ring-[#551694] self-start #{'payment-online-option' unless is_cash}" %>
                <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white rounded-lg flex items-center justify-center group-hover:scale-105 transition-transform shadow-sm border border-gray-200 p-2">
                  <%= image_tag option[:icon], alt: option[:label], class: "w-full h-full object-contain" %>
                </div>
                <div class="text-center">
                  <h3 class="font-semibold text-xs sm:text-sm text-gray-900"><%= option[:label] %></h3>
                  <% if option[:description].present? %>
                    <p class="text-[11px] sm:text-xs text-gray-500 mt-1 leading-tight"><%= option[:description] %></p>
                  <% end %>
                </div>
              </label>
            <% end %>
          </div>
          
          <!-- Bouton Payer -->
          <%= form.submit "Valider et payer",
              class: "w-full px-5 py-3.5 bg-gradient-to-r from-[#551694] to-[#6a1fa8] text-white rounded-lg hover:from-[#6a1fa8] hover:to-[#7d2bc0] transition-all duration-200 font-semibold text-sm sm:text-base shadow-md hover:shadow-lg transform hover:-translate-y-0.5 disabled:bg-gray-400 disabled:cursor-not-allowed disabled:opacity-50" %>
        </div>
      <% end %>
      
      <!-- Formulaire d'adresse (HORS du formulaire de commande pour éviter les conflits de validation) -->
      <% new_address = @new_address || current_user.addresses.new %>
      <div id="new-address-form" class="hidden mb-4 bg-white border-2 border-[#551694] rounded-xl shadow-lg p-5 sm:p-6 transition-all duration-300 ease-in-out">
        <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-200">
          <div class="w-10 h-10 bg-[#551694] rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-gray-900">Nouvelle adresse de livraison</h3>
            <p class="text-xs text-gray-500 mt-0.5">Remplissez les informations ci-dessous</p>
          </div>
        </div>
        
        <%= form_with model: new_address, url: client_addresses_path(from_checkout: true), method: :post, local: false, data: { turbo: true }, class: "space-y-6", id: "address-form" do |addr_form| %>
          <%= render "shared/form_errors", object: @new_address if defined?(@new_address) && @new_address.errors.any? %>
          
          <div class="mb-6">
            <%= addr_form.label :street_address, class: "block text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2" do %>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>Adresse complète</span>
            <% end %>
            <%= addr_form.text_area :street_address, rows: 3, class: "block w-full px-4 py-3 text-sm border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-[#551694] focus:border-[#551694] transition-all bg-gray-50 hover:bg-white", placeholder: "Ex: Rue 10, Immeuble XYZ, Appartement 5" %>
          </div>

          <div class="flex gap-3 pt-3 border-t border-gray-200">
            <button type="button" onclick="toggleNewAddressForm()" class="flex-1 px-5 py-3 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all text-sm font-semibold shadow-sm hover:shadow">
              Annuler
            </button>
            <button type="submit" class="flex-1 px-5 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#451384] transition-all text-sm font-semibold shadow-md hover:shadow-lg transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Enregistrer l'adresse</span>
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Colonne droite : Résumé de ma commande -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6 sticky top-8">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-4">Résumé de ma commande</h2>
        
        <!-- Liste des produits -->
        <div class="space-y-3 mb-5">
          <% @cart.cart_items.each do |cart_item| %>
            <div class="flex gap-3 pb-3 border-b border-gray-100 last:border-b-0 last:pb-0">
              <!-- Image produit -->
              <div class="w-16 h-16 bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden shadow-sm">
                <% if cart_item.item.has_image? %>
                  <%= storage_image_tag(cart_item.item.display_image, variant_name: :thumbnail, alt: cart_item.item.name, class: "w-full h-full object-cover", width: 64, height: 64) %>
                <% else %>
                  <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                <% end %>
              </div>
              
              <!-- Informations produit -->
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-sm text-gray-900 mb-0.5 line-clamp-2"><%= cart_item.item.name %></h3>
                <% if cart_item.variant&.display_name.present? %>
                  <p class="text-xs text-gray-600 mb-0.5 bg-gray-50 px-1.5 py-0.5 rounded inline-block"><%= cart_item.variant.display_name %></p>
                <% end %>
                <p class="text-xs text-gray-500 mb-1 font-medium">Qté: <%= cart_item.quantity %></p>
                <p class="font-bold text-sm text-gray-900">
                  <%= number_to_currency(cart_item.total_price, unit: cart_item.item.currency.symbol, precision: 0) %>
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Détails des prix -->
        <div class="space-y-2 mb-5">
          <div class="flex justify-between items-center text-sm text-gray-700">
            <span class="font-medium">Sous Total</span>
            <span class="font-semibold text-gray-900">
              <%= number_to_currency(@cart.total_amount, unit: @cart.cart_items.first.item.currency.symbol, precision: 0) %>
            </span>
          </div>
          <div class="flex justify-between items-center text-sm text-gray-700">
            <span class="font-medium">Livraison</span>
            <span class="font-semibold text-gray-900" data-order-target="deliveryFee">
              <% if @initial_delivery_fee.present? %>
                <%= number_to_currency(@initial_delivery_fee.to_f, unit: @cart.cart_items.first.item.currency.symbol, precision: 0) %>
              <% else %>
                <span class="text-gray-400 italic text-xs font-normal">Sélectionnez une zone</span>
              <% end %>
            </span>
          </div>
        </div>

        <!-- Total -->
        <div class="pt-3 border-t-2 border-gray-200">
          <div class="flex justify-between items-center">
            <span class="text-base font-bold text-gray-900">Total</span>
            <span class="text-xl font-bold text-[#551694]" data-order-target="finalTotal">
              <% total_with_delivery = @cart.total_amount + @initial_delivery_fee.to_f %>
              <%= number_to_currency(total_with_delivery, unit: @cart.cart_items.first.item.currency.symbol, precision: 0) %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
