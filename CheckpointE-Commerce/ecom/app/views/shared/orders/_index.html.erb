<%# Partial partagé : liste des commandes (vendor + employees).
     Locals attendus :
       orders_path                   String   URL de l'index commandes du portail (pour le formulaire de filtres / reset)
       signup_path                   String?  Lien d'inscription pour la branche d'erreur (vendor uniquement)
       signup_label                  String?  Libellé du bouton ci-dessus
     Instance vars : @vendor, @orders, @total_orders, @total_revenue, @recent_orders_count %>
<%
  signup_path  = local_assigns[:signup_path]
  signup_label = local_assigns[:signup_label]
%>

<% if @vendor %>
  <!-- En-tête -->
  <div class="mb-6">
    <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
      <%= t('vendors.orders.index.title') %>
    </h1>
    <p class="text-sm text-gray-500 mt-1">
      <%= t('vendors.orders.index.subtitle') %>
    </p>
  </div>

  <!-- Stats rapides -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mb-6">
    <!-- Total commandes -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.orders.index.total_orders') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_orders) %></p>
        </div>
        <div class="h-12 w-12 bg-blue-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Revenus total -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.orders.index.total_revenue') %></p>
          <p class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900 break-words"><%= number_with_delimiter(@total_revenue, delimiter: ' ') %> FCFA</p>
        </div>
        <div class="h-12 w-12 bg-green-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Commandes récentes (7 jours) -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.orders.index.recent_orders') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@recent_orders_count) %></p>
        </div>
        <div class="h-12 w-12 bg-purple-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtres et recherches -->
  <div class="bg-white rounded-lg shadow p-4 md:p-6 mb-6">
    <%= form_with url: orders_path, method: :get, local: true, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :shop_slug, params[:shop_slug] if params[:shop_slug].present? %>
      <%= hidden_field_tag :shop_id, params[:shop_id] if params[:shop_id].present? %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Filtre statut -->
        <div>
          <%= form.label :status, t('vendors.orders.index.status'), class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.select :status,
              options_for_select([
                [ t('vendors.orders.index.all'), "" ],
                [ t('vendors.orders.index.pending'), "pending" ],
                [ t('vendors.orders.index.processing'), "processing" ],
                [ t('vendors.orders.index.shipped'), "shipped" ],
                [ t('vendors.orders.index.delivered'), "delivered" ],
                [ t('vendors.orders.index.canceled'), "canceled" ]
              ], params[:status]),
              {},
              { class: "w-full bg-gray-50 border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-[#551694]" } %>
        </div>

        <!-- Date de début -->
        <div>
          <%= form.label :from, t('vendors.orders.index.from'), class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.date_field :from,
              value: params[:from],
              class: "w-full bg-gray-50 border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-[#551694]" %>
        </div>

        <!-- Date de fin -->
        <div>
          <%= form.label :to, t('vendors.orders.index.to'), class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.date_field :to,
              value: params[:to],
              class: "w-full bg-gray-50 border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-[#551694]" %>
        </div>

        <!-- Boutons actions -->
        <div class="flex items-end gap-2">
          <%= form.submit t('vendors.orders.index.filter'), class: "flex-1 px-4 py-2 bg-[#551694] text-white rounded-md hover:bg-[#451384] transition-colors text-sm font-medium cursor-pointer" %>
          <%= link_to t('vendors.orders.index.reset'), orders_path, class: "flex-1 text-center px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors text-sm font-medium" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Liste des commandes -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @orders.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.order') %></th>
              <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.client') %></th>
              <th class="hidden sm:table-cell px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.date') %></th>
              <th class="hidden md:table-cell px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.items') %></th>
              <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.amount') %></th>
              <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.status') %></th>
              <th class="px-4 md:px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.orders.index.action') %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 md:px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">#<%= order.id %></div>
                  <div class="text-xs text-gray-500"><%= order.slug %></div>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= order.user.first_name %> <%= order.user.last_name %>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-4 md:px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= order.created_at.strftime("%d/%m/%Y") %><br>
                  <span class="text-xs"><%= order.created_at.strftime("%H:%M") %></span>
                </td>
                <td class="hidden md:table-cell px-4 md:px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= order_items_scope_for_context(order).count %> article(s)
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                  <%= number_with_delimiter(order_items_scope_for_context(order).sum(:total_price), delimiter: ' ') %>
                  <span class="text-xs text-gray-500"><%= order.currency.code %></span>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= case order.status
                    when 'pending' then 'bg-yellow-100 text-yellow-800'
                    when 'processing' then 'bg-blue-100 text-blue-800'
                    when 'shipped' then 'bg-indigo-100 text-indigo-800'
                    when 'delivered' then 'bg-green-100 text-green-800'
                    when 'canceled' then 'bg-red-100 text-red-800'
                    else 'bg-gray-100 text-gray-800'
                  end %>">
                    <%= order.status.humanize %>
                  </span>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to t('vendors.orders.index.view'), order_path_for_context(order, shop_slug: params[:shop_slug], shop_id: params[:shop_id]), class: "text-[#551694] hover:text-[#451384]", data: { turbo_frame: "_top" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <p class="text-gray-500 text-lg font-medium"><%= t('vendors.orders.index.no_orders_found') %></p>
        <p class="text-gray-400 text-sm mt-1"><%= t('vendors.orders.index.no_orders_message') %></p>
      </div>
    <% end %>
  </div>

<% else %>
  <!-- État d'erreur : pas de vendeur associé -->
  <div class="text-center py-12">
    <p class="text-gray-500 mb-4"><%= t('vendors.orders.index.error_vendor_not_found') %></p>
    <% if signup_path.present? %>
      <%= link_to (signup_label || t('vendors.orders.index.signup')), signup_path, class: "inline-block px-6 py-3 bg-[#551694] text-white rounded-md hover:bg-[#451384] transition-colors" %>
    <% end %>
  </div>
<% end %>
