<%# Partial partagé : liste clients (vendor + employees).
     Locals attendus :
       client_path_for       Proc   ->(client) URL d'affichage d'un client
     Instance vars : @vendor, @clients, @total_clients, @active_clients, @total_orders, @total_revenue %>

<% if @vendor %>
  <!-- En-tête -->
  <div class="mb-6">
    <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
      <%= t('vendors.clients.index.title') %>
    </h1>
    <p class="text-sm text-gray-500 mt-1">
      <%= t('vendors.clients.index.subtitle') %>
    </p>
  </div>

  <!-- Stats rapides -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-6">
    <!-- Total clients -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.index.total_clients') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_clients) %></p>
        </div>
        <div class="h-12 w-12 bg-blue-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Clients actifs (30 jours) -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.index.active_clients') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@active_clients) %></p>
        </div>
        <div class="h-12 w-12 bg-green-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Total commandes -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.index.total_orders') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_orders) %></p>
        </div>
        <div class="h-12 w-12 bg-yellow-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Revenus total -->
    <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-4 md:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.index.total_revenue') %></p>
          <p class="text-2xl md:text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_revenue, delimiter: ' ') %> FCFA</p>
        </div>
        <div class="h-12 w-12 bg-purple-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste des clients -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-4 md:px-6 py-4 border-b border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <h2 class="text-lg font-semibold text-gray-900"><%= t('vendors.clients.index.client') %></h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.clients.index.client') %></th>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.clients.index.orders_count') %></th>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.clients.index.total_spent') %></th>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('vendors.clients.index.last_order') %></th>
            <th class="px-4 md:px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('common.edit') %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @clients.any? %>
            <% @clients.each do |client| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 md:px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="h-10 w-10 bg-[#551694] rounded-full flex items-center justify-center text-white font-semibold flex-shrink-0">
                      <%= client.first_name&.first&.upcase || client.last_name&.first&.upcase || 'C' %>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= client.first_name %> <%= client.last_name %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= client.orders_count %>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= number_with_delimiter(client.total_spent, delimiter: ' ') %> FCFA
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= client.last_order_date ? time_ago_in_words(client.last_order_date) : 'Jamais' %>
                </td>
                <td class="px-4 md:px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to t('vendors.clients.index.view'), client_path_for.call(client), class: "text-[#551694] hover:text-[#451384] transition-colors" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-4 md:px-6 py-8 text-center text-gray-500">
                <%= t('vendors.clients.index.no_clients') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<% else %>
  <!-- État d'erreur si pas de vendeur -->
  <div class="text-center py-12">
    <p class="text-gray-500 mb-4"><%= t('vendors.dashboard.error_vendor_not_found') %></p>
  </div>
<% end %>
