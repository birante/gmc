<% content_for :title, "Reset your password" %>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-8">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Set a new password</h1>
    <p class="text-sm text-slate-500 mb-6">Almost done — pick a new password.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
      </div>
      <div>
        <%= f.submit "Change my password", class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
