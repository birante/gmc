<% content_for :active_tab, 'compte' %>

<div class="flex flex-col min-h-screen bg-gray-50">
  <main class="flex-1 px-4 sm:px-6 lg:px-12 xl:px-28 py-6">
    <!-- Breadcrumb -->
    <div class="mb-4">
      <nav class="text-sm text-gray-500 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
        <%= link_to "Dashboard", vendors_dashboard_path, class: "hover:text-[#551694] transition-colors duration-150" %>
        <span class="text-gray-400">/</span>
        <span class="text-gray-900 font-medium">Mon compte</span>
      </nav>
    </div>

    <!-- Titre de la page -->
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Mon compte</h1>
      <p class="text-sm sm:text-base text-gray-600">Gérez vos informations personnelles et les identifiants de connexion</p>
    </div>

    <!-- Carte principale -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-4 py-6 sm:px-6 sm:py-8">
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-6">Informations personnelles</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Prénom</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @vendor.first_name %>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @vendor.last_name %>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @vendor.email.presence || "Non renseigné" %>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Téléphone</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= "+#{@vendor.country_code} #{@vendor.phone_number}" %>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Statut du compte</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900 capitalize">
                <% status_color = @vendor.active? ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800" %>
                <span class="inline-block px-2 py-1 rounded-md text-xs font-medium <%= status_color %>">
                  <%= @vendor.status %>
                </span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Membre depuis</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= l(@vendor.created_at.to_date, format: :long) if @vendor.created_at %>
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <%= link_to edit_vendors_account_path, class: "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 font-medium shadow-sm" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Modifier mes informations</span>
          <% end %>
        </div>
      </div>
    </div>
  </main>

  <%= render "vendors/shared/footer" %>
</div>
