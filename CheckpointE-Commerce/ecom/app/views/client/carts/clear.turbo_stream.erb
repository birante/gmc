<%= turbo_stream.replace "cart-content" do %>
  <div class="bg-white rounded-lg shadow-md border border-gray-200 p-8 sm:p-12 text-center">
    <svg class="w-20 h-20 sm:w-24 sm:h-24 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <h2 class="text-xl sm:text-2xl font-semibold text-gray-600 mb-2">Votre panier est vide</h2>
    <p class="text-gray-500 mb-6 text-sm sm:text-base">Commencez vos achats dès maintenant!</p>
    <%= link_to client_items_path, class: "inline-block px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] transition-colors text-sm sm:text-base font-medium" do %>
      Voir le catalogue
    <% end %>
  </div>
<% end %>

<%= turbo_stream.remove "cart-summary" %>

<%= turbo_stream.replace "cart-navbar-section" do %>
  <div id="cart-navbar-section">
    <%= render 'shared/cart_navbar_section' %>
  </div>
<% end %>

