# Secrets lus hors du dépôt (communs aux 5 apps okemamy.com) :
#   ~/.config/okemamy/registry_token  -> token Docker Hub (birantesy)
#   ~/.config/okemamy/jwt_secret      -> secret JWT partagé
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/okemamy/registry_token 2>/dev/null || true)
JWT_SECRET=$(cat ~/.config/okemamy/jwt_secret)
ADMIN_PASSWORD=$(cat ~/.config/okemamy/boutik_admin_password)
