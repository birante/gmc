<% content_for :client_content do %>
  <div>
    <!-- Breadcrumb -->
    <div class="mb-4">
      <nav class="text-sm text-gray-500 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
        <%= link_to "Accueil", root_path, class: "hover:text-[#551694] transition-colors duration-150" %> 
        <span class="text-gray-400">/</span>
        <span class="text-gray-900 font-medium">Mon compte</span>
      </nav>
    </div>

    <!-- Titre de la page -->
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Mon compte</h1>
      <p class="text-sm sm:text-base text-gray-600">Gérez vos informations personnelles et vos paramètres de compte</p>
    </div>

    <!-- Carte principale -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-4 py-6 sm:px-6 sm:py-8">
        <!-- Informations personnelles -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-6">Informations personnelles</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Prénom -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Prénom</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @user.first_name %>
              </div>
            </div>

            <!-- Nom -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @user.last_name %>
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= @user.email_address.presence || "Non renseigné" %>
              </div>
            </div>

            <!-- Téléphone -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Téléphone</label>
              <div class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-900">
                <%= "+#{@user.country_code} #{@user.phone_number}" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Bouton Modifier -->
        <div class="flex justify-end">
          <%= link_to edit_client_account_path, class: "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 font-medium shadow-sm" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Modifier mes informations</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render "shared/client_sidebar_wrapper" do %>
  <%= content_for(:client_content) %>
<% end %>








