<div class="container mx-auto px-4 py-8">
  <%= link_to t('client.items.show.back_to_catalog'), client_items_path, class: "text-indigo-600 hover:text-indigo-700 mb-6 inline-block" %>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="grid md:grid-cols-2 gap-4 md:gap-8 p-4 md:p-6">
      <!-- Image section -->
      <div class="bg-gray-100 rounded-lg h-64 sm:h-80 md:h-96 flex items-center justify-center overflow-hidden">
        <% if @item.has_image? %>
          <%= storage_image_tag(@item.display_image, variant_name: :large, alt: @item.name, class: "w-full h-full object-contain", width: 800, height: 800) %>
        <% else %>
          <span class="text-gray-400 text-2xl"><%= t('client.items.show.product_image') %></span>
        <% end %>
      </div>

      <!-- Product info -->
      <div class="flex flex-col">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-3 md:mb-4"><%= @item.name %></h1>
        
        <% if @item.product_sub_category %>
          <div class="mb-4">
            <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">
              <%= @item.product_sub_category.name %>
            </span>
          </div>
        <% end %>

        <p class="text-gray-600 mb-6"><%= @item.description %></p>

        <!-- Sélecteur de variantes -->
        <% if @item.variants_count > 1 %>
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2"><%= t('client.items.show.choose_variant') %></label>
            <div class="grid grid-cols-1 gap-2" id="variantsContainer">
              <% @item.variants.each_with_index do |variant, index| %>
                <div class="variant-option border-2 rounded-lg p-3 cursor-pointer transition-all <%= index == 0 ? 'border-indigo-600 bg-indigo-50' : 'border-gray-200 hover:border-indigo-300' %> <%= variant.stock_quantity <= 0 ? 'opacity-50 cursor-not-allowed' : '' %>"
                     data-variant-id="<%= variant.id %>"
                     data-price="<%= current_price_for(variant) %>"
                     data-stock="<%= variant.stock_quantity %>"
                     onclick="<%= variant.stock_quantity > 0 ? 'selectVariant(this)' : '' %>">
                  <div class="flex justify-between items-start">
                    <div>
                      <div class="font-medium text-gray-900">
                        <%= variant.display_name.presence || t('client.items.show.default_variant') %>
                      </div>
                      <div class="text-sm text-gray-600 mt-1">
                        <%= number_to_currency(current_price_for(variant), unit: @item.currency.symbol, precision: 0) %> <%= @item.currency.code %>
                      </div>
                    </div>
                    <div class="text-sm">
                      <% if variant.stock_quantity > 0 %>
                        <span class="text-green-600"><%= t('client.items.show.in_stock', count: variant.stock_quantity) %></span>
                      <% else %>
                        <span class="text-red-600"><%= t('client.items.show.out_of_stock') %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Affichage du prix et stock de la variante sélectionnée -->
        <% @variant = @item.variants.first %>
        <% if @variant %>
          <div class="mb-6" id="selectedVariantInfo">
            <div class="flex items-baseline gap-2 mb-2">
              <% current_price = current_price_for(@variant) %>
              <% original_price = original_price_for(@variant) %>
              <% discount_percent = discount_percentage_for(@variant) %>
              <span class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#551694]" id="selectedPrice">
                <%= number_to_currency(current_price, unit: @item.currency.symbol, precision: 0) %>
              </span>
              <span class="text-gray-500"><%= @item.currency.code %></span>
              <% if discount_percent > 0 && original_price > current_price %>
                <span class="text-lg text-gray-400 line-through ml-2">
                  <%= number_to_currency(original_price, unit: @item.currency.symbol, precision: 0) %>
                </span>
              <% end %>
            </div>
            <p class="text-sm text-gray-500" id="selectedStock">
              <% if @variant.stock_quantity > 0 %>
                <span class="text-green-600"><%= t('client.items.show.in_stock_available', count: @variant.stock_quantity) %></span>
              <% else %>
                <span class="text-red-600"><%= t('client.items.show.out_of_stock_message') %></span>
              <% end %>
            </p>
          </div>
        <% else %>
          <div class="mb-6">
            <p class="text-red-600"><%= t('client.items.show.no_variant') %></p>
          </div>
        <% end %>

        <div class="border-t pt-6 mb-6">
          <h3 class="font-semibold mb-2"><%= t('client.items.show.shop') %></h3>
          <p class="text-gray-600"><%= @item.shop.name %></p>
        </div>

        <% if @variant && @variant.stock_quantity > 0 %>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"><%= t('client.items.show.quantity') %></label>
              
              <!-- Widget de quantité -->
                <div class="flex items-center gap-4 mb-4">
                  <button 
                    type="button"
                    onclick="decreaseQuantityShow()"
                    id="decreaseBtnShow"
                    class="w-12 h-12 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                    </svg>
                  </button>
                  
                  <input 
                    type="number" 
                    id="quantityInputShow" 
                    value="1" 
                    min="1" 
                    max="<%= @variant.stock_quantity %>"
                    class="w-24 text-center text-2xl font-semibold border-2 border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-600"
                    onchange="validateQuantityShow()"
                  />
                  
                  <button 
                    type="button"
                    onclick="increaseQuantityShow()"
                    id="increaseBtnShow"
                    class="w-12 h-12 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  </button>
                </div>
              </div>
              
            <%= form_with url: client_cart_items_path, method: :post, class: "w-full", data: { turbo: true } do |form| %>
              <%= form.hidden_field :item_id, value: @item.id %>
              <%= form.hidden_field :item_variant_id, value: @variant.id, id: "variantInput" %>
              <%= form.hidden_field :quantity, value: 1, id: "quantityHiddenShow" %>
              <%= form.submit t('client.items.show.add_to_cart'), class: "w-full px-6 py-3 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 font-semibold transition-colors flex items-center justify-center gap-2", id: "addToCartBtn" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  let currentVariantId = <%= @variant&.id || 'null' %>;
  let maxQuantityShow = <%= @variant ? @variant.stock_quantity : 0 %>;

  function selectVariant(element) {
    // Retirer la sélection précédente
    document.querySelectorAll('.variant-option').forEach(opt => {
      opt.classList.remove('border-indigo-600', 'bg-indigo-50');
      opt.classList.add('border-gray-200');
    });
    
    // Appliquer la nouvelle sélection
    element.classList.remove('border-gray-200');
    element.classList.add('border-indigo-600', 'bg-indigo-50');
    
    // Récupérer les données de la variante
    currentVariantId = element.dataset.variantId;
    const price = parseFloat(element.dataset.price);
    const stock = parseInt(element.dataset.stock);
    maxQuantityShow = stock;
    
    // <%= t('client.items.show.update_price') %>
    const priceElement = document.getElementById('selectedPrice');
    if (priceElement) {
      priceElement.textContent = new Intl.NumberFormat('fr-FR').format(price);
    }
    
    // <%= t('client.items.show.update_stock') %>
    const stockElement = document.getElementById('selectedStock');
    if (stockElement) {
      if (stock > 0) {
        stockElement.innerHTML = '<span class="text-green-600">✓ En stock (' + stock + ' disponibles)</span>';
      } else {
        stockElement.innerHTML = '<span class="text-red-600">✗ Rupture de stock</span>';
      }
    }
    
    // <%= t('client.items.show.update_hidden_field') %>
    const variantInput = document.getElementById('variantInput');
    if (variantInput) {
      variantInput.value = currentVariantId;
    }
    
    // Réinitialiser la quantité à 1
    const quantityInput = document.getElementById('quantityInputShow');
    if (quantityInput) {
      quantityInput.value = 1;
      quantityInput.max = stock;
      document.getElementById('quantityHiddenShow').value = 1;
    }
    
    validateQuantityShow();
  }

  function increaseQuantityShow() {
    const input = document.getElementById('quantityInputShow');
    const currentValue = parseInt(input.value) || 1;
    if (currentValue < maxQuantityShow) {
      input.value = currentValue + 1;
      document.getElementById('quantityHiddenShow').value = input.value;
      validateQuantityShow();
    }
  }

  function decreaseQuantityShow() {
    const input = document.getElementById('quantityInputShow');
    const currentValue = parseInt(input.value) || 1;
    if (currentValue > 1) {
      input.value = currentValue - 1;
      document.getElementById('quantityHiddenShow').value = input.value;
      validateQuantityShow();
    }
  }

  function validateQuantityShow() {
    const input = document.getElementById('quantityInputShow');
    let value = parseInt(input.value) || 1;
    
    if (value < 1) value = 1;
    if (value > maxQuantityShow) value = maxQuantityShow;
    
    input.value = value;
    document.getElementById('quantityHiddenShow').value = value;
    
    // Désactiver/activer les boutons
    document.getElementById('decreaseBtnShow').disabled = value <= 1;
    document.getElementById('increaseBtnShow').disabled = value >= maxQuantityShow;
  }

  // Initialiser l'état des boutons au chargement
  document.addEventListener('DOMContentLoaded', function() {
    validateQuantityShow();
  });
</script>
