<%= form_with(model: [:vendors, employee], class: "space-y-6") do |form| %>
  <% if employee.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-semibold text-red-800">
            <%= pluralize(employee.errors.count, t('common.errors.one'), t('common.errors.other')) %> empêche(nt) l'enregistrement :
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% employee.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Informations personnelles -->
  <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6 sm:p-8">
    <div class="mb-6 pb-4 border-b border-gray-200">
      <h3 class="text-xl font-semibold text-gray-900"><%= t('.personal_info') %></h3>
      <p class="text-sm text-gray-500 mt-1"><%= t('.personal_info_desc') %></p>
    </div>
    
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <%# Prénom %>
      <div>
        <%= form.label :first_name, t('.first_name'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <%= form.text_field :first_name,
              required: true,
              autocomplete: "given-name",
              class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm pl-10 pr-4 py-2.5 transition-colors",
              placeholder: t('.first_name_placeholder') %>
        </div>
      </div>

      <%# Nom %>
      <div>
        <%= form.label :last_name, t('.last_name'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <%= form.text_field :last_name,
              required: true,
              autocomplete: "family-name",
              class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm pl-10 pr-4 py-2.5 transition-colors",
              placeholder: t('.last_name_placeholder') %>
        </div>
      </div>

      <%# Email %>
      <div>
        <%= form.label :email, t('.email'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <%= form.email_field :email,
              required: true,
              autocomplete: "email",
              class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm pl-10 pr-4 py-2.5 transition-colors",
              placeholder: t('.email_placeholder') %>
        </div>
      </div>

      <%# Téléphone (indicatif + numéro dans un seul bloc visuel) %>
      <div>
        <%= form.label :phone_number, t('.phone'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="flex rounded-lg shadow-sm border border-gray-300 focus-within:border-[#551694] focus-within:ring-2 focus-within:ring-[#551694] transition-colors overflow-hidden">
          <span class="inline-flex items-center pl-3 pr-2 text-gray-500 sm:text-sm select-none">+</span>
          <%= form.text_field :country_code,
              value: employee.country_code || "221",
              inputmode: "numeric",
              maxlength: 4,
              class: "w-16 border-0 focus:ring-0 sm:text-sm py-2.5 px-1 text-gray-900",
              placeholder: t('.country_code_placeholder') %>
          <span class="inline-flex items-center px-2 text-gray-300 select-none">|</span>
          <%= form.text_field :phone_number,
              required: true,
              inputmode: "tel",
              autocomplete: "tel-national",
              class: "flex-1 border-0 focus:ring-0 sm:text-sm py-2.5 pl-2 pr-4 text-gray-900",
              placeholder: t('.phone_number_placeholder') %>
        </div>
        <p class="mt-1.5 text-xs text-gray-500"><%= t('.phone_format') %></p>
      </div>
    </div>
  </div>

  <!-- Rôle et affectation -->
  <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6 sm:p-8">
    <div class="mb-6 pb-4 border-b border-gray-200">
      <h3 class="text-xl font-semibold text-gray-900"><%= t('.role_and_assignment') %></h3>
      <p class="text-sm text-gray-500 mt-1"><%= t('.role_and_assignment_desc') %></p>
    </div>
    
    <div class="grid grid-cols-1 gap-6">
      <div>
        <%= form.label :role, t('.role'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <% if employee.new_record? %>
          <%# Phase 1 : seul le rôle « Gestionnaire » est proposé à la création.
              Les autres rôles (caissier, gestionnaire de stock, livreur) arriveront prochainement. %>
          <%= form.hidden_field :role, value: "manager" %>
          <div class="flex items-start gap-3 rounded-lg border-2 border-[#551694] bg-purple-50/50 p-4">
            <div class="flex-shrink-0 h-10 w-10 rounded-lg bg-[#551694] flex items-center justify-center text-white">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <p class="font-semibold text-gray-900"><%= t('.manager') %></p>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-[#551694] text-white">Sélectionné</span>
              </div>
              <p class="mt-1 text-sm text-gray-600"><%= t('.manager_desc') %></p>
            </div>
          </div>
          <p class="mt-2 text-xs text-gray-500 italic">
            Les autres rôles (caissier, gestionnaire de stock, livreur) seront disponibles prochainement.
          </p>
        <% else %>
          <%= form.select :role,
              options_for_select([
                [ t('.select_role'), '' ],
                [ t('.manager'), 'manager' ],
                [ t('.cashier'), 'cashier' ],
                [ t('.stock_manager'), 'stock_manager' ],
                [ t('.delivery'), 'delivery' ]
              ], employee.role),
              { prompt: false },
              { required: true,
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm px-4 py-2.5 transition-colors" } %>
          <p class="mt-2 text-sm text-gray-500"><%= t('.role_desc') %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :shop_ids, t('.assigned_shops'), class: "block text-sm font-semibold text-gray-700 mb-3" %>
        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
          <div class="space-y-3 max-h-64 overflow-y-auto">
            <% if @shops.any? %>
              <% @shops.each_with_index do |shop, index| %>
                <label for="employee_shop_ids_<%= shop.id %>" class="flex items-start p-3 rounded-lg border border-gray-200 hover:border-[#551694] hover:bg-purple-50 transition-colors cursor-pointer">
                  <div class="flex items-center h-5 mt-0.5">
                    <%= check_box_tag "employee[shop_ids][]", shop.id, 
                        employee.shop_ids.include?(shop.id),
                        id: "employee_shop_ids_#{shop.id}",
                        class: "h-4 w-4 text-[#551694] border-gray-300 rounded focus:ring-[#551694] focus:ring-2" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <div class="flex items-center flex-wrap gap-2">
                      <span class="font-medium text-gray-900"><%= shop.name %></span>
                      <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= 
                        case shop.status
                        when 'active' then 'bg-green-100 text-green-700'
                        when 'pending' then 'bg-yellow-100 text-yellow-700'
                        when 'suspended' then 'bg-red-100 text-red-700'
                        else 'bg-gray-100 text-gray-700'
                        end %>">
                        <%= shop.status&.capitalize || 'Non défini' %>
                      </span>
                      <% if employee.persisted? %>
                        <% employee_shop = employee.employee_shops.find { |es| es.shop_id == shop.id } %>
                        <% if employee_shop&.is_primary %>
                          <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-purple-100 text-purple-700">
                            <%= t('.primary_shop') %>
                          </span>
                        <% end %>
                      <% elsif index == 0 && employee.new_record? %>
                        <span class="px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-700">
                          <%= t('.default_primary') %>
                        </span>
                      <% end %>
                    </div>
                    <p class="text-xs text-gray-500 mt-1"><%= shop.address %></p>
                  </div>
                </label>
              <% end %>
            <% else %>
              <div class="text-center py-6">
                <p class="text-sm text-gray-500 mb-2"><%= t('.no_shops') %></p>
                <p class="text-xs text-gray-400"><%= t('.no_shops_message') %></p>
              </div>
            <% end %>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          <span class="font-medium"><%= t('.note') %></span> <%= t('.shop_note') %>
        </p>
      </div>

      <%# Statut : lecture seule (l'admin utilise l'action « activer/désactiver » depuis la liste).
          Sur création, le statut est « actif » par défaut (enum Employee#status). %>
      <div>
        <span class="block text-sm font-semibold text-gray-700 mb-2"><%= t('.account_status') %></span>
        <% current_status = employee.new_record? ? "active" : employee.status %>
        <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-gray-200 bg-gray-50">
          <span class="h-2 w-2 rounded-full <%= current_status == 'active' ? 'bg-green-500' : 'bg-gray-400' %>"></span>
          <span class="text-sm font-medium text-gray-900">
            <%= current_status == 'active' ? t('.active') : t('.inactive') %>
          </span>
          <% if employee.new_record? %>
            <span class="ml-1 text-xs text-gray-500">(par défaut)</span>
          <% end %>
        </div>
        <p class="mt-2 text-sm text-gray-500">
          <%= t('.account_status_desc') %>
        </p>
      </div>
    </div>

    <!-- Description des rôles (édition : tous les rôles existants) -->
    <% unless employee.new_record? %>
      <div class="mt-6 bg-gradient-to-br from-purple-50 to-blue-50 rounded-lg p-5 border border-purple-100">
        <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
          <svg class="w-4 h-4 mr-2 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <%= t('.role_descriptions') %>
        </h4>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div class="bg-white rounded-lg p-3 border border-purple-100">
            <dt class="font-semibold text-purple-700 mb-1"><%= t('.manager') %></dt>
            <dd class="text-gray-600 text-xs"><%= t('.manager_desc') %></dd>
          </div>
          <div class="bg-white rounded-lg p-3 border border-blue-100">
            <dt class="font-semibold text-blue-700 mb-1"><%= t('.cashier') %></dt>
            <dd class="text-gray-600 text-xs"><%= t('.cashier_desc') %></dd>
          </div>
          <div class="bg-white rounded-lg p-3 border border-green-100">
            <dt class="font-semibold text-green-700 mb-1"><%= t('.stock_manager') %></dt>
            <dd class="text-gray-600 text-xs"><%= t('.stock_manager_desc') %></dd>
          </div>
          <div class="bg-white rounded-lg p-3 border border-yellow-100">
            <dt class="font-semibold text-yellow-700 mb-1"><%= t('.delivery') %></dt>
            <dd class="text-gray-600 text-xs"><%= t('.delivery_desc') %></dd>
          </div>
        </dl>
      </div>
    <% end %>
  </div>

  <!-- Mot de passe -->
  <% if employee.new_record? || params[:action] == 'edit' %>
    <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6 sm:p-8">
      <div class="mb-6 pb-4 border-b border-gray-200">
        <h3 class="text-xl font-semibold text-gray-900">
          <%= employee.new_record? ? t('.password') : t('.change_password') %>
        </h3>
        <p class="text-sm text-gray-500 mt-1">
          <%= employee.new_record? ? t('.password_desc') : t('.password_desc_edit') %>
        </p>
      </div>
      
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <%# Mot de passe %>
        <div>
          <%= form.label :password, t('.password'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <%= form.password_field :password,
                required: employee.new_record?,
                autocomplete: "new-password",
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm pl-10 pr-4 py-2.5 transition-colors",
                placeholder: t('.password_placeholder') %>
          </div>
          <% unless employee.new_record? %>
            <p class="mt-1.5 text-xs text-gray-500"><%= t('.password_optional') %></p>
          <% else %>
            <p class="mt-1.5 text-xs text-gray-500"><%= t('.password_required') %></p>
          <% end %>
        </div>

        <%# Confirmation mot de passe %>
        <div>
          <%= form.label :password_confirmation, t('.password_confirmation'), class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <%= form.password_field :password_confirmation,
                required: employee.new_record?,
                autocomplete: "new-password",
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-2 focus:ring-[#551694] sm:text-sm pl-10 pr-4 py-2.5 transition-colors",
                placeholder: t('.password_confirmation_placeholder') %>
          </div>
          <p class="mt-1.5 text-xs text-gray-500"><%= t('.password_match') %></p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Actions -->
  <div class="flex items-center justify-end gap-4 pt-6 border-t border-gray-200">
    <%= link_to vendors_employees_path, 
        class: "px-6 py-3 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
      <%= t('.cancel') %>
    <% end %>
    <%= form.submit employee.new_record? ? t('.create') : t('.update'),
        class: "px-6 py-3 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-[#551694] hover:bg-[#6a1fa8] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#551694] transition-colors" %>
  </div>
<% end %>
