<% content_for :title, "Edit account" %>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-8">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Edit account</h1>
    <p class="text-sm text-slate-500 mb-6">Update your name, email or password.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :first_name, class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :last_name, class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
        </div>
      </div>

      <div>
        <%= f.label :bio, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :bio, rows: 3, class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="text-xs text-amber-700 mt-1">Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong></p>
        <% end %>
      </div>

      <div class="pt-3 mt-3 border-t border-gray-100 space-y-3">
        <p class="text-xs text-slate-500">Change password (leave blank to keep current)</p>
        <div>
          <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
        </div>
        <div>
          <%= f.label :current_password, "Current password", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.password_field :current_password, autocomplete: "current-password",
                class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
          <p class="text-xs text-slate-500 mt-1">We need your current password to confirm the change.</p>
        </div>
      </div>

      <div class="flex gap-2 justify-end">
        <%= link_to "Back", :back, class: "px-3 py-1.5 text-sm text-slate-600 hover:text-slate-900" %>
        <%= f.submit "Save changes", class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>

  <div class="mx-auto max-w-md mt-6">
    <div class="rounded-2xl bg-red-50 border border-red-200 p-6 text-red-800">
      <h2 class="font-semibold">Delete account</h2>
      <p class="text-sm mt-1 mb-3">This will permanently delete your account and all your posts. This cannot be undone.</p>
      <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete,
            class: "px-4 py-2 rounded-md bg-red-600 text-white text-sm hover:bg-red-500" %>
    </div>
  </div>
</div>
