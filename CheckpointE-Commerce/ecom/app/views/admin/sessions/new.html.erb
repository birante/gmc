<div class="p-6 sm:p-8 space-y-4 md:space-y-6 w-full sm:max-w-md bg-white sm:rounded-md shadow dark:border dark:bg-gray-800/50 dark:border-gray-800">
  <h2 class="text-xl font-bold text-gray-900 md:text-2xl dark:text-white">
    <%= t("active_admin.devise.login.title", default: "Connexion") %> — aa Admin
  </h2>
  <%= form_with url: main_app.new_admin_user_session_path, method: :post, local: true, data: { turbo: false } do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :email, t("active_admin.devise.email.title", default: "Email"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.email_field :email, value: @admin_user&.email, autofocus: true, autocomplete: "email", class: "w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2" %>
      </div>
      <div>
        <%= f.label :password, t("active_admin.devise.password.title", default: "Mot de passe"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <div class="relative">
          <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 pr-10", id: "admin_login_password" %>
          <button type="button" id="admin_login_toggle_password" class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1" aria-label="Afficher le mot de passe" title="Afficher le mot de passe">
            <svg class="w-5 h-5 icon-eye-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <svg class="w-5 h-5 icon-eye-closed hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
          </button>
        </div>
      </div>
      <div>
        <%= f.submit t("active_admin.devise.login.submit", default: "Se connecter"), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
<script>
  (function() {
    var btn = document.getElementById('admin_login_toggle_password');
    var input = document.getElementById('admin_login_password');
    var openIcon = btn && btn.querySelector('.icon-eye-open');
    var closedIcon = btn && btn.querySelector('.icon-eye-closed');
    if (!btn || !input) return;
    btn.addEventListener('click', function() {
      var isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      if (openIcon) openIcon.classList.toggle('hidden', !isPassword);
      if (closedIcon) closedIcon.classList.toggle('hidden', isPassword);
      btn.setAttribute('aria-label', isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
      btn.setAttribute('title', isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
    });
  })();
</script>
