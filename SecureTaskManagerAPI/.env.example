# Copy to .env and adjust. All values have sensible defaults for dev.

PORT=3000
NODE_ENV=development

# Signing key for JWTs. In production, this MUST be a long random string.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cookie session secret (used by express-session for the OAuth flow).
SESSION_SECRET=another-long-random-string

# Google OAuth — leave empty to disable the Google login route.
# Create a project at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
