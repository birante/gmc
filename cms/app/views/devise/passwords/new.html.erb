<% content_for :title, "Forgot your password?" %>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-8">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Forgot your password?</h1>
    <p class="text-sm text-slate-500 mb-6">Enter your email and we'll send you a reset link.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm" %>
      </div>
      <div>
        <%= f.submit "Send reset instructions", class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
