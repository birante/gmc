<%# Section des avis clients pour un produit %>
<% item = local_assigns[:item] || @item %>
<% current_user_param = local_assigns[:current_user] %>

<% if item.present? %>
  <section class="w-full" aria-labelledby="reviews-heading">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 md:p-8 w-full">
      <!-- En-tête avec note moyenne -->
      <div class="flex items-center justify-between mb-6 pb-6 border-b border-gray-200">
        <div>
          <h2 id="reviews-heading" class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
            Avis clients
          </h2>
          <% if item.average_rating.present? %>
            <div class="flex items-center gap-3">
              <div class="flex items-center">
                <% item.average_rating.round.times do %>
                  <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                  </svg>
                <% end %>
                <% (5 - item.average_rating.round).times do %>
                  <svg class="w-6 h-6 text-gray-300 fill-current" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                  </svg>
                <% end %>
              </div>
              <div>
                <span class="text-2xl font-bold text-gray-900"><%= item.average_rating.round(1) %></span>
                <span class="text-gray-500 text-sm">/ 5</span>
                <span class="text-gray-600 text-sm ml-2">(<%= pluralize(item.reviews.approved.size, 'avis') %>)</span>
              </div>
            </div>
          <% else %>
            <p class="text-gray-600">Aucun avis pour le moment</p>
          <% end %>
        </div>
        
        <%# Répartition des notes %>
        <% if item.reviews.approved.any? %>
          <div class="hidden md:block">
            <% (5.downto(1)).each do |rating| %>
              <% count = item.reviews.approved.by_rating(rating).count %>
              <% percentage = item.reviews.approved.size > 0 ? (count.to_f / item.reviews.approved.size * 100).round : 0 %>
              <div class="flex items-center gap-2 mb-1 text-sm">
                <span class="text-gray-600 w-8"><%= rating %>★</span>
                <div class="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full bg-yellow-400" style="width: <%= percentage %>%"></div>
                </div>
                <span class="text-gray-500 w-8 text-right"><%= count %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Formulaire de création d'avis (si l'utilisateur est connecté et a acheté le produit) -->
      <% if defined?(current_user) && current_user && current_user.orders.joins(:order_items).where(order_items: { item_id: item.id, delivery_status: "delivered" }).exists? && !current_user.reviews.where(item: item).exists? %>
        <div class="mb-8 p-6 bg-gradient-to-br from-purple-50 via-white to-blue-50 rounded-xl border-2 border-purple-200 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-shrink-0 w-10 h-10 bg-[#551694] rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900">Laisser un avis</h3>
              <p class="text-sm text-gray-600 mt-1">Partagez votre expérience avec ce produit</p>
            </div>
          </div>
          <%= render "shared/reviews/review_form", item: item, user: current_user %>
        </div>
      <% end %>

      <!-- Liste des avis -->
      <% approved_reviews = item.reviews.approved.order(created_at: :desc).limit(10) %>
      <% if approved_reviews.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
          <% approved_reviews.each do |review| %>
            <%= render "shared/reviews/review_card", review: review %>
          <% end %>
        </div>

        <% if item.reviews.approved.size > 10 %>
          <div class="mt-6 text-center">
            <%= link_to "Voir tous les avis (#{item.reviews.approved.size})", client_reviews_path(item_id: item.id), class: "text-[#551694] hover:text-[#451384] font-medium underline" %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
          <p class="text-lg">Aucun avis approuvé pour le moment</p>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
