<%# Section Infos de livraison %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 sm:p-6 mb-6 hover:shadow-md transition-shadow duration-200">
  <div class="flex items-center gap-2 mb-4 sm:mb-6">
    <svg class="w-5 h-5 text-[#551694]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <h2 class="text-lg sm:text-xl font-semibold text-gray-900">Infos de livraison</h2>
  </div>
  
  <div class="space-y-6">

    <!-- Vendeur et Produit - Grille 2 colonnes -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      <% order.order_items.each do |order_item| %>
        <div class="pb-6 border-b border-gray-200 last:border-b-0 last:pb-0">
          <!-- Informations vendeur -->
          <div class="flex items-start gap-3 mb-4">
            <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0 overflow-hidden">
              <% if order_item.shop.logo.attached? %>
                <%= storage_image_tag(order_item.shop.logo, variant_name: :logo_small, alt: order_item.shop.name, class: "w-full h-full object-cover", width: 48, height: 48) %>
              <% else %>
                <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              <% end %>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-gray-900 mb-1 text-sm"><%= order_item.shop.name.upcase %></h3>
              <!-- Note boutique -->
              <% if order_item.shop.average_rating.present? %>
                <% shop_rounded_rating = order_item.shop.average_rating.round %>
                <div class="flex items-center gap-0.5 mb-1" role="img" aria-label="<%= t('storefront.products.rating', rating: shop_rounded_rating) %>">
                  <% 5.times do |i| %>
                    <svg class="w-3 h-3 <%= i < shop_rounded_rating ? 'text-yellow-400 fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% end %>
                </div>
              <% end %>
              <p class="text-xs text-gray-500">
                <%= order_item.item.product_sub_category&.name || 'Catégorie' %>
              </p>
            </div>
          </div>

          <!-- Détails produit -->
          <div class="flex gap-4">
            <%= link_to client_item_path(order_item.item), class: "w-20 h-20 sm:w-24 sm:h-24 bg-gray-100 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden group/image transition-transform duration-200 hover:scale-105" do %>
              <% if order_item.item.has_image? %>
                <%= storage_image_tag(order_item.item.display_image, variant_name: :thumbnail, alt: order_item.item.name, class: "w-full h-full object-cover rounded-lg group-hover/image:scale-110 transition-transform duration-200", width: 96, height: 96) %>
              <% else %>
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              <% end %>
            <% end %>
            <div class="flex-1 min-w-0">
              <%= link_to client_item_path(order_item.item), class: "block group" do %>
                <h4 class="font-semibold text-gray-900 mb-2 group-hover:text-[#551694] transition-colors duration-150"><%= order_item.item.name %></h4>
              <% end %>
              <% if order_item.item_variant %>
                <% attrs = order_item.item_variant.attribute_display_hash %>
                <% if attrs.any? %>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <% attrs.each do |name, value| %>
                      <span class="px-2.5 py-1 text-xs bg-gray-200 text-gray-700 rounded-full">
                        <%= value %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
              <div class="flex items-center gap-4 mb-3">
                <span class="text-sm text-gray-600">
                  <span class="font-medium">Qté:</span> 
                  <span class="font-semibold text-gray-900"><%= order_item.quantity %></span>
                </span>
                <span class="text-base font-bold text-gray-900">
                  <%= number_to_currency(order_item.unit_price, unit: "FCFA", precision: 0, separator: " ", delimiter: " ") %>
                </span>
              </div>
              
              <!-- Statut de livraison de l'article -->
              <div class="mt-2">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                  <%= case order_item.delivery_status
                  when 'pending_shipment' then 'bg-gray-100 text-gray-700'
                  when 'shipped' then 'bg-blue-100 text-blue-800'
                  when 'partial_delivery' then 'bg-yellow-100 text-yellow-800'
                  when 'delivered' then 'bg-green-100 text-green-800'
                  when 'failed' then 'bg-red-100 text-red-800'
                  when 'returned' then 'bg-orange-100 text-orange-800'
                  else 'bg-gray-100 text-gray-700'
                  end %>">
                  <%= case order_item.delivery_status
                  when 'pending_shipment' then 'En attente d\'expédition'
                  when 'shipped' then 'Expédié'
                  when 'partial_delivery' then 'Livraison partielle'
                  when 'delivered' then 'Livré'
                  when 'failed' then 'Échec de livraison'
                  when 'returned' then 'Retourné'
                  else order_item.delivery_status&.humanize || 'Non défini'
                  end %>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

