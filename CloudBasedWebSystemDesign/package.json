{
  "name": "vaxtrack",
  "version": "1.0.0",
  "private": true,
  "description": "VaxTrack - cloud-based vaccination scheduling, reminder and coverage-monitoring platform for primary health clinics in West Africa.",
  "license": "MIT",
  "author": "Birante SY",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "start:prod": "npm run start:prod -w apps/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit -w apps/api && npm run test -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
