<%# Secondary Banners - Bannières promo secondaires en grille avec accessibilité %>
<%
  banners = defined?(@secondary_banners) ? @secondary_banners : []
  banners = banners.to_a if banners.respond_to?(:to_a)
  banners = banners.first(5)
%>

<% return if banners.empty? %>

<section class="container mx-auto px-4 lg:px-[50px] py-4 md:py-6" aria-labelledby="secondary-banners-heading">
  <h2 id="secondary-banners-heading" class="sr-only"><%= t('storefront.secondary_banners.title', default: 'Catégories en vedette') %></h2>

  <% mobile_banners = banners.first(4) %>

  <!-- Mobile: 2 columns simple grid -->
  <div class="grid grid-cols-2 gap-2 md:hidden" role="list">
    <% mobile_banners.each do |banner| %>
      <% desktop_image = banner.image.attached? ? banner.image : (banner.image_mobile.attached? ? banner.image_mobile : nil) %>
      <% mobile_image = banner.image_mobile.attached? ? banner.image_mobile : desktop_image %>
      <article class="relative h-[120px] rounded-lg overflow-hidden" role="listitem">
        <% if mobile_image.present? %>
          <%= image_tag webp_variant(mobile_image, max_width: 480, max_height: 200),
              alt: "",
              role: "presentation",
              class: "absolute inset-0 w-full h-full object-cover",
              loading: "lazy",
              decoding: "async",
              width: 300,
              height: 120 %>
        <% else %>
          <div class="absolute inset-0 bg-[#f9f9f9]" aria-hidden="true"></div>
        <% end %>
        <%= link_to banner.link,
            class: "absolute inset-0 p-4 flex items-end focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#551694]",
            "aria-label": banner.title do %>
          <span class="<%= banner.image.attached? ? 'text-white' : 'text-gray-600' %> font-semibold text-sm"><%= banner.title %></span>
        <% end %>
      </article>
    <% end %>
  </div>

  <% left_large, center_large, right_top, left_bottom, right_bottom = banners %>

  <!-- Desktop: Complex grid layout -->
  <div class="hidden md:grid grid-cols-3 gap-4" role="list">
    <% [
      [left_large,   "h-[244px]", ""],
      [center_large, "h-[515px]", "row-span-2"],
      [right_top,    "h-[244px]", ""],
      [left_bottom,  "h-[244px]", ""],
      [right_bottom, "h-[244px]", ""]
    ].each do |banner, height_class, row_span_class| %>
      <% next unless banner.present? %>
      <% desktop_image = banner.image.attached? ? banner.image : (banner.image_mobile.attached? ? banner.image_mobile : nil) %>
      <article class="relative <%= height_class %> <%= row_span_class %> rounded-lg overflow-hidden group" role="listitem">
        <% if desktop_image.present? %>
          <%= image_tag webp_variant(desktop_image, max_width: 800, max_height: 700),
            alt: "",
            role: "presentation",
            class: "absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105",
            loading: "lazy",
            decoding: "async",
            width: 600,
            height: 515 %>
        <% else %>
          <div class="absolute inset-0 bg-[#f9f9f9]" aria-hidden="true"></div>
        <% end %>
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" aria-hidden="true"></div>
        <%= link_to banner.link,
            class: "absolute inset-0 z-10 p-6 flex flex-col justify-between focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#551694]",
            "aria-label": banner.title do %>
          <span class="inline-flex items-center gap-2 <%= desktop_image.present? ? 'text-white' : 'text-gray-700' %> font-semibold text-lg">
            <%= banner.title %>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
