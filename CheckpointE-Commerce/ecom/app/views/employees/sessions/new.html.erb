<%= render "shared/auth/auth_header", title: t('employees.sessions.new.title'), subtitle: t('employees.sessions.new.subtitle') %>

<div class="w-full max-w-md mx-auto">
  <%= form_with url: employees_session_path, method: :post, local: true, data: { turbo: false } do |form| %>
    <%= render "shared/auth/auth_alert", type: :alert, message: flash[:alert] %>
    <%= render "shared/auth/auth_alert", type: :notice, message: flash[:notice] %>

    <div class="space-y-5">
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2"><%= t('employees.sessions.new.email') %></label>
        <input id="email" name="email" type="email" autocomplete="email" required
          class="block w-full rounded-md border border-[#E9E9E9] bg-[#F9F9F9] px-3 py-3 text-base focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/20 focus:outline-none transition-colors" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-2"><%= t('employees.sessions.new.password') %></label>
        <input id="password" name="password" type="password" autocomplete="current-password" required
          class="block w-full rounded-md border border-[#E9E9E9] bg-[#F9F9F9] px-3 py-3 text-base focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/20 focus:outline-none transition-colors" />
      </div>
    </div>

    <div class="mt-6">
      <%= form.submit t('employees.sessions.new.submit'), class: "btn w-full rounded-lg bg-[#551694] px-4 py-3 text-base font-medium text-white hover:bg-[#451384] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#551694] focus-visible:ring-offset-2 transition-colors cursor-pointer" %>
    </div>

    <div class="pt-5 mt-5 border-t border-gray-200 text-center space-y-3">
      <p class="text-sm text-gray-600">
        <%= t('employees.sessions.new.client_space') %>
        <%= link_to t('employees.sessions.new.access_client_space'), new_client_session_path, class: "text-[#551694] hover:text-[#451384] font-medium focus:outline-none focus-visible:underline" %>
      </p>
      <p class="text-sm text-gray-600">
        <%= t('employees.sessions.new.vendor_space') %>
        <%= link_to t('employees.sessions.new.access_vendor_space'), new_vendors_session_path, class: "text-[#551694] hover:text-[#451384] font-medium focus:outline-none focus-visible:underline" %>
      </p>
      <p class="text-xs text-gray-500 pt-1"><%= t('employees.sessions.new.help') %></p>
    </div>
  <% end %>
</div>
