<div class="border-b border-gray-200 dark:border-gray-700 dark:bg-gray-950/95 px-4 lg:px-6 py-3 flex items-center fixed top-0 z-30 h-16 w-full backdrop-blur-sm bg-white/95 shadow-sm max-w-full">
  <button class="xl:hidden mr-3 flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-[#6C3FD6]" data-drawer-target="main-menu" data-drawer-show="main-menu" aria-controls="main-menu" aria-label="<%= t('active_admin.toggle_main_navigation_menu') %>">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div class="flex items-center gap-3 flex-1 min-w-0">
    <% begin %>
      <%= image_tag "icon.png", alt: "aa", class: "h-8 w-8 rounded-lg" %>
      <% rescue %>
      <div class="h-8 w-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #6C3FD6 0%, #8B5CF6 100%);">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16 6v2h2l2 12H4L6 8h2V6a4 4 0 118 0zm-2 2V6a2 2 0 10-4 0v2h4zM6 10v10h12V10H6z"/></svg>
      </div>
    <% end %>
    <h1 data-test-site-title class="text-xl font-bold text-gray-900 dark:text-white truncate"><%= title %></h1>
  </div>
  <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
    <button type="button" class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Rechercher">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </button>
    <button type="button" class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors relative" aria-label="Notifications">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      <span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-[#6C3FD6]"></span>
    </button>
    <button type="button" class="dark-mode-toggle flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Thème">
      <svg class="hidden dark:block w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <svg class="dark:hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
    </button>
    <button type="button" class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Paramètres">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </button>
    <div class="relative pl-2 border-l border-gray-200 dark:border-gray-700">
      <button id="user-menu-button" class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full text-white transition-all focus:outline-none focus:ring-2 focus:ring-[#6C3FD6]" style="background-color: #6C3FD6;" data-dropdown-toggle="user-menu" aria-label="Menu utilisateur">
        <span class="text-sm font-semibold"><%= current_active_admin_user.try(:email).to_s.first.upcase.presence || "A" %></span>
      </button>
      <div id="user-menu" class="absolute right-0 top-full mt-2 w-48 rounded-lg shadow-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 py-1 z-50 hidden">
        <% if current_active_admin_user? %>
          <div class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">
            <p class="text-sm font-semibold text-gray-900 dark:text-white">Utilisateur</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= auto_link current_active_admin_user, class: "no-underline text-gray-600 dark:text-gray-300" %></p>
          </div>
          <%= button_to main_app.destroy_admin_user_session_path, method: :delete, class: "w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 border-0 bg-transparent cursor-pointer text-left", form: { class: "w-full" } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <%= I18n.t("active_admin.logout", default: "Déconnexion") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
