<%# Panneau slide-in pour l'import CSV en masse de produits. %>
<div data-controller="bulk-upload-panel">
  <%# Overlay %>
  <div data-bulk-upload-panel-target="overlay"
       class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-40 transition-opacity"
       aria-hidden="true"></div>

  <%# Sheet %>
  <div data-bulk-upload-panel-target="sheet"
       class="hidden fixed top-0 right-0 h-full w-full sm:max-w-xl bg-white shadow-2xl z-50 translate-x-full transform transition-transform duration-300 ease-out"
       role="dialog" aria-modal="true" aria-labelledby="bulk-upload-title">

    <%# Header %>
    <div class="flex items-start justify-between gap-4 px-5 sm:px-6 py-4 border-b border-gray-200 flex-shrink-0">
      <div class="min-w-0">
        <h2 id="bulk-upload-title" class="text-lg sm:text-xl font-bold text-gray-900 truncate">
          <%= t("vendors.items.bulk_upload.title") %>
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-1 leading-snug">
          <%= t("vendors.items.bulk_upload.subtitle") %>
        </p>
      </div>
      <button type="button"
              data-action="click->bulk-upload-panel#close"
              aria-label="<%= t('common.close', default: 'Fermer') %>"
              class="flex-shrink-0 w-8 h-8 rounded-full text-gray-500 hover:bg-gray-100 hover:text-gray-700 flex items-center justify-center transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%# Body %>
    <div class="flex-1 overflow-y-auto px-5 sm:px-6 py-5 space-y-6">

      <%# Étape 1 — Téléchargements %>
      <section>
        <h3 class="text-sm font-semibold text-gray-900 mb-1.5">
          <%= t("vendors.items.bulk_upload.steps.download_title") %>
        </h3>
        <p class="text-xs text-gray-500 mb-3 leading-relaxed">
          <%= t("vendors.items.bulk_upload.steps.download_help") %>
        </p>
        <div class="flex flex-wrap gap-2">
          <%= link_to url_with_shop(download_template_employees_items_path(format: :csv), @current_shop),
              class: "inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-[#551694] text-white text-sm font-medium hover:bg-[#451384] transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
            </svg>
            <%= t("vendors.items.bulk_upload.steps.download_template") %>
          <% end %>

          <%= link_to url_with_shop(download_categories_employees_items_path(format: :csv), @current_shop),
              class: "inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <%= t("vendors.items.bulk_upload.steps.download_categories") %>
          <% end %>
        </div>
      </section>

      <%# Étape 2 — Aide remplissage %>
      <section class="border-t border-gray-100 pt-5">
        <h3 class="text-sm font-semibold text-gray-900 mb-1.5">
          <%= t("vendors.items.bulk_upload.steps.fill_title") %>
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed">
          <%= t("vendors.items.bulk_upload.steps.fill_help") %>
        </p>
      </section>

      <%# Étape 3 — Upload %>
      <section class="border-t border-gray-100 pt-5">
        <h3 class="text-sm font-semibold text-gray-900 mb-1.5">
          <%= t("vendors.items.bulk_upload.steps.upload_title") %>
        </h3>
        <p class="text-xs text-gray-500 mb-3 leading-relaxed">
          <%= t("vendors.items.bulk_upload.steps.upload_help") %>
        </p>

        <%= form_with url: url_with_shop(bulk_upload_employees_items_path, @current_shop), method: :post, multipart: true, local: true, data: { turbo: false }, class: "space-y-3" do |f| %>
          <label class="flex flex-col items-center justify-center gap-2 px-4 py-6 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:border-[#551694] hover:bg-[#551694]/5 transition-colors">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <span class="text-sm text-gray-700"><%= t("vendors.items.bulk_upload.steps.upload_label") %></span>
            <span data-bulk-upload-panel-target="fileName" class="text-xs text-[#551694] font-medium"></span>
            <%= file_field_tag :file,
                accept: ".csv,text/csv",
                required: true,
                data: { bulk_upload_panel_target: "fileInput", action: "change->bulk-upload-panel#fileChanged" },
                class: "hidden" %>
          </label>

          <%= f.submit t("vendors.items.bulk_upload.steps.submit"),
              data: { bulk_upload_panel_target: "submit", disable_with: t("vendors.items.bulk_upload.steps.submit") + "…" },
              disabled: true,
              class: "w-full px-4 py-2.5 bg-[#551694] text-white rounded-lg font-semibold text-sm hover:bg-[#451384] transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>
        <% end %>
      </section>
    </div>
  </div>
</div>
