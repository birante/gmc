<%# Hero Banner enrichi avec breadcrumbs et overlay %>
<div class="bg-gradient-to-b from-gray-900 to-gray-800" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.6)); --accent: <%= primary_color %>;">
  <div class="container mx-auto px-4 lg:px-[50px] py-8">
    <%# Breadcrumbs %>
    <nav class="flex flex-wrap items-center gap-1.5 mb-4 text-xs md:text-sm" aria-label="Chemin de navigation">
      <a href="<%= root_path %>" class="text-gray-300 hover:text-white transition-colors">Accueil</a>
      <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <a href="<%= shops_path %>" class="text-gray-300 hover:text-white transition-colors">Boutiques</a>
      <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-white font-medium truncate"><%= shop.name %></span>
    </nav>

    <%# Hero Banner avec image et contenu %>
    <header class="relative h-[280px] md:h-[360px] lg:h-[400px] overflow-hidden bg-gray-900 rounded-xl shadow-2xl" aria-labelledby="shop-name">
      <% if shop.banner_image.attached? %>
        <%= storage_image_tag(shop.banner_image,
            variant_name: :banner,
            alt: "Bannière #{shop.name}",
            class: "absolute inset-0 w-full h-full object-cover",
            eager: true,
            priority: true,
            width: 1280,
            height: 400) %>
      <% end %>
      
      <%# Overlay dégradé pour lisibilité %>
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-70"></div>
      
      <%# Contenu texte en bas %>
      <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 text-white">
        <div class="flex items-end justify-between gap-4">
          <div class="flex-1">
            <h1 id="shop-name" class="text-xl sm:text-2xl md:text-4xl lg:text-5xl font-bold mb-2 leading-tight"><%= shop.name %></h1>
            <p class="text-gray-100 text-sm md:text-base line-clamp-2">
              <%= shop.description.present? ? shop.description : "Découvrez nos produits exclusifs et nos meilleures offres" %>
            </p>
          </div>
        </div>
      </div>
    </header>
  </div>
</div>
