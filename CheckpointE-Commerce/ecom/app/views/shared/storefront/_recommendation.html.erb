<%# Section Recommandations %>
<%
  # Récupérer les catégories pour le select
  categories = ProductCategory.where(is_active: true).order(:name)
  
  # Compter le nombre total d'articles disponibles
  total_items = Item.available_for_sale.count
%>

<section class="container mx-auto px-4 lg:px-[50px] py-8 md:py-12" 
         data-controller="recommendation-tabs"
         aria-label="<%= t('storefront.recommendation.section_label', default: 'Recommandations') %>">
  
  <!-- Première ligne : Filtres (sans tabulation) -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
    <!-- Filtres : Type, Catégorie -->
    <div class="flex flex-wrap items-center gap-[10px]">
      <!-- Filtre: Recommandations -->
      <button type="button"
              data-recommendation-tabs-target="filter"
              data-action="click->recommendation-tabs#applyFilter"
              data-filter-type="tab"
              data-filter-value="recommendations"
              class="bg-[#551694] border border-[#551694] h-[48px] rounded-[10px] px-[13px] flex items-center gap-2 text-white text-sm font-medium hover:bg-[#4a1468] transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2"
              aria-label="<%= t('storefront.recommendation.tab_recommendations', default: 'Recommandations') %>">
        <svg class="w-[10.7px] h-[14px] fill-current" viewBox="0 0 384 512" aria-hidden="true">
          <path d="M216 23.86c0-23.8-30.65-32.77-44.15-13.04C48 191.85 224 200 224 288c0 35.63-29.11 64.46-64.85 63.99-35.17-.45-63.15-29.77-63.15-64.94v-85.51c0-21.7-26.47-32.23-41.43-16.5C27.8 213.16 0 261.33 0 320c0 105.1 86.13 192 192 192s192-86.9 192-192c0-170.29-168-193-168-296.14z"/>
        </svg>
        <span><%= t('storefront.recommendation.tab_recommendations', default: 'Recommandations') %></span>
      </button>

      <!-- Filtre: Meilleurs deals -->
      <button type="button"
              data-recommendation-tabs-target="filter"
              data-action="click->recommendation-tabs#applyFilter"
              data-filter-type="tab"
              data-filter-value="best_deals"
              class="bg-[#f3f6f9] border border-[#d1d5db] h-[48px] rounded-[10px] px-[22px] flex items-center gap-2 text-[#3f4254] text-sm font-normal hover:bg-[#e5e9ed] transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2"
              aria-label="<%= t('storefront.recommendation.tab_best_deals', default: 'Meilleurs deals') %>">
        <svg class="w-[8.95px] h-[14px] fill-[#551694]" viewBox="0 0 320 512" aria-hidden="true">
          <path d="M296 160H180.6l42.6-129.8C227.2 15 215.7 0 200 0H56C44 0 33.8 8.9 32.2 20.8l-32 240C-1.7 275.2 9.5 288 24 288h118.7L96.6 482.5c-4.3 17.1 6.1 34.5 23.3 38.8 17.2 4.3 34.5-6.1 38.8-23.3l46.4-185.2c1.5-6.2 1.5-12.5 0-18.7L144.6 288H24c-8.8 0-16-7.2-16-16s7.2-16 16-16h272c8.8 0 16 7.2 16 16s-7.2 16-16 16z"/>
        </svg>
        <span><%= t('storefront.recommendation.tab_best_deals', default: 'Meilleurs deals') %></span>
      </button>

      <!-- Filtre: Les meilleures ventes -->
      <button type="button"
              data-recommendation-tabs-target="filter"
              data-action="click->recommendation-tabs#applyFilter"
              data-filter-type="tab"
              data-filter-value="best_sales"
              class="bg-[#f3f6f9] border border-[#d1d5db] h-[48px] rounded-[10px] px-[15px] flex items-center gap-2 text-[#3f4254] text-sm font-normal hover:bg-[#e5e9ed] transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2"
              aria-label="<%= t('storefront.recommendation.tab_best_sales', default: 'Les meilleures ventes') %>">
        <svg class="w-[15.95px] h-[14px] fill-[#551694]" viewBox="0 0 576 512" aria-hidden="true">
          <path d="M287.9 0c9.2 0 17.6 5.2 21.6 13.5l68.6 141.3 153.2 22.7c9 1.3 16.5 7.6 19.3 16.3s.5 18.1-5.9 24.5L433.6 328.4l26.2 155.6c1.5 9-2.2 18.1-9.6 23.5s-17.3 6-25.3 1.7l-137-73.2L151 509.1c-8.1 4.3-17.9 3.7-25.3-1.7s-11.2-14.5-9.7-23.5l26.2-155.6L31.1 218.2c-6.5-6.4-8.7-15.9-5.9-24.5s10.3-14.9 19.3-16.3l153.2-22.7L266.3 13.5C270.4 5.2 278.7 0 287.9 0zm0 79L235.4 187.2c-3.5 7.1-10.2 12.1-18.1 13.3L99 217.9 184.9 303c5.5 5.5 8.1 13.3 6.8 21L171.4 443.7l105.2-56.2c7.1-3.8 15.6-3.8 22.6 0l105.2 56.2L384.2 324.1c-1.3-7.7 1.2-15.5 6.8-21L477.9 237l-118.2-17.5c-7.8-1.1-14.6-6.1-18.1-13.3L287.9 79z"/>
        </svg>
        <span><%= t('storefront.recommendation.tab_best_sales', default: 'Les meilleures ventes') %></span>
      </button>

      <!-- Select Catégorie -->
      <div class="relative" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle"
                class="bg-[#f3f6f9] border border-[#d1d5db] h-[48px] rounded-[10px] px-4 flex items-center justify-center gap-[10px] text-[#4b5675] text-sm font-normal hover:bg-[#e5e9ed] transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 min-w-[133px]"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label="<%= t('storefront.recommendation.filter_category', default: 'Filtrer par catégorie') %>">
          <span><%= t('storefront.recommendation.category_label', default: 'Catégorie') %></span>
          <svg class="w-3 h-[10px] fill-[#4b5675]" viewBox="0 0 320 512" aria-hidden="true">
            <path d="M137.4 374.6c12.5 12.5 32.8 12.5 45.3 0l128-128c9.2-9.2 11.9-22.9 6.9-34.9s-16.6-19.8-29.6-19.8L32 192c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9l128 128z"/>
          </svg>
        </button>
        
        <!-- Dropdown Menu -->
        <div data-dropdown-target="menu"
             class="hidden absolute top-full left-0 mt-2 bg-white border border-[#d1d5db] rounded-[10px] shadow-lg z-50 min-w-[200px] max-h-[300px] overflow-y-auto">
          <div class="py-2">
            <button type="button"
                    class="w-full text-left block px-4 py-2 text-sm text-[#3f4254] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                    data-action="click->recommendation-tabs#filterByCategory"
                    data-category-id="">
              <%= t('storefront.recommendation.all_categories', default: 'Toutes les catégories') %>
            </button>
            <% categories.each do |category| %>
              <button type="button"
                      class="w-full text-left block px-4 py-2 text-sm text-[#3f4254] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                      data-action="click->recommendation-tabs#filterByCategory"
                      data-category-id="<%= category.id %>">
                <%= category.name %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Compteur d'articles et Select Tri -->
    <div class="flex items-center justify-between sm:justify-start gap-3 flex-wrap sm:flex-nowrap">
      <!-- Compteur d'articles -->
      <div class="text-sm font-medium text-[#18181b] whitespace-nowrap">
        <span data-recommendation-tabs-target="itemsCount"><%= total_items %></span>
        <span> <%= t('storefront.recommendation.articles', default: 'Articles') %></span>
      </div>

      <!-- Select Tri -->
      <div class="relative flex-1 sm:flex-none" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle"
                class="w-full sm:w-auto border border-[#cbd6e2] h-[48px] rounded-[10px] px-5 flex items-center justify-between sm:justify-center gap-[9px] text-[#80808f] text-sm font-normal hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2 sm:min-w-[180px]"
                aria-haspopup="true"
                aria-expanded="false">
          <span class="sr-only"><%= t('storefront.recommendation.sort_by', default: 'Trier par') %> :</span>
          <span class="truncate"><%= t('storefront.recommendation.sort_most_relevant', default: 'Les plus pertinentes') %></span>
          <svg class="w-3 h-[10px] fill-[#80808f]" viewBox="0 0 320 512" aria-hidden="true">
            <path d="M137.4 374.6c12.5 12.5 32.8 12.5 45.3 0l128-128c9.2-9.2 11.9-22.9 6.9-34.9s-16.6-19.8-29.6-19.8L32 192c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9l128 128z"/>
          </svg>
        </button>
        
        <!-- Dropdown Menu Tri -->
        <div data-dropdown-target="menu"
             class="hidden absolute top-full right-0 mt-2 bg-white border border-[#cbd6e2] rounded-[10px] shadow-lg z-50 min-w-[180px]">
          <div class="py-2">
            <button type="button"
                    class="w-full text-left block px-4 py-2 text-sm text-[#80808f] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                    data-action="click->recommendation-tabs#sortBy"
                    data-sort="relevant">
              <%= t('storefront.recommendation.sort_most_relevant', default: 'Les plus pertinentes') %>
            </button>
            <button type="button"
                    class="w-full text-left block px-4 py-2 text-sm text-[#80808f] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                    data-action="click->recommendation-tabs#sortBy"
                    data-sort="price_asc">
              <%= t('storefront.recommendation.sort_price_asc', default: 'Prix croissant') %>
            </button>
            <button type="button"
                    class="w-full text-left block px-4 py-2 text-sm text-[#80808f] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                    data-action="click->recommendation-tabs#sortBy"
                    data-sort="price_desc">
              <%= t('storefront.recommendation.sort_price_desc', default: 'Prix décroissant') %>
            </button>
            <button type="button"
                    class="w-full text-left block px-4 py-2 text-sm text-[#80808f] hover:bg-[#f3f6f9] hover:text-[#551694] transition-colors"
                    data-action="click->recommendation-tabs#sortBy"
                    data-sort="newest">
              <%= t('storefront.recommendation.sort_newest', default: 'Plus récents') %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu des produits -->
  <div data-recommendation-tabs-target="content" 
       class="products-container"
       data-turbo="false">
    <!-- Les produits seront chargés ici via JavaScript/Stimulus -->
    <div data-recommendation-tabs-target="loading" class="text-center py-8">
      <p class="text-gray-500">
        <%= t('storefront.recommendation.loading', default: 'Chargement des produits...') %>
      </p>
    </div>
  </div>
</section>

