<% content_for :title, "Sign up" %>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-8">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Create your account</h1>
    <p class="text-sm text-slate-500 mb-6">Join EduCMS as a subscriber; you can request author privileges later.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :first_name, autofocus: true,
                class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :last_name,
                class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
        <p class="text-xs text-slate-500 mt-1">
          <% if @minimum_password_length %><%= @minimum_password_length %> characters minimum.<% end %>
        </p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
      </div>

      <div>
        <%= f.submit "Create account", class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
