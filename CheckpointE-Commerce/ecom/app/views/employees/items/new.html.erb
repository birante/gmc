<% content_for :active_tab, 'catalogue' %>

<div class="flex flex-col min-h-screen bg-gray-50">
  <main class="flex-1 px-4 sm:px-6 lg:px-12 xl:px-28 py-6">
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= t('vendors.items.new.title') %></h1>
        <p class="text-sm text-gray-500 mt-1">Créez un nouveau produit pour votre boutique.</p>
      </div>
      <%= link_to url_with_shop(employees_items_path, @current_shop),
          class: "inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Retour au catalogue
      <% end %>
    </div>

    <div data-controller="product-sheet" data-product-sheet-generate-preview-url-value="<%= generate_ai_preview_employees_items_path %>" data-product-sheet-page-mode-value="true">
      <%= render partial: "product_sheet", locals: { item: @item, page_mode: true } %>
    </div>
  </main>

</div>
