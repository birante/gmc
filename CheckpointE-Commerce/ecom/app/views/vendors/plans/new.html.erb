<% content_for :title, @is_upgrade ? "Mettre à niveau votre offre" : "Choisissez votre offre" %>
<div class="w-full max-w-7xl mx-auto px-0 sm:px-2 md:px-4">
  <div class="mx-auto mb-6 max-w-3xl text-center md:mb-8">
    <div class="mx-auto mb-3 flex items-center justify-center">
      <%= image_tag "logo-mini.png", alt: "aa", class: "h-8 w-auto object-contain" %>
    </div>
    <p class="text-xs font-semibold uppercase tracking-wide text-[#6f5a98]">Étape 3 sur 3</p>
    <h2 class="mt-1 text-xl font-bold text-[#2f1f4f] md:text-2xl"><%= @is_upgrade ? "Finalisez votre mise à niveau" : "Finalisez votre enregistrement" %></h2>
    <p class="mt-1 text-sm text-[#6f5a98]"><%= @is_upgrade ? "Sélectionnez une nouvelle offre pour activer plus de fonctionnalités" : "Enregistrez votre compte en quelques clics" %></p>
  </div>
  <!-- Information sur le plan actuel si c'est un upgrade -->
  <% if @is_upgrade && @current_plan %>
    <div class="bg-blue-50 border-l-4 border-blue-400 p-3 sm:p-4 mb-6 md:mb-8 rounded-r-lg">
      <div class="flex items-start sm:items-center">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-blue-700">
            Votre plan actuel : <strong><%= @current_plan.name %></strong>
            <% if @current_plan.price.present? %>
              (<%= number_with_delimiter(@current_plan.price.to_i) %> FCFA)
            <% end %>
            — Sélectionnez un plan supérieur pour mettre à niveau votre boutique.
          </p>
        </div>
      </div>
    </div>
  <% end %>
  <!-- Formulaire de sélection de plan et paiement -->
  <%= form_with url: vendors_plan_path, method: :post, local: true, data: { turbo: false, upgrade: @is_upgrade }, id: "plan-form" do |form| %>
    <%= hidden_field_tag :upgrade, params[:upgrade] if params[:upgrade].present? %>
    <%= hidden_field_tag :shop_slug, params[:shop_slug] if params[:shop_slug].present? %>
    <!-- Carousel des plans -->
    <div class="relative mb-8 md:mb-10">
      <button type="button" id="plans-prev-btn" class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-3 z-10 h-10 w-10 items-center justify-center rounded-full border border-[#D9CCE8] bg-white text-[#551694] shadow-sm hover:shadow-md transition" aria-label="Plan précédent">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.78 15.53a.75.75 0 01-1.06 0L7.25 11.06a1.5 1.5 0 010-2.12l4.47-4.47a.75.75 0 111.06 1.06L8.31 10l4.47 4.47a.75.75 0 010 1.06z" clip-rule="evenodd"/></svg>
      </button>
      <div id="plans-carousel" class="flex gap-3 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-3 px-1 sm:px-2 [scrollbar-width:none] [-ms-overflow-style:none] touch-pan-x md:justify-center md:gap-4 md:overflow-visible md:snap-none">
        <% @plans.each_with_index do |plan, index| %>
          <% 
            is_selected = @selected_plan_id == plan.id
          features = plan_features(plan)
          plan_price = plan.formatted_price
        %>
          <!-- Carte du plan -->
          <div class="w-[85%] min-w-[85%] sm:w-[300px] sm:min-w-[300px] md:w-[300px] md:min-w-0 md:max-w-[320px] snap-center md:snap-start bg-white rounded-2xl border-2 border-[#D8CFE8] shadow-sm overflow-hidden hover:shadow-md transition-all flex flex-col <%= is_selected ? 'ring-4 ring-[#551694] border-[#551694]' : '' %>" data-plan-id="<%= plan.id %>" data-plan-code="<%= plan.code %>" data-requires-payment="<%= plan.price.to_f.positive? && plan.purchasable_online? %>">
            <!-- Badge "Sélectionné" -->
            <% if is_selected %>
              <div class="bg-[#551694] text-white text-center py-2 px-4 text-sm font-semibold flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Plan sélectionné
              </div>
            <% end %>
            <!-- En-tête de la carte -->
            <div class="p-4 border-b border-[#EEE7F7]">
              <h3 class="text-base font-bold text-[#551694] mb-1.5">
                <%= case plan.code
                    when "STARTER" then "aa Starter"
                    when "BUSINESS" then "aa Business"
                    when "PARTNER" then "aa Partner"
                    else plan.name
                    end %>
              </h3>
              <!-- Prix -->
              <div class="mb-3">
                <div class="text-xl font-bold">
                  <% if plan.code == "ACCESS" %>
                    <span class="text-gray-900"><%= number_with_delimiter((plan.price || 0).to_i) %></span>
                    <span class="text-gray-500 font-normal">FCFA</span>
                  <% elsif plan.requires_contact? %>
                    <span class="text-gray-900">Sur devis</span>
                  <% elsif plan.price.present? && plan.billing_period_months.present? && plan.billing_period_months > 0 %>
                    <span class="text-gray-900"><%= number_with_delimiter(plan.price.to_i) %></span>
                    <span class="text-gray-500 font-normal text-sm">FCFA</span>
                    <span class="text-gray-500 font-normal text-sm">/ <%= plan.billing_period_months %> MOIS</span>
                  <% else %>
                    <span class="text-gray-900">Sur devis</span>
                  <% end %>
                </div>
                <% if plan.code == "ACCESS" %>
                  <div class="text-sm text-gray-600 mt-1"><%= (plan.price || 0).to_i.zero? ? "Gratuit" : "Abonnement mensuel" %></div>
                <% end %>
              </div>
              <!-- Cible -->
              <div class="text-xs text-gray-600 mb-3">
                <strong class="text-gray-900">Cible:</strong>
                <%= case plan.code
                when "ACCESS"
                  "Revendeurs, micro-commerçants, vendeurs débutants"
                when "STARTER"
                  "Petites marques locales, vendeurs Instagram / WhatsApp."
                when "BUSINESS"
                  "Marques locales établies, PME, vendeurs multi-canaux."
                when "PARTNER"
                  "Grandes marques, franchises, enseignes nationales et internationales."
                else
                  plan.description
                end %>
              </div>
              <!-- Bouton Choisir -->
              <div class="w-full">
                <% if plan.requires_contact? %>
                  <%= link_to t("vendors.plans.contact_support"), Plan.support_contact_phone_href,
                  class: "w-full px-4 py-2.5 rounded-lg font-semibold text-sm transition-all bg-[#551694] text-white hover:bg-[#4a1468] block text-center" %>
                  <p class="mt-3 text-xs leading-5 text-gray-600">
                    <%= t("vendors.plans.custom_plan_inline_notice", phone: Plan.support_contact_phone) %>
                  </p>
                <% else %>
                  <%= radio_button_tag :plan_id, plan.id, is_selected, {
                  id: "plan_#{plan.id}",
                  class: "hidden plan-radio",
                  data: { plan_code: plan.code }
                } %>
                  <label for="plan_<%= plan.id %>" class="w-full cursor-pointer plan-choice-btn block">
                    <% 
                  if is_selected
                    button_class = "w-full px-4 py-2.5 rounded-lg font-semibold text-sm transition-all bg-[#551694] text-white flex items-center justify-center gap-2"
                    button_text = '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Sélectionné'.html_safe
                  elsif plan.code == "STARTER"
                    button_class = "w-full px-4 py-2.5 rounded-lg font-semibold text-sm transition-all bg-[#551694] text-white hover:bg-[#4a1468] block text-center"
                    button_text = "Choisir ce plan"
                  else
                    button_class = "w-full px-4 py-2.5 rounded-lg font-semibold text-sm transition-all bg-[rgba(137,83,255,0.07)] text-[#551694] hover:bg-[rgba(137,83,255,0.12)] block text-center"
                    button_text = "Choisir ce plan"
                  end
                %>
                    <span class="<%= button_class %>"><%= button_text %></span>
                  </label>
                <% end %>
              </div>
            </div>
            <!-- Fonctionnalités -->
            <div class="p-4 flex-1">
              <% sections = plan_feature_sections(plan: plan, features: features, is_upgrade: @is_upgrade, active_tab: @active_tab) %>
              <% main_section = sections.first %>
              <h4 class="text-xs font-semibold text-gray-900 mb-2"><%= main_section[:title] || "Fonctionnalités" %></h4>
              <ul class="space-y-1.5">
                <% main_section[:items].each do |item| %>
                  <% unavailable = item[:available] == false %>
                  <li class="flex items-start text-xs <%= unavailable ? 'text-gray-400' : 'text-gray-700' %>">
                    <% if unavailable %>
                      <svg class="w-5 h-5 text-gray-300 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                      </svg>
                    <% else %>
                      <svg class="w-5 h-5 text-[#551694] mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    <% end %>
                    <span><%= item[:text] %></span>
                  </li>
                <% end %>
              </ul>
              <% sections.drop(1).each do |section| %>
                <div class="mt-4 pt-4 border-t border-gray-200">
                  <h5 class="text-xs font-semibold text-gray-900 mb-2"><%= section[:title] %></h5>
                  <ul class="space-y-1">
                    <% section[:items].each do |item| %>
                      <li class="flex items-start text-xs text-gray-700">
                        <svg class="w-4 h-4 text-[#551694] mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span><%= item[:text] %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" id="plans-next-btn" class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-3 z-10 h-10 w-10 items-center justify-center rounded-full border border-[#D9CCE8] bg-white text-[#551694] shadow-sm hover:shadow-md transition" aria-label="Plan suivant">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.22 4.47a.75.75 0 011.06 0l4.47 4.47a1.5 1.5 0 010 2.12l-4.47 4.47a.75.75 0 11-1.06-1.06L11.69 10 7.22 5.53a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
      </button>
    </div>
    <div class="mb-6 flex items-center justify-between gap-3 md:hidden">
      <p class="text-xs text-[#6f5a98]">Faites glisser pour voir toutes les offres</p>
      <div class="flex items-center gap-1.5" id="plans-dots">
        <% @plans.each_with_index do |plan, idx| %>
          <button type="button" class="plan-dot h-2 w-2 rounded-full <%= idx.zero? ? 'bg-[#551694]' : 'bg-[#d5c8ea]' %>" data-dot-index="<%= idx %>" aria-label="Aller au plan <%= idx + 1 %>"></button>
        <% end %>
      </div>
    </div>
    <div id="selected-plan-summary" class="hidden mb-6 rounded-2xl border border-[#D9CCE8] bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-[#6f5a98] mb-1">Plan sélectionné</p>
      <div class="flex items-center justify-between gap-3">
        <div>
          <p id="selected-plan-name" class="text-base font-semibold text-[#2f1f4f]"></p>
          <p id="selected-plan-caption" class="text-sm text-[#6f5a98]"></p>
        </div>
        <span class="text-xs px-2 py-1 rounded-full bg-[#efe8fb] text-[#551694] font-medium">Prêt à continuer</span>
      </div>
    </div>
    <!-- Section Méthode de paiement (affichée si au moins un plan a un prix > 0) -->
    <% has_paid_plans = @plans.any? { |p| p.price.to_f.positive? && p.purchasable_online? } %>
    <% payment_options = subscription_payment_options %>
    <div id="payment-section" class="<%= has_paid_plans ? '' : 'hidden' %> bg-white rounded-xl shadow-sm border border-gray-200 p-4 md:p-6 mb-24 md:mb-8" data-controller="payment-selection">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Méthode de paiement</h2>
      <p class="text-sm text-gray-600 mb-4">Sélectionnez votre mode de paiement préféré pour finaliser votre abonnement.</p>
      <% if payment_options.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
          <% payment_options.each do |option| %>
            <label class="flex flex-col items-center gap-2 p-3 border-2 border-gray-200 rounded-lg cursor-pointer transition-all hover:border-[#551694] hover:shadow-sm group payment-online min-h-[130px]" data-payment-type="online" data-payment-selection-target="onlineLabel">
              <%= radio_button_tag :withdraw_mode, option[:withdraw_mode], false,
                data: {
                  payment_selection_target: "onlineRadio",
                  action: "change->payment-selection#onlineSelected"
                },
                required: true,
                class: "w-4 h-4 text-[#551694] focus:ring-[#551694] self-start payment-online-option" %>
              <div class="w-14 h-14 bg-white rounded-lg flex items-center justify-center group-hover:scale-105 transition-transform shadow-sm border border-gray-200 p-2">
                <%= image_tag option[:icon], alt: option[:label], class: "w-full h-full object-contain" %>
              </div>
              <div class="text-center">
                <h3 class="font-semibold text-sm text-gray-900"><%= option[:label] %></h3>
              </div>
            </label>
          <% end %>
        </div>
      <% else %>
        <div class="mb-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          Aucun moyen de paiement actif n'est configuré. Veuillez contacter l'administrateur.
        </div>
      <% end %>
    </div>
    <div class="sticky bottom-2 md:bottom-4 z-20 bg-white/95 backdrop-blur border border-[#E6E0F2] rounded-2xl p-3 md:p-4 shadow-lg" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
      <%= form.submit "Sélectionnez un plan",
        id: "main-submit-btn",
        disabled: @selected_plan_id.blank?,
        class: "w-full px-5 py-3 bg-gradient-to-r from-[#551694] to-[#6a1fa8] text-white rounded-lg hover:from-[#6a1fa8] hover:to-[#7d2bc0] transition-all duration-200 font-semibold text-base shadow-md hover:shadow-lg disabled:bg-gray-400 disabled:cursor-not-allowed disabled:opacity-60" %>
    </div>
  <% end %>
</div>
<script>
  // Gestion de la sélection de plan (JavaScript vanilla) compatible Turbo
  function initPlanSelection() {
    const planRadios = document.querySelectorAll('.plan-radio');
    const paymentSection = document.getElementById('payment-section');
    const mainSubmitBtn = document.getElementById('main-submit-btn');
    const form = document.getElementById('plan-form');
    if (!form || form.dataset.planSelectionInitialized === 'true') return;
    form.dataset.planSelectionInitialized = 'true';
    const isUpgradeFlow = form?.dataset?.upgrade === 'true';
    const carousel = document.getElementById('plans-carousel');
    const prevBtn = document.getElementById('plans-prev-btn');
    const nextBtn = document.getElementById('plans-next-btn');
    const summaryBox = document.getElementById('selected-plan-summary');
    const summaryName = document.getElementById('selected-plan-name');
    const summaryCaption = document.getElementById('selected-plan-caption');
    const dots = document.querySelectorAll('.plan-dot');

    // Fonction pour mettre à jour l'affichage d'un plan
    function updatePlanDisplay(planId, planCode) {
      // Retirer la sélection visuelle de tous les plans
      document.querySelectorAll('[data-plan-id]').forEach(card => {
        // Retirer les styles de sélection
        card.style.borderColor = '';
        card.style.borderWidth = '';
        card.style.boxShadow = '';

        // Retirer le badge "Sélectionné"
        const children = Array.from(card.children);
        children.forEach(child => {
          if (child.textContent.includes('Plan sélectionné')) {
            child.remove();
          }
        });

        // Réinitialiser le bouton
        const btn = card.querySelector('.plan-choice-btn span');
        if (btn) {
          const cardPlanCode = card.dataset.planCode;
          if (cardPlanCode === 'STARTER' || cardPlanCode === 'PARTNER') {
            btn.className = 'w-full px-6 py-3 rounded-lg font-semibold transition-all bg-[#551694] text-white hover:bg-[#4a1468] block text-center';
          } else {
            btn.className = 'w-full px-6 py-3 rounded-lg font-semibold transition-all bg-[rgba(137,83,255,0.07)] text-[#551694] hover:bg-[rgba(137,83,255,0.12)] block text-center';
          }
          btn.innerHTML = 'Choisir ce plan';
        }
      });

      // Trouver la carte du plan sélectionné
      const selectedCard = document.querySelector(`[data-plan-id="${planId}"]`);
      if (!selectedCard) return;

      // Ajouter la sélection visuelle
      selectedCard.style.borderColor = '#551694';
      selectedCard.style.borderWidth = '4px';
      selectedCard.style.boxShadow = '0 0 0 4px rgba(85, 22, 148, 0.2)';

      // Ajouter le badge "Sélectionné"
      const badge = document.createElement('div');
      badge.style.cssText = 'background-color: #551694; color: white; text-align: center; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem;';
      badge.innerHTML = `
        <svg style="width: 1.25rem; height: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        Plan sélectionné
      `;
      selectedCard.insertBefore(badge, selectedCard.firstChild);

      // Mettre à jour le bouton
      const btn = selectedCard.querySelector('.plan-choice-btn span');
      if (btn) {
        btn.className = 'w-full px-6 py-3 rounded-lg font-semibold transition-all bg-[#551694] text-white flex items-center justify-center gap-2';
        btn.innerHTML = `
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          Sélectionné
        `;
      }

      // Gérer l'affichage de la section paiement (aligné sur plan.price > 0, pas seulement ACCESS)
      const requiresPayment = selectedCard.dataset.requiresPayment === 'true';
      const selectedTitle = selectedCard.querySelector('h3')?.textContent?.trim() || 'Plan';
      if (!requiresPayment) {
        if (paymentSection) paymentSection.classList.add('hidden');
        if (mainSubmitBtn) {
          mainSubmitBtn.value = isUpgradeFlow ? 'Mettre à niveau sans payer' : 'Créer ma boutique';
          mainSubmitBtn.disabled = false;
        }
        if (summaryBox && summaryName && summaryCaption) {
          summaryBox.classList.remove('hidden');
          summaryName.textContent = selectedTitle;
          summaryCaption.textContent = isUpgradeFlow ? 'Aucun paiement requis pour ce changement' : 'Activation immédiate sans paiement';
        }
        document.querySelectorAll('input[name="withdraw_mode"]').forEach(radio => {
          radio.required = false;
          radio.checked = false;
        });
      } else {
        if (paymentSection) paymentSection.classList.remove('hidden');
        if (mainSubmitBtn) {
          mainSubmitBtn.value = isUpgradeFlow ? 'Payer et mettre à niveau' : 'Valider et payer';
          mainSubmitBtn.disabled = false;
        }
        if (summaryBox && summaryName && summaryCaption) {
          summaryBox.classList.remove('hidden');
          summaryName.textContent = selectedTitle;
          summaryCaption.textContent = 'Paiement requis pour finaliser cette offre';
        }
        document.querySelectorAll('input[name="withdraw_mode"]').forEach(radio => {
          radio.required = true;
        });
        if (paymentSection) paymentSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    if (prevBtn && nextBtn && carousel) {
      const slideAmount = () => Math.max(Math.floor(carousel.clientWidth * 0.85), 280);
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -slideAmount(), behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: slideAmount(), behavior: 'smooth' });
      });

      const updateArrowsState = () => {
        const isDesktop = window.matchMedia('(min-width: 768px)').matches;
        const hasOverflow = carousel.scrollWidth > carousel.clientWidth;
        const showArrows = isDesktop && hasOverflow;

        prevBtn.classList.toggle('hidden', !showArrows);
        nextBtn.classList.toggle('hidden', !showArrows);

        if (!showArrows) return;
        prevBtn.disabled = carousel.scrollLeft <= 8;
        nextBtn.disabled = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 8;
        prevBtn.classList.toggle('opacity-40', prevBtn.disabled);
        nextBtn.classList.toggle('opacity-40', nextBtn.disabled);
      };

      carousel.addEventListener('scroll', updateArrowsState);
      window.addEventListener('resize', updateArrowsState);
      updateArrowsState();

      const updateActiveDot = () => {
        if (!dots.length) return;
        const firstCard = carousel.querySelector('[data-plan-id]');
        const cardWidth = firstCard?.clientWidth || 1;
        const gap = Number.parseFloat(window.getComputedStyle(carousel).columnGap || window.getComputedStyle(carousel).gap || '0') || 0;
        const rawIndex = Math.round(carousel.scrollLeft / (cardWidth + gap));
        const idx = Math.max(0, Math.min(dots.length - 1, rawIndex));
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-[#551694]', i === idx);
          dot.classList.toggle('bg-[#d5c8ea]', i !== idx);
        });
      };

      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const targetIndex = Number(dot.dataset.dotIndex || 0);
          const cards = carousel.querySelectorAll('[data-plan-id]');
          const targetCard = cards[targetIndex];
          if (targetCard) {
            carousel.scrollTo({ left: targetCard.offsetLeft - carousel.offsetLeft, behavior: 'smooth' });
          }
        });
      });

      carousel.addEventListener('scroll', updateActiveDot);
      updateActiveDot();
    }

    // Écouter les changements sur les radio buttons
    planRadios.forEach(radio => {
      radio.addEventListener('change', function() {
        const planCode = this.dataset.planCode;
        const planId = this.value;
        updatePlanDisplay(planId, planCode);
      });
    });

    // Initialiser l'affichage si un plan est déjà sélectionné
    const selectedRadio = document.querySelector('.plan-radio:checked');
    if (selectedRadio) {
      updatePlanDisplay(selectedRadio.value, selectedRadio.dataset.planCode);
    } else if (mainSubmitBtn) {
      mainSubmitBtn.value = 'Sélectionnez un plan';
      mainSubmitBtn.disabled = true;
      if (summaryBox) summaryBox.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', initPlanSelection);
  document.addEventListener('turbo:load', initPlanSelection);
</script>
