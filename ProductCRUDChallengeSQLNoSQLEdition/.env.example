# Copy to .env and adjust. Missing DBs are handled gracefully — the
# app boots even if one or both databases are unreachable; the affected
# routes just return 503 until the DB comes back.

PORT=3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/products

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=products
