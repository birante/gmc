# Copy this file to .env and fill in the values from https://api.slack.com/apps

# OAuth & Permissions -> "Bot User OAuth Token" (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Basic Information -> App Credentials -> "Signing Secret"
SLACK_SIGNING_SECRET=your-signing-secret

# OPTIONAL - Basic Information -> App-Level Tokens (scope: connections:write, starts with xapp-)
# When set, the bot runs in Socket Mode (no public URL / ngrok needed).
# Leave empty to run in HTTP mode (Events API Request URL).
SLACK_APP_TOKEN=

# Port for HTTP mode (ignored in Socket Mode)
PORT=3000

# OPTIONAL - where received messages are logged (default: logs/messages.log)
# MESSAGE_LOG_FILE=logs/messages.log
