<% content_for :title, t("pages.about.meta.title", default: "À propos de aa | Marketplace e-commerce du Sénégal") %>
<% content_for :meta_description, t("pages.about.meta.description", default: "aa simplifie le e-commerce au Sénégal. Découvrez notre mission, notre histoire et nos valeurs.") %>
<% content_for :canonical_url, request.original_url.split("?").first %>
<% content_for :structured_data do %>
  <%= combined_json_ld_tag(
    simple_page_schema(
      type: "AboutPage",
      name: t("pages.about.meta.title", default: "À propos de aa"),
      description: t("pages.about.meta.description", default: "aa simplifie le e-commerce au Sénégal."),
      url: about_url
    ),
    breadcrumb_schema([
      [ t("breadcrumbs.home", default: "Accueil"), root_url ],
      [ t("pages.about.breadcrumb", default: "À propos"), about_url ]
    ])
  ) %>
<% end %>
<%# ===== HERO ===== %>
<section class="bg-[#551694] text-white">
  <div class="container mx-auto px-4 lg:px-[50px] py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-bold leading-tight">
        <%= t("pages.about.hero.title_part_1", default: "Acheter en ligne en") %>
        <span class="text-[#FFC700]"><%= t("pages.about.hero.highlight_1", default: "toute") %></span>
        <%= t("pages.about.hero.title_part_2", default: "confiance.") %>
        <br>
        <%= t("pages.about.hero.title_part_3", default: "Vendre en ligne") %>
        <span class="text-[#FFC700]"><%= t("pages.about.hero.highlight_2", default: "sans complexité.") %></span>
      </h1>
      <p class="mt-6 text-base md:text-lg text-white/85 leading-relaxed">
        <%= t("pages.about.hero.subtitle", default: "aa est la marketplace pensée pour les acheteurs et vendeurs au Sénégal. Une plateforme simple, sécurisée et locale.") %>
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <%= link_to t("pages.about.hero.cta_buy", default: "Explorer les produits"),
            items_path,
            class: "inline-flex items-center justify-center bg-[#FFC700] text-[#201A40] font-semibold px-6 py-3 rounded-full hover:bg-[#FFD633] transition-colors" %>
        <%= link_to t("pages.about.hero.cta_sell", default: "Devenir vendeur"),
            become_vendor_path,
            class: "inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-full border border-white/30 transition-colors" %>
      </div>
    </div>
  </div>
</section>
<%# ===== À PROPOS DE aa ===== %>
<section class="bg-white py-12 md:py-20">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
      <div class="order-2 lg:order-1">
        <%= image_tag "about/apropos.png",
            alt: t("pages.about.intro.image_alt", default: "Cliente aa avec ses achats"),
            class: "w-full max-w-md mx-auto h-auto",
            loading: "lazy" %>
      </div>
      <div class="order-1 lg:order-2">
        <p class="text-xs uppercase tracking-[0.18em] text-[#551694] font-semibold mb-3">
          <%= t("pages.about.intro.tag", default: "Notre raison d'être") %>
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#201A40] mb-5">
          <%= t("pages.about.intro.title", default: "À propos de") %>
          <span class="text-[#551694]">aa</span>
        </h2>
        <p class="text-[#4B5675] leading-7 mb-4">
          <%= t("pages.about.intro.body_1", default: "aa est une marketplace 100 % sénégalaise qui réunit des milliers de boutiques locales et officielles. Notre ambition est de rendre le e-commerce accessible à tous, partout au Sénégal.") %>
        </p>
        <p class="text-[#4B5675] leading-7">
          <%= t("pages.about.intro.body_2", default: "De la mise en ligne d'un produit jusqu'à la livraison du dernier kilomètre, nous simplifions chaque étape pour que vendeurs et acheteurs puissent se concentrer sur l'essentiel.") %>
        </p>
      </div>
    </div>
  </div>
</section>
<%# ===== BANNIÈRE JAUNE ===== %>
<section class="bg-[#FFC700] py-12 md:py-16">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.18em] text-[#201A40] font-semibold mb-3">
        <%= t("pages.about.mission.tag", default: "Notre mission") %>
      </p>
      <h2 class="text-2xl md:text-3xl font-bold text-[#201A40] leading-snug">
        <%= t("pages.about.mission.body", default: "Parce que vendre en ligne au Sénégal ne devrait pas être compliqué, aa simplifie chaque étape du e-commerce, pour les vendeurs comme pour les acheteurs.") %>
      </h2>
    </div>
  </div>
</section>
<%# ===== STATS / CARTES VIOLETTES ===== %>
<section class="bg-white py-12 md:py-16">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
      <% stats = [
        { value: rounded_count_display(@about_stats[:shops_count]), label: t("pages.about.stats.shops_label",   default: "Boutiques actives") },
        { value: rounded_count_display(@about_stats[:items_count]), label: t("pages.about.stats.products_label", default: "Produits référencés") },
        { value: t("pages.about.stats.cities_value",  default: "14"),     label: t("pages.about.stats.cities_label",  default: "Régions couvertes") },
        { value: t("pages.about.stats.support_value", default: "24/7"),   label: t("pages.about.stats.support_label", default: "Assistance client") }
      ] %>
      <% stats.each do |s| %>
        <div class="bg-[#551694] text-white rounded-2xl p-6 text-center">
          <div class="w-12 h-12 rounded-full bg-white/15 mx-auto mb-3 flex items-center justify-center">
            <svg class="w-6 h-6 text-[#FFC700]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2.39 6.96H21.5l-5.55 4.03 2.12 6.96L12 15.92l-6.07 3.03 2.12-6.96L2.5 8.96h7.11z"/>
            </svg>
          </div>
          <div class="text-3xl font-bold mb-1"><%= s[:value] %></div>
          <div class="text-sm text-white/80"><%= s[:label] %></div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<%# ===== NOTRE HISTOIRE ===== %>
<section class="bg-white pb-12 md:pb-20">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
      <div>
        <p class="text-xs uppercase tracking-[0.18em] text-[#551694] font-semibold mb-3">
          <%= t("pages.about.history.tag", default: "Pourquoi aa existe ?") %>
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#201A40] mb-5">
          <%= t("pages.about.history.title", default: "Notre") %>
          <span class="text-[#551694]"><%= t("pages.about.history.title_highlight", default: "Histoire") %></span>
        </h2>
        <p class="text-[#4B5675] leading-7 mb-4">
          <%= t("pages.about.history.body_1", default: "aa est née d'un constat simple : au Sénégal, le commerce est dynamique, mais vendre et acheter en ligne reste compliqué. Entre le manque de visibilité, la gestion des commandes et les difficultés de livraison, beaucoup de vendeurs peinent à développer leur activité, et les acheteurs ne trouvent pas toujours une expérience fiable et simple.") %>
        </p>
        <p class="text-[#4B5675] leading-7">
          <%= t("pages.about.history.body_2", default: "Grâce à une expérience concrète du terrain, au niveau local et à l'international, aa conçoit une solution plus simple et plus adaptée aux réalités du marché sénégalais.") %>
        </p>
      </div>
      <div>
        <%= image_tag "about/history.png",
            alt: t("pages.about.history.image_alt", default: "Vendeuse sénégalaise utilisant aa dans sa boutique"),
            class: "w-full h-auto rounded-2xl",
            loading: "lazy" %>
      </div>
    </div>
  </div>
</section>
<%# ===== CE EN QUOI NOUS CROYONS ===== %>
<section class="bg-[#F5F3FB] py-12 md:py-20">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs uppercase tracking-[0.18em] text-[#551694] font-semibold mb-3">
          <%= t("pages.about.values.tag", default: "Nos valeurs") %>
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#201A40]">
          <%= t("pages.about.values.title_part_1", default: "Ce en quoi") %>
          <span class="text-[#551694]"><%= t("pages.about.values.title_highlight", default: "nous croyons") %></span>
        </h2>
      </div>
      <% values = [
        { title: t("pages.about.values.accessibility_title", default: "Accessibilité"),
          body:  t("pages.about.values.accessibility_body",  default: "Une plateforme simple à utiliser, accessible depuis n'importe quel mobile, dans la langue de chacun.") },
        { title: t("pages.about.values.performance_title",   default: "Performance"),
          body:  t("pages.about.values.performance_body",    default: "Des outils efficaces pour vendre vite, livrer mieux, et grandir avec son business.") },
        { title: t("pages.about.values.trust_title",         default: "Confiance"),
          body:  t("pages.about.values.trust_body",          default: "Des paiements sécurisés et un service client réactif pour des transactions sereines.") }
      ] %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% values.each do |v| %>
          <div class="bg-[#551694] text-white rounded-2xl p-7">
            <div class="w-11 h-11 rounded-full bg-white/15 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-[#FFC700]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2"><%= v[:title] %></h3>
            <p class="text-white/80 text-sm leading-6"><%= v[:body] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
