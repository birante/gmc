<%= form_with model: category, class: "space-y-4" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-700">
      <%= category.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :parent_id, "Parent category", class: "block text-sm font-medium mb-1" %>
      <%= f.collection_select :parent_id, Category.roots.where.not(id: category.id).order(:name), :id, :name, { include_blank: "—" }, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
    </div>
    <div>
      <%= f.label :display_order, class: "block text-sm font-medium mb-1" %>
      <%= f.number_field :display_order, class: "w-full px-3 py-2 rounded-md border border-gray-300" %>
    </div>
  </div>
  <label class="inline-flex items-center gap-2 text-sm">
    <%= f.check_box :active %> Active
  </label>
  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", categories_path, class: "px-3 py-1.5 text-sm text-slate-600" %>
    <%= f.submit class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-500" %>
  </div>
<% end %>
