<div class="flex items-center gap-2">
  <input 
    type="text" 
    class="flex-1 px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 text-sm"
    value="<%= resource.public_url %>"
    readonly
    data-copy-link-target="input"
  />
  <button
    type="button"
    class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition"
    data-copy-link-target="button"
    data-action="copy-link#copy"
  >
    Copier
  </button>
  <a
    href="<%= resource.public_url %>"
    target="_blank"
    rel="noopener noreferrer"
    class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg text-sm font-medium hover:bg-gray-300 transition"
    title="Ouvrir dans un nouvel onglet"
  >
    Ouvrir ↗
  </a>
</div>
