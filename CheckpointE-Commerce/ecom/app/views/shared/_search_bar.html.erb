<%
  # Classes par défaut pour le conteneur
  default_container_classes = "rounded-full bg-[#f1f1f4] relative h-[48px]"
  
  # Classes personnalisées passées en argument (optionnel)
  container_classes = local_assigns[:container_classes] || ""
  
  # Combiner les classes par défaut avec les classes personnalisées
  final_container_classes = "#{default_container_classes} #{container_classes}".strip
  
  # URL du formulaire (listing public produits + recherche boutiques)
  form_url = local_assigns[:form_url] || items_path
  
  # Placeholder personnalisé (optionnel)
  placeholder_text = local_assigns[:placeholder] || t('navigation.search_placeholder_products_shops', default: 'Produit ou boutique…')
  
  # Valeur par défaut du champ de recherche
  search_value = local_assigns[:search_value] || params[:search]
%>

<div class="<%= final_container_classes %>">
  <%= form_with url: form_url, method: :get, local: true, class: "relative w-full" do |f| %>
    <%= f.search_field :search,
        placeholder: placeholder_text,
        value: search_value,
        class: "absolute inset-0 w-full h-[48px] bg-transparent px-4 py-2 rounded-full focus:outline-none focus:ring-2 focus:ring-[#551694] pr-12" %>
    <%= f.button type: :submit, class: "absolute right-1 top-1 bg-[#551694] text-white w-10 h-10 rounded-full hover:bg-[#4a1468] transition-colors flex items-center justify-center" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    <% end %>
  <% end %>
</div>

