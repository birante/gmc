<%
  # Paramètres par défaut
  field_name ||= :password
  label_text ||= "Mot de passe"
  placeholder ||= "Votre mot de passe"
  autocomplete_value ||= "current-password"
  required ||= false
  minlength ||= nil
  helper_text ||= nil
  error_object ||= form.object
  show_label ||= true
  
  # Gestion des erreurs
  has_error = error_object&.errors && error_object.errors[field_name].any?
  border_class = has_error ? "border-red-400 focus:border-red-600" : "border-[#E9E9E9] focus:border-[#551694]"
%>

<div class="my-4 md:my-5" data-controller="password-toggle">
  <% if show_label %>
    <%= form.label field_name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
      <%= label_text %>
      <% if required %>
        <span class="text-xs text-red-500">*</span>
      <% end %>
    <% end %>
  <% end %>
  
  <div class="relative">
    <%= form.password_field field_name,
        placeholder: placeholder,
        autocomplete: autocomplete_value,
        required: required,
      minlength: minlength,
        data: { password_toggle_target: "input" },
        class: "block bg-[#F9F9F9] rounded-md border #{border_class} px-3 py-2.5 md:py-3 pr-10 mt-2 w-full text-base focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-opacity-20 transition-all" %>
    
    <button 
      type="button"
      data-password-toggle-target="toggle"
      data-action="click->password-toggle#toggle"
      class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none transition-colors"
      aria-label="Afficher/Masquer le mot de passe"
    >
      <!-- Icône sera gérée par JavaScript -->
    </button>
  </div>

  <% if helper_text.present? && !has_error %>
    <p class="text-xs text-gray-500 mt-1"><%= helper_text %></p>
  <% end %>
  
  <% if has_error %>
    <p class="text-xs text-red-500 mt-1">
      <%= error_object.errors[field_name].join(', ') %>
    </p>
  <% end %>
</div>

