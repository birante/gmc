# Rails standard
/.bundle
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets

/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-*

/coverage/

# Secrets — MUST NOT be committed to a public repo
config/master.key
config/credentials/*.key
.env
.env.*
!.env.example

# Node
node_modules/
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# macOS
.DS_Store
