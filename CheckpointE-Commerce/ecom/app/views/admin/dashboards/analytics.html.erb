<% content_for :page_title, "Analytics" %>
<% v = "#6C3FD6" %>

<%# ────────────────────────────────────────────────────────────────────
    FILTRE DATE — compact (identique au dashboard)
──────────────────────────────────────────────────────────────────── %>
<div class="mb-5 bg-white rounded-2xl border border-gray-100 px-4 py-3"
     style="box-shadow: 0 1px 4px rgba(0,0,0,0.05);">
  <%= form_with url: admin_hub_analytics_path, method: :get, data: { turbo: false },
      html: { class: "flex flex-wrap items-center gap-2" } do %>
    <%= hidden_field_tag :locale, params[:locale] if params[:locale].present? %>
    <span class="text-gray-400 mr-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    </span>
    <%= date_field_tag :start_date, d_start,
        class: "text-sm text-gray-700 border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none w-[140px]",
        style: "outline-color: #{v}" %>
    <span class="text-gray-300 text-sm">→</span>
    <%= date_field_tag :end_date, d_end,
        class: "text-sm text-gray-700 border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none w-[140px]",
        style: "outline-color: #{v}" %>
    <div class="flex items-center gap-1.5 ml-1">
      <%= submit_tag "Filtrer", class: "px-4 py-1.5 text-white text-sm font-semibold rounded-lg cursor-pointer", style: "background: #{v};" %>
      <%= link_to "✕", admin_hub_analytics_path, class: "px-3 py-1.5 text-sm text-gray-400 hover:text-gray-600 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors", data: { turbo: false } %>
    </div>
    <div class="flex items-center gap-1 pl-3 ml-1 border-l border-gray-100">
      <% [["7j", 7.days.ago.to_date, Date.current], ["30j", 30.days.ago.to_date, Date.current], ["90j", 90.days.ago.to_date, Date.current], ["Mois", Date.current.beginning_of_month, Date.current]].each do |label, ds, de| %>
        <% active = d_start == ds && d_end == de %>
        <%= link_to label, admin_hub_analytics_path(start_date: ds.to_s, end_date: de.to_s, locale: params[:locale]),
            class: "px-2.5 py-1 text-xs font-semibold rounded-lg transition-all whitespace-nowrap #{active ? "text-white" : "text-gray-500 hover:bg-gray-100"}",
            style: active ? "background: #{v};" : "", data: { turbo: false } %>
      <% end %>
    </div>
  <% end %>
</div>

<%# ────────────────────────────────────────────────────────────────────
    4 KPIs PRINCIPAUX
──────────────────────────────────────────────────────────────────── %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
  <% main_kpis = [
    { label: "Visites totales",   sub: "Sessions",          val: @total_visits || 0,  prev: @prev_visits || 0,  accent: "#3b82f6",  gradient: "linear-gradient(135deg,#3b82f6,#2563eb)", icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" },
    { label: "Pages vues",        sub: "Toutes vues",       val: @total_views || 0,   prev: @prev_pages || 0,   accent: v,          gradient: "linear-gradient(135deg,#6C3FD6,#9b6dff)", icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
    { label: "Boutiques vues",    sub: "Fiches produits",   val: @shops_vus || 0,     prev: @prev_shops || 0,   accent: "#8b5cf6",  gradient: "linear-gradient(135deg,#8b5cf6,#7c3aed)", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
    { label: "Taux de conversion", sub: "Boutique → commande", val: @conv_rate || 0, prev: nil,                 accent: "#10b981",  gradient: "linear-gradient(135deg,#10b981,#059669)", icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6", unit: "%" },
  ] %>
  <% main_kpis.each do |k| %>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 flex flex-col gap-4 relative overflow-hidden"
         style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
      <div class="absolute top-0 left-0 right-0 h-[3px] rounded-t-2xl" style="background: <%= k[:accent] %>;"></div>
      <div class="flex items-center justify-between">
        <div class="w-11 h-11 rounded-2xl flex items-center justify-center" style="background: <%= k[:gradient] %>;">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= k[:icon] %>"/>
          </svg>
        </div>
        <% if k[:prev] && k[:prev] > 0 %>
          <% pct = ((k[:val].to_f - k[:prev].to_f) / k[:prev].to_f * 100).round(1) %>
          <span class="text-xs font-bold px-2 py-1 rounded-full <%= pct >= 0 ? "bg-green-50 text-green-700" : "bg-red-50 text-red-600" %>">
            <%= pct >= 0 ? "↑" : "↓" %> <%= pct.abs %>%
          </span>
        <% end %>
      </div>
      <div>
        <p class="text-[26px] font-black leading-none text-gray-900 tracking-tight">
          <% fval = k[:val].to_i >= 10000 ? "#{(k[:val].to_f / 1000).round(1)}k" : number_with_delimiter(k[:val]) %>
          <%= fval %><% if k[:unit] %><span class="text-base font-semibold text-gray-400 ml-0.5"><%= k[:unit] %></span><% end %>
        </p>
        <p class="text-sm font-semibold text-gray-700 mt-1.5"><%= k[:label] %></p>
        <p class="text-xs text-gray-400 mt-0.5"><%= k[:sub] %></p>
      </div>
    </div>
  <% end %>
</div>

<%# ────────────────────────────────────────────────────────────────────
    FUNNEL DE CONVERSION
──────────────────────────────────────────────────────────────────── %>
<div class="bg-white rounded-2xl border border-gray-100 p-5 mb-5"
     style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h3 class="text-sm font-bold text-gray-900">Entonnoir de conversion</h3>
      <p class="text-xs text-gray-400 mt-0.5">De la visite à la commande</p>
    </div>
    <span class="text-xs font-bold px-3 py-1 rounded-full text-white" style="background: #{v};">
      Taux global : <%= @conv_rate || 0 %>%
    </span>
  </div>
  <% funnel = @funnel || [] %>
  <% max_val = funnel.map { |f| f[:val].to_i }.max.to_f; max_val = 1 if max_val.zero? %>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
    <% funnel_colors = ["#3b82f6","#6366f1","#8b5cf6",v,"#f59e0b","#10b981"] %>
    <% funnel.each_with_index do |f_item, idx| %>
      <div class="relative">
        <div class="rounded-2xl p-4 text-center border" style="border-color: <%= funnel_colors[idx] %>22; background: <%= funnel_colors[idx] %>0D;">
          <div class="text-2xl mb-2 leading-none"><%= f_item[:icon] %></div>
          <p class="text-xl font-black leading-none" style="color: <%= funnel_colors[idx] %>;">
            <% fv = f_item[:val].to_i %>
            <%= fv >= 10000 ? "#{(fv / 1000.0).round(1)}k" : number_with_delimiter(fv) %>
          </p>
          <p class="text-xs font-semibold mt-1" style="color: <%= funnel_colors[idx] %>BB;"><%= f_item[:label] %></p>
          <% if idx > 0 && funnel[idx - 1][:val].to_i > 0 %>
            <% pct = (f_item[:val].to_f / funnel[idx-1][:val].to_f * 100).round(1) %>
            <span class="inline-block mt-2 text-[10px] font-bold px-2 py-0.5 rounded-full bg-white border" style="color: <%= funnel_colors[idx] %>; border-color: <%= funnel_colors[idx] %>33;">
              <%= pct %>%
            </span>
          <% end %>
        </div>
        <%# Barre de progression relative %>
        <div class="mt-2 bg-gray-100 rounded-full h-1 overflow-hidden">
          <div class="h-1 rounded-full transition-all"
               style="width: <%= (f_item[:val].to_f / max_val * 100).to_i %>%; background: <%= funnel_colors[idx] %>;"></div>
        </div>
        <%# Flèche entre étapes (sauf dernière) %>
        <% if idx < funnel.length - 1 %>
          <div class="hidden lg:flex absolute -right-2 top-8 z-10 items-center justify-center w-4 h-4 rounded-full bg-white border border-gray-200">
            <svg class="w-2.5 h-2.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# ────────────────────────────────────────────────────────────────────
    GRAPHIQUES TRAFIC + APPAREILS
──────────────────────────────────────────────────────────────────── %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
  <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 p-5"
       style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h3 class="text-sm font-bold text-gray-900">Trafic quotidien</h3>
        <p class="text-xs text-gray-400 mt-0.5">Pages vues et boutiques consultées</p>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <span class="flex items-center gap-1.5"><span class="w-3 h-1.5 rounded-full inline-block" style="background: #{v};"></span><span class="text-gray-500">Pages</span></span>
        <span class="flex items-center gap-1.5"><span class="w-3 h-1.5 rounded-full inline-block bg-blue-400"></span><span class="text-gray-500">Boutiques</span></span>
      </div>
    </div>
    <% views_labeled = (@views_by_day || {}).sort.to_h.transform_keys { |d| d.strftime("%d/%m") rescue d.to_s } %>
    <% shop_labeled  = (@shop_by_day  || {}).sort.to_h.transform_keys { |d| d.strftime("%d/%m") rescue d.to_s } %>
    <%= line_chart [{ name: "Pages vues", data: views_labeled }, { name: "Boutiques vues", data: shop_labeled }],
        colors: [v, "#60a5fa"], height: "200px",
        library: {
          elements: { line: { tension: 0.4, borderWidth: 2 }, point: { radius: 0, hoverRadius: 4 } },
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: "#9ca3af", font: { size: 11 } } },
            y: { grid: { color: "#f3f4f6" }, ticks: { color: "#9ca3af", font: { size: 11 } } }
          }
        } %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-100 p-5"
       style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <h3 class="text-sm font-bold text-gray-900 mb-4">Appareils</h3>
    <% devs = (@devices || {}).transform_keys { |k| k.humanize } %>
    <%= pie_chart devs.presence || { "Aucune donnée" => 0 }, donut: true, height: "140px",
        colors: [v, "#3b82f6", "#10b981", "#f59e0b"],
        library: { plugins: { legend: { display: false } } } %>
    <div class="mt-4 space-y-2.5">
      <% device_icons = { "Desktop" => "🖥️", "Mobile" => "📱", "Tablet" => "📲" } %>
      <% device_colors = [v, "#3b82f6", "#10b981", "#f59e0b"] %>
      <% total_dev = (@devices || {}).values.sum.to_f; total_dev = 1 if total_dev.zero? %>
      <% (@devices || {}).sort_by { |_, c| -c }.each_with_index do |(dev, cnt), idx| %>
        <div class="flex items-center gap-2">
          <span class="text-base w-6 text-center"><%= device_icons[dev.capitalize] || "💻" %></span>
          <div class="flex-1">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-gray-700 font-semibold capitalize"><%= dev %></span>
              <span class="font-black" style="color: <%= device_colors[idx % 4] %>;"><%= (cnt.to_f / total_dev * 100).round %>%</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
              <div class="h-1.5 rounded-full" style="width: <%= (cnt.to_f / total_dev * 100).to_i %>%; background: <%= device_colors[idx % 4] %>;"></div>
            </div>
          </div>
          <span class="text-xs text-gray-400 w-10 text-right"><%= number_with_delimiter(cnt) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# ────────────────────────────────────────────────────────────────────
    NAVIGATEURS + SOURCES UTM
──────────────────────────────────────────────────────────────────── %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5">
  <div class="bg-white rounded-2xl border border-gray-100 p-5" style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-bold text-gray-900">Navigateurs</h3>
      <span class="text-xs text-gray-400"><%= (@browsers || []).sum(&:last) %> sessions</span>
    </div>
    <%= bar_chart (@browsers || []).to_h.presence || { "—" => 0 },
        colors: [v], height: "160px", horizontal: true,
        library: {
          plugins: { legend: { display: false } },
          scales: { x: { grid: { display: false } }, y: { grid: { display: false } } }
        } %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-100 p-5" style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-bold text-gray-900">Sources de trafic</h3>
      <span class="text-xs text-gray-400">UTM sources</span>
    </div>
    <% if (@sources || []).any? %>
      <div class="space-y-3">
        <% max_src = (@sources || []).map(&:last).max.to_f; max_src = 1 if max_src.zero? %>
        <% src_colors = ["#6C3FD6","#3b82f6","#10b981","#f59e0b","#ef4444","#8b5cf6","#06b6d4","#f97316"] %>
        <% (@sources || []).first(8).each_with_index do |(src, cnt), idx| %>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-[10px] font-black flex-shrink-0"
                 style="background: <%= src_colors[idx % 8] %>;">
              <%= (src[0] || "?").upcase %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-semibold text-gray-700 truncate"><%= src %></span>
                <span class="font-black ml-2 flex-shrink-0" style="color: <%= src_colors[idx % 8] %>;"><%= number_with_delimiter(cnt) %></span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                <div class="h-1.5 rounded-full" style="width: <%= (cnt.to_f / max_src * 100).to_i %>%; background: <%= src_colors[idx % 8] %>;"></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-10 text-center">
        <div class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center mx-auto mb-2">
          <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        </div>
        <p class="text-sm text-gray-400 font-medium">Aucune source UTM trackée</p>
        <p class="text-xs text-gray-300 mt-1">Ajoutez des paramètres utm_source à vos campagnes</p>
      </div>
    <% end %>
  </div>
</div>

<%# ────────────────────────────────────────────────────────────────────
    TOP PAGES · TOP BOUTIQUES · PAYS
──────────────────────────────────────────────────────────────────── %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

  <%# Top pages %>
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden" style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-50">
      <div>
        <h3 class="text-sm font-bold text-gray-900">Pages les plus vues</h3>
        <p class="text-xs text-gray-400 mt-0.5"><%= number_with_delimiter(@total_views || 0) %> vues totales</p>
      </div>
    </div>
    <% pages = (@top_pages || []).first(15) %>
    <% max_pv = pages.map(&:last).max.to_f; max_pv = 1 if max_pv.zero? %>
    <div class="divide-y divide-gray-50 max-h-[360px] overflow-y-auto">
      <% if pages.any? %>
        <% pages.each_with_index do |(pname, cnt), idx| %>
          <div class="flex items-center gap-3 px-5 py-2.5 hover:bg-gray-50/80 transition-colors">
            <span class="text-xs font-bold text-gray-300 w-5 flex-shrink-0"><%= idx + 1 %></span>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-700 truncate"><%= pname.presence || "Page d'accueil" %></p>
              <div class="mt-1 w-full bg-gray-100 rounded-full h-1 overflow-hidden">
                <div class="h-1 rounded-full" style="width: <%= (cnt.to_f / max_pv * 100).to_i %>%; background: #{v};"></div>
              </div>
            </div>
            <span class="text-xs font-black flex-shrink-0" style="color: #{v};"><%= number_with_delimiter(cnt) %></span>
          </div>
        <% end %>
      <% else %>
        <div class="py-10 text-center text-sm text-gray-300">Aucune donnée</div>
      <% end %>
    </div>
  </div>

  <%# Top boutiques analytics %>
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden" style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-50">
      <div>
        <h3 class="text-sm font-bold text-gray-900">Boutiques les plus vues</h3>
        <p class="text-xs text-gray-400 mt-0.5"><%= (@analytics_top_shops || []).size %> boutiques</p>
      </div>
      <%= link_to "Voir →", admin_shops_path(locale: params[:locale]), class: "text-xs font-semibold hover:underline flex-shrink-0", style: "color: #{v};" %>
    </div>
    <% top_shops_a = (@analytics_top_shops || []).first(10) %>
    <% max_sv = top_shops_a.map { |h| h[:views].to_i }.max.to_f; max_sv = 1 if max_sv.zero? %>
    <div class="divide-y divide-gray-50 max-h-[360px] overflow-y-auto">
      <% if top_shops_a.any? %>
        <% top_shops_a.each_with_index do |h, idx| %>
          <div class="flex items-center gap-3 px-5 py-2.5 hover:bg-gray-50/80 transition-colors">
            <span class="w-6 h-6 flex items-center justify-center rounded-lg text-white text-[11px] font-black flex-shrink-0"
                  style="background: <%= idx.zero? ? "#f59e0b" : idx == 1 ? "#94a3b8" : idx == 2 ? "#cd7c2c" : v %>;">
              <%= idx + 1 %>
            </span>
            <div class="flex-1 min-w-0">
              <%= link_to h[:shop].name, admin_shop_path(h[:shop], locale: params[:locale]),
                  class: "text-xs font-semibold text-gray-900 hover:underline block truncate" %>
              <div class="mt-1 w-full bg-gray-100 rounded-full h-1 overflow-hidden">
                <div class="h-1 rounded-full" style="width: <%= (h[:views].to_f / max_sv * 100).to_i %>%; background: #{v};"></div>
              </div>
            </div>
            <span class="text-xs font-black flex-shrink-0" style="color: #{v};"><%= h[:views] %></span>
          </div>
        <% end %>
      <% else %>
        <div class="py-10 text-center text-sm text-gray-300">Aucune boutique trackée</div>
      <% end %>
    </div>
  </div>

  <%# Pays %>
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden" style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-50">
      <div>
        <h3 class="text-sm font-bold text-gray-900">Répartition géographique</h3>
        <p class="text-xs text-gray-400 mt-0.5"><%= (@countries || []).size %> pays</p>
      </div>
    </div>
    <% countries = @countries || [] %>
    <% max_c = countries.map(&:last).max.to_f; max_c = 1 if max_c.zero? %>
    <% country_flags = { "France" => "🇫🇷", "Sénégal" => "🇸🇳", "Côte d'Ivoire" => "🇨🇮", "Mali" => "🇲🇱", "Guinée" => "🇬🇳", "Cameroun" => "🇨🇲", "Congo" => "🇨🇬", "Bénin" => "🇧🇯", "Togo" => "🇹🇬", "Burkina Faso" => "🇧🇫" } %>
    <div class="divide-y divide-gray-50 max-h-[360px] overflow-y-auto">
      <% if countries.any? %>
        <% countries.each_with_index do |(country, cnt), idx| %>
          <div class="flex items-center gap-3 px-5 py-2.5 hover:bg-gray-50/80 transition-colors">
            <span class="text-base w-6 text-center flex-shrink-0"><%= country_flags[country] || "🌍" %></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-semibold text-gray-700 truncate"><%= country %></span>
                <span class="font-black ml-2 flex-shrink-0 text-indigo-600"><%= number_with_delimiter(cnt) %></span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-1 overflow-hidden">
                <div class="h-1 rounded-full bg-indigo-400" style="width: <%= (cnt.to_f / max_c * 100).to_i %>%"></div>
              </div>
            </div>
            <span class="text-[10px] text-gray-300 flex-shrink-0 w-8 text-right"><%= (cnt.to_f / max_c * 100).round %>%</span>
          </div>
        <% end %>
      <% else %>
        <div class="py-10 text-center">
          <p class="text-sm text-gray-300 font-medium">Aucune donnée pays</p>
          <p class="text-xs text-gray-200 mt-1">Activez la géolocalisation Ahoy</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
