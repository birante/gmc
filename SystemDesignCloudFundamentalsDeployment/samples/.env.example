# Template for the MERN app's runtime env. Copy to `.env` locally
# (gitignored); on Azure, set the same keys in App Service Configuration.

# Node
NODE_ENV=production
# PORT is set by Azure automatically. Leave commented out to avoid
# collisions with the platform value.
# PORT=3000

# MongoDB Atlas connection string. Store the password in a secrets
# manager, not in a repo.
MONGO_URI="mongodb+srv://<user>:<password>@mern-prod.abcd.mongodb.net/mydb?retryWrites=true&w=majority"

# JWT / session — use at least 32 random bytes.
JWT_SECRET="replace-with-a-long-random-string"
SESSION_SECRET="another-long-random-string"

# Optional — Application Insights
APPINSIGHTS_INSTRUMENTATIONKEY=""
