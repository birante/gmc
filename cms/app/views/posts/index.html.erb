<% content_for :title, "Posts" %>
<div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
  <h1 class="text-2xl font-semibold tracking-tight">Posts</h1>
  <% if PostPolicy.new(current_user, Post.new).create? %>
    <%= link_to "+ New post", new_post_path, class: "px-3 py-1.5 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-500" %>
  <% end %>
</div>

<%= search_form_for @q, url: posts_path, class: "flex flex-wrap gap-2 mb-6" do |f| %>
  <%= f.search_field :title_cont, placeholder: "Search title…", class: "flex-1 min-w-[200px] px-3 py-2 rounded-md border border-gray-300 text-sm" %>
  <%= f.select :category_id_eq, Category.order(:name).pluck(:name, :id), { include_blank: "All categories" },
        class: "px-3 py-2 rounded-md border border-gray-300 text-sm" %>
  <%= f.submit "Filter", class: "px-4 py-2 rounded-md bg-slate-900 text-white text-sm hover:bg-slate-700" %>
<% end %>

<% if @posts.empty? %>
  <p class="text-slate-500 text-sm">No posts match your filters.</p>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @posts.each do |p| %>
      <article class="rounded-xl border border-gray-200 bg-white p-5 hover:shadow-md transition">
        <div class="flex items-center gap-2 text-xs mb-2">
          <% status_color = { "draft" => "bg-yellow-100 text-yellow-800", "published" => "bg-emerald-100 text-emerald-800", "archived" => "bg-slate-100 text-slate-600" }[p.status] %>
          <span class="px-1.5 py-0.5 rounded uppercase tracking-wider font-medium <%= status_color %>"><%= p.status %></span>
          <span class="text-slate-500"><%= p.category&.name %></span>
        </div>
        <h3 class="font-semibold text-slate-900 line-clamp-2 mb-1">
          <%= link_to p.title, post_path(p), class: "hover:text-indigo-600" %>
        </h3>
        <p class="text-sm text-slate-500 line-clamp-3"><%= p.excerpt_or_snippet %></p>
        <div class="mt-3 flex items-center gap-2 text-xs text-slate-400">
          <%= p.author&.full_name %> · <%= p.published_at&.strftime("%b %-d, %Y") || "unpublished" %> · <%= p.view_count %> views
        </div>
      </article>
    <% end %>
  </div>
  <div class="mt-6"><%= paginate @posts %></div>
<% end %>
