<%# Carrousels de produits par sous-catégorie pour boutiques officielles - style Jumia %>
<% show_categories = local_assigns[:force_show] || (shop.official? && shop_categories_with_products&.any?) %>
<% if show_categories %>
  <% primary_color = shop_primary_color(shop) %>
  <% secondary_color = shop_secondary_color(shop) %>

  <style>
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .shop-carousel-nav { color: var(--primary-color); border: 1px solid var(--primary-color); }
    .shop-carousel-nav:hover { background-color: var(--primary-color); color: #fff; }
    .shop-carousel-price { color: var(--primary-color); }
    .shop-carousel-cta { background-color: var(--primary-color); }
    .shop-carousel-cta:hover { filter: brightness(0.9); }
  </style>

  <%# Slider horizontal de catégories - chips compacts sur mobile pour laisser place aux produits %>
  <div class="mb-5 sm:mb-8">
    <h2 class="text-base sm:text-xl font-semibold text-gray-900 mb-3 sm:mb-5 px-1" style="color: var(--primary-color);">Explorer par catégorie</h2>
    <div class="relative" data-controller="horizontal-scroll">
      <nav data-horizontal-scroll-target="scrollable"
           class="flex gap-2 sm:gap-4 overflow-x-auto pb-2 sm:pb-4 px-1 sm:px-6 md:px-8 scrollbar-hide"
           style="scrollbar-width: none; -ms-overflow-style: none;"
           role="list"
           aria-label="<%= t('storefront.categories.nav_label', default: 'Catégories de produits') %>">
        <% shop_categories_with_products.each_with_index do |(category, products), index| %>
          <a href="#carousel-cat-<%= index %>"
             class="category-tab flex-shrink-0 group relative overflow-hidden rounded-lg sm:rounded-xl p-2.5 sm:p-5 transition-all duration-300 sm:hover:shadow-xl sm:hover:-translate-y-1 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 flex sm:block items-center gap-2.5 w-auto sm:w-[200px]"
             style="background-color: <%= primary_color %>15; border: 2px solid <%= primary_color %>40; --tw-ring-color: <%= primary_color %>;"
             data-scroll="carousel-cat-<%= index %>"
             role="listitem">
            <%# Élément décoratif d'arrière-plan (desktop uniquement) %>
            <div class="hidden sm:block absolute -right-10 -bottom-10 w-40 h-40 rounded-full opacity-20 group-hover:opacity-40 transition-opacity" style="background-color: <%= primary_color %>;"></div>

            <div class="relative z-10 flex sm:flex-col items-center sm:items-stretch gap-2.5 sm:gap-0">
              <%# Icône de catégorie %>
              <div class="inline-flex items-center justify-center w-9 h-9 sm:w-14 sm:h-14 rounded-md sm:rounded-xl sm:mb-4 text-2xl sm:text-3xl overflow-hidden flex-shrink-0" style="background-color: <%= primary_color %>20;">
                <% if category.respond_to?(:icon) && category.icon.attached? %>
                  <%= storage_image_tag(category.icon, variant_name: :icon, alt: category.name, class: "w-full h-full object-contain p-1", width: 56, height: 56) %>
                <% else %>
                  <% emojis = ["📱", "🖥️", "📺", "🏠", "👕", "👟", "💄", "🛍️"] %>
                  <%= emojis[index % emojis.length] %>
                <% end %>
              </div>

              <%# Texte de catégorie %>
              <div class="flex flex-col min-w-0">
                <h3 class="text-sm sm:text-xl font-bold text-gray-900 sm:mb-1.5 group-hover:text-white transition-colors leading-tight whitespace-nowrap sm:whitespace-normal">
                  <%= category.name %>
                </h3>
                <p class="text-[11px] sm:text-base text-gray-600 group-hover:text-gray-100 transition-colors leading-tight">
                  <%= products.size %> produit<%= products.size > 1 ? "s" : "" %>
                </p>

                <%# Flèche interactive (desktop uniquement) %>
                <div class="hidden sm:flex items-center gap-2 mt-auto pt-4">
                  <span class="text-3xl transition-transform duration-300 group-hover:translate-x-1">→</span>
                </div>
              </div>
            </div>

            <%# Hover overlay (derrière le contenu) %>
            <div class="absolute inset-0 z-0 opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300 rounded-lg sm:rounded-xl pointer-events-none" style="background-color: <%= primary_color %>;"></div>
          </a>
        <% end %>
      </nav>

      <%# Boutons de défilement - visibles mobile + desktop (overlay sur mobile) %>
      <button type="button"
              data-horizontal-scroll-target="leftButton"
              data-action="click->horizontal-scroll#scrollLeft"
              aria-label="<%= t('storefront.categories.scroll_left', default: 'Faire défiler les catégories vers la gauche') %>"
              class="flex absolute left-1 sm:left-0 top-1/2 -translate-y-1/2 sm:-translate-x-4 w-8 h-8 sm:w-10 sm:h-10 bg-white/90 sm:bg-white backdrop-blur-sm rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-[#551694] hover:shadow-xl transition-all z-10 focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2"
              style="color: var(--primary-color);">
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button type="button"
              data-action="click->horizontal-scroll#scrollRight"
              data-horizontal-scroll-target="rightButton"
              aria-label="<%= t('storefront.categories.scroll_right', default: 'Faire défiler les catégories vers la droite') %>"
              class="flex absolute right-1 sm:right-0 top-1/2 -translate-y-1/2 sm:translate-x-4 w-8 h-8 sm:w-10 sm:h-10 bg-white/90 sm:bg-white backdrop-blur-sm rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-[#551694] hover:shadow-xl transition-all z-10 focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-offset-2"
              style="color: var(--primary-color);">
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="space-y-4" style="--primary-color: <%= primary_color %>; --secondary-color: <%= secondary_color %>;">
    <% shop_categories_with_products.each_with_index do |(category, products), index| %>
      <section class="rounded-xl overflow-hidden" style="border: 2px solid <%= primary_color %>20;" data-carousel-index="<%= index %>" id="carousel-cat-<%= index %>">
        <div class="text-white px-3 sm:px-5 py-2 sm:py-2.5 flex items-center justify-between gap-3" style="background-color: var(--primary-color);">
          <h3 class="text-base sm:text-lg md:text-xl font-bold truncate"><%= category.name %> <span class="opacity-80 font-normal">| Meilleures offres</span></h3>
          <span class="text-xs opacity-80 whitespace-nowrap flex-shrink-0"><%= products.size %> article<%= products.size > 1 ? "s" : "" %></span>
        </div>

        <div class="bg-gray-50 px-2 sm:px-5 py-2 sm:py-3">
          <div class="relative flex items-center gap-0 md:gap-3">
            <button type="button" class="shop-carousel-nav flex absolute md:relative left-1 md:left-auto top-1/2 -translate-y-1/2 md:translate-y-0 md:top-auto z-10 md:z-auto flex-shrink-0 w-8 h-8 md:w-auto md:h-auto p-1.5 md:p-2.5 rounded-full bg-white/90 md:bg-white backdrop-blur-sm md:backdrop-blur-none transition-colors shadow-md md:shadow-sm hover:shadow-lg items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="--tw-ring-color: var(--primary-color);" data-carousel-prev aria-label="Produit précédent">
              <svg class="w-4 h-4 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>

            <div class="flex-1 min-w-0" data-carousel-container>
              <div class="flex gap-2.5 sm:gap-4 overflow-x-auto scrollbar-hide pb-1 snap-x snap-mandatory sm:snap-none scroll-smooth" data-carousel-track>
                <% products.each do |item| %>
                  <%= render "shops/carousel_product_card", item: item %>
                <% end %>
              </div>
            </div>

            <button type="button" class="shop-carousel-nav flex absolute md:relative right-1 md:right-auto top-1/2 -translate-y-1/2 md:translate-y-0 md:top-auto z-10 md:z-auto flex-shrink-0 w-8 h-8 md:w-auto md:h-auto p-1.5 md:p-2.5 rounded-full bg-white/90 md:bg-white backdrop-blur-sm md:backdrop-blur-none transition-colors shadow-md md:shadow-sm hover:shadow-lg items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="--tw-ring-color: var(--primary-color);" data-carousel-next aria-label="Produit suivant">
              <svg class="w-4 h-4 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
      </section>
    <% end %>
  </div>

  <script>
    (function () {
      function initShopCategoryCarousels(root) {
        const scope = root || document
        scope.querySelectorAll(".category-tab").forEach((tab) => {
          if (tab.dataset.bound === "1") return
          tab.dataset.bound = "1"
          tab.addEventListener("click", (e) => {
            e.preventDefault()
            const id = tab.getAttribute("data-scroll")
            document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" })
          })
        })

        scope.querySelectorAll("[data-carousel-index]").forEach((section) => {
          if (section.dataset.bound === "1") return
          const track = section.querySelector("[data-carousel-track]")
          const prev = section.querySelector("[data-carousel-prev]")
          const next = section.querySelector("[data-carousel-next]")
          const firstItem = track?.querySelector("article")?.parentElement
          if (!track || !prev || !next || !firstItem) return
          section.dataset.bound = "1"

          const gap = parseFloat(getComputedStyle(track).columnGap) || 12

          function step() {
            return firstItem.offsetWidth + gap
          }

          function updateButtons() {
            const maxScroll = track.scrollWidth - track.clientWidth
            prev.disabled = track.scrollLeft <= 0
            next.disabled = track.scrollLeft >= maxScroll - 1
          }

          prev.addEventListener("click", () => {
            track.scrollBy({ left: -step(), behavior: "smooth" })
          })

          next.addEventListener("click", () => {
            track.scrollBy({ left: step(), behavior: "smooth" })
          })

          track.addEventListener("scroll", updateButtons, { passive: true })
          window.addEventListener("resize", updateButtons, { passive: true })
          updateButtons()
        })
      }

      initShopCategoryCarousels()
      document.addEventListener("turbo:load", () => initShopCategoryCarousels())
      document.addEventListener("turbo:frame-load", (e) => initShopCategoryCarousels(e.target))
    })()
  </script>
<% end %>
