<%# Flash Sales - Ventes flash avec countdown %>
<%
  # Utiliser les produits passés ou charger des produits disponibles
  flash_items = local_assigns[:flash_items] || Item.available_for_sale.includes(:variants, :currency, :shop).limit(6)
  
  # Date de fin des ventes flash (par défaut: minuit)
  end_date = local_assigns[:flash_end_date] || Time.current.end_of_day.iso8601
%>

<div class="container mx-auto px-4 lg:px-[50px] py-6 md:py-8">
  <!-- Section Header with Flash Icon and Countdown -->
  <div class="bg-gradient-to-r from-red-600 to-red-500 rounded-xl p-4 md:p-6 mb-4 md:mb-6">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-4">
      <div class="flex items-center gap-2 md:gap-3">
        <div class="w-10 h-10 md:w-12 md:h-12 bg-white/20 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 md:w-6 md:h-6 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-white">
            Ventes Flash ⚡
          </h2>
          <p class="text-white/80 text-xs md:text-sm">Offres limitées dans le temps</p>
        </div>
      </div>
      
      <!-- Countdown Timer -->
      <div class="flex items-center gap-2" data-controller="countdown" data-countdown-end-date-value="<%= end_date %>">
        <span class="text-white/80 text-xs md:text-sm mr-1 md:mr-2">Se termine dans:</span>
        <div class="flex items-center gap-0.5 md:gap-1">
          <div class="flex flex-col items-center">
            <div class="bg-white text-red-600 px-2 md:px-3 py-1 md:py-2 rounded-lg text-sm md:text-xl font-mono font-bold min-w-[32px] md:min-w-[44px] text-center" data-countdown-target="hours">00</div>
            <span class="text-white/70 text-[8px] md:text-[10px] mt-0.5 md:mt-1">HEURES</span>
          </div>
          <span class="text-white text-lg md:text-2xl font-bold">:</span>
          <div class="flex flex-col items-center">
            <div class="bg-white text-red-600 px-2 md:px-3 py-1 md:py-2 rounded-lg text-sm md:text-xl font-mono font-bold min-w-[32px] md:min-w-[44px] text-center" data-countdown-target="minutes">00</div>
            <span class="text-white/70 text-[8px] md:text-[10px] mt-0.5 md:mt-1">MINS</span>
          </div>
          <span class="text-white text-lg md:text-2xl font-bold">:</span>
          <div class="flex flex-col items-center">
            <div class="bg-white text-red-600 px-2 md:px-3 py-1 md:py-2 rounded-lg text-sm md:text-xl font-mono font-bold min-w-[32px] md:min-w-[44px] text-center" data-countdown-target="seconds">00</div>
            <span class="text-white/70 text-[8px] md:text-[10px] mt-0.5 md:mt-1">SECS</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Products Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 md:gap-4">
    <% flash_items.each do |item| %>
      <% variant = item.variants.first %>
      <div class="bg-white rounded-xl overflow-hidden border border-gray-100 hover:shadow-lg transition-shadow group relative">
        <!-- Flash Badge -->
        <div class="absolute top-1.5 md:top-2 left-1.5 md:left-2 z-10 bg-red-600 text-white text-[8px] md:text-[10px] font-bold px-1.5 md:px-2 py-0.5 md:py-1 rounded animate-pulse">
          FLASH
        </div>
        
        <%= link_to item_path(item), class: "block" do %>
          <!-- Product Image -->
          <div class="relative h-[100px] sm:h-[120px] md:h-[140px] bg-gray-50 flex items-center justify-center overflow-hidden">
            <svg class="w-8 h-8 md:w-10 md:h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          
          <!-- Product Info -->
          <div class="p-2 md:p-3">
            <h3 class="text-[10px] md:text-xs font-medium text-gray-900 line-clamp-2 mb-1 md:mb-2 group-hover:text-[#551694] transition-colors min-h-[28px] md:min-h-[32px]">
              <%= item.name %>
            </h3>
            
            <!-- Price with old price -->
            <div class="flex flex-col">
              <span class="text-xs md:text-sm font-bold text-red-600">
                <% if variant %>
                  <%= number_to_currency(current_price_for(variant), unit: item.currency&.symbol || "FCFA", precision: 0) %>
                <% else %>
                  N/A
                <% end %>
              </span>
              <% if variant %>
                <% original_price = original_price_for(variant) %>
                <% current_price = current_price_for(variant) %>
                <% if original_price > current_price %>
                  <span class="text-[8px] md:text-xs text-gray-400 line-through">
                    <%= number_to_currency(original_price, unit: "", precision: 0) %> <%= item.currency&.symbol || "FCFA" %>
                  </span>
                <% end %>
              <% end %>
            </div>
            
            <!-- Progress bar (fake sold percentage) -->
            <div class="mt-1.5 md:mt-2">
              <div class="h-1 md:h-1.5 bg-gray-200 rounded-full overflow-hidden">
                <div class="h-full bg-red-500 rounded-full" style="width: <%= rand(40..90) %>%"></div>
              </div>
              <span class="text-[8px] md:text-[10px] text-gray-500 mt-0.5 md:mt-1 block">Vendu à <%= rand(40..90) %>%</span>
            </div>
            
            <!-- Bouton Ajouter au panier -->
            <%= render "shared/add_to_cart_button", item: item, variant: variant, size: "sm", style: "outline", show_icon: false %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- See All Link -->
  <div class="text-center mt-4 md:mt-6">
    <%= link_to items_path, class: "inline-flex items-center gap-2 bg-red-600 text-white font-semibold text-xs md:text-sm px-4 md:px-6 py-2 md:py-3 rounded-full hover:bg-red-700 transition-colors" do %>
      Voir toutes les ventes flash
      <svg class="w-3 h-3 md:w-4 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    <% end %>
  </div>
</div>
