# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (front-end URLs).
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaxtrack?schema=public

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- Seeding (idempotent) ---
# When true the server seeds the EPI schedule + admin account on boot.
SEED_ON_START=false
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@vaxtrack.sn
ADMIN_PASSWORD=ChangeMe!2026

# --- Reminders ---
# console = log SMS to stdout (default). Plug a real provider in src/modules/reminders/notifier.ts
SMS_PROVIDER=console
REMINDER_WINDOW_DAYS=3

# --- Static front-end (single-service deployment) ---
# Path to the built React app; leave empty to serve the API only.
WEB_DIST_DIR=../web/dist
