<div id="<%= dom_id medium %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Filename:</strong>
    <%= medium.filename %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Original name:</strong>
    <%= medium.original_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">File path:</strong>
    <%= medium.file_path %>
  </div>
  <div>
    <strong class="block font-medium mb-1">File type:</strong>
    <%= medium.file_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">File size:</strong>
    <%= medium.file_size %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Mime type:</strong>
    <%= medium.mime_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Uploaded by:</strong>
    <%= medium.uploaded_by_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Alt text:</strong>
    <%= medium.alt_text %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Caption:</strong>
    <%= medium.caption %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Width:</strong>
    <%= medium.width %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Height:</strong>
    <%= medium.height %>
  </div>
</div>
