<%# Carte produit selon le design Figma %>
<% variant = item.default_variant || item.variants.first %>
<% if variant %>

<%# Calculer le pourcentage de réduction réel %>
<% discount_percent = discount_percentage_for(variant) %>
<% original_price = original_price_for(variant) %>
<% current_price = current_price_for(variant) %>

<article class="border border-[#e5e7eb] rounded-[20px] h-auto relative bg-white overflow-hidden group hover:shadow-lg transition-shadow"
         data-item-id="<%= item.id %>"
         data-item="true">
  
      <%= link_to item_path(item), class: "block h-full flex flex-col" do %>
    <!-- Image produit -->
    <div class="relative bg-[#e3e3ec] h-[150px] sm:h-[224px] flex items-center justify-center overflow-hidden rounded-t-[20px]">
      <% if item.has_image? %>
        <% display_img = item.display_image %>
        <%= storage_image_tag(display_img,
            variant_name: :card,
            alt: item.name,
            class: "w-full h-full object-cover",
            width: 400,
            height: 400, disable_lazy: true) %>
      <% else %>
        <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      <% end %>

      <!-- Badge de réduction -->
      <% if discount_percent > 0 %>
        <div class="absolute top-[23px] left-[14px] bg-[#dc2626] h-[24px] rounded-bl-[14px] rounded-br-[40px] rounded-tl-[14px] rounded-tr-[40px] px-2 flex items-center justify-center">
          <span class="text-[#fef2f2] text-[10px] font-extrabold uppercase tracking-[-0.32px]">
            <%= discount_percent %>%
          </span>
        </div>
      <% end %>

    </div>

    <!-- Informations produit -->
    <div class="flex-1 flex flex-col p-2 sm:p-[14px]">
      <!-- Nom du produit -->
      <h3 class="text-xs sm:text-[14px] font-medium text-[#030712] leading-snug tracking-[-0.28px] line-clamp-2 mb-1.5 sm:mb-2 group-hover:text-[#551694] transition-colors">
        <%= item.name %>
      </h3>

      <!-- Note et nombre d'avis -->
      <% if item.average_rating.present? %>
        <% rounded_rating = item.average_rating.round %>
        <div class="flex items-center gap-1 mb-2" role="img" aria-label="<%= t('storefront.products.rating', rating: rounded_rating) %>">
          <div class="flex items-center" aria-hidden="true">
            <% 5.times do |i| %>
              <svg class="w-[11px] h-[11px] <%= i < rounded_rating ? 'text-yellow-400 fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            <% end %>
          </div>
          <span class="text-[12px] text-[#6b7280] tracking-[-0.32px]"><%= item.average_rating.round(1) %></span>
        </div>
      <% end %>

      <!-- Prix -->
      <div class="flex flex-wrap items-end gap-1 sm:gap-[11px] mb-2 sm:mb-3">
        <span class="text-base sm:text-[22px] font-bold text-[#dc2626] leading-none tracking-[-0.44px]">
          <%= number_to_currency(current_price, unit: "", precision: 0, delimiter: ".", separator: ",") %> F
        </span>
        <% if discount_percent > 0 && original_price > current_price %>
          <span class="text-xs sm:text-[16.1px] font-medium text-[#111827] line-through leading-none tracking-[-0.44px]">
            <%= number_to_currency(original_price, unit: "", precision: 0, delimiter: ".", separator: ",") %> F
          </span>
        <% end %>
      </div>

      <!-- Bouton Ajouter au panier -->
      <% if variant.stock_quantity > 0 %>
        <div class="mt-auto">
          <%= render "shared/add_to_cart_button", item: item, variant: variant, size: "sm", style: "outline" %>
        </div>
      <% else %>
        <button disabled class="w-full border border-gray-300 h-[34px] rounded-full flex items-center justify-center text-gray-400 text-[13px] font-medium cursor-not-allowed">
          <%= t('storefront.products.out_of_stock', default: 'Rupture de stock') %>
        </button>
      <% end %>
    </div>
  <% end %>
</article>
<% end %>

