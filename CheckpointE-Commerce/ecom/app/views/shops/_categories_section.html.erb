<%# Explorer par catégories - Section améliorée avec images %>
<% primary_color = local_assigns[:primary_color] || "#551694" %>
<% secondary_color = local_assigns[:secondary_color] || "#7C3AED" %>
<% if sub_categories.any? %>
  <section id="categories" aria-labelledby="categories-heading">
    <div class="mb-6">
      <h2 id="categories-heading" class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
        Parcourir par catégories
      </h2>
      <p class="text-sm text-gray-600">Trouvez rapidement ce que vous cherchez grâce à nos collections organisées</p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <% sub_categories.each do |sub_category| %>
        <%= link_to category_path(sub_category.product_category), class: "group" do %>
          <div class="bg-white rounded-xl overflow-hidden hover:shadow-lg transition-all" style="border: 2px solid <%= primary_color %>15;">
            <%# Image de catégorie %>
            <div class="relative h-32 md:h-40 bg-gray-100 overflow-hidden">
              <% if sub_category.respond_to?(:icon) && sub_category.icon.attached? %>
                <%= storage_image_tag(sub_category.icon, variant_name: :icon, alt: sub_category.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-300", width: 100, height: 100) %>
              <% elsif sub_category.product_category.respond_to?(:icon) && sub_category.product_category.icon.attached? %>
                <%= storage_image_tag(sub_category.product_category.icon, variant_name: :icon, alt: sub_category.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-300", width: 100, height: 100) %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, <%= primary_color %>20, <%= secondary_color %>20);">
                  <svg class="w-12 h-12" style="color: <%= primary_color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </div>
              <% end %>
            </div>
            
            <div class="p-4 text-center">
              <h3 class="font-medium text-gray-900 text-sm mb-2 group-hover:opacity-80 transition-colors" style="--hover-color: <%= primary_color %>;" onmouseover="this.style.color='<%= primary_color %>'" onmouseout="this.style.color=''">
                <%= sub_category.name %>
              </h3>
              <button class="text-xs text-gray-600 inline-flex items-center gap-1 transition-colors group-hover:text-gray-900" style="--hover-color: <%= primary_color %>;" onmouseover="this.style.color='<%= primary_color %>'" onmouseout="this.style.color=''">
                Explorer les produits
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% else %>
  <%# Placeholder si pas de catégories %>
  <section id="categories" class="py-8 text-center">
    <p class="text-gray-500">Aucune catégorie disponible</p>
  </section>
<% end %>
