# Copy this file to .env and fill in real values. NEVER commit the .env.
# Once deployed on Azure, set the same keys in App Service -> Configuration.

# Server
NODE_ENV=development
PORT=3000

# MongoDB — local Docker OR MongoDB Atlas (paste your NEW rotated URI here).
MONGO_URI="mongodb://127.0.0.1:27017/mern_users"

# In dev, allow the Vite dev server (5173) to call the API cross-origin.
# In production the API and the static assets share the same origin so
# this can be left empty.
CORS_ORIGIN="http://localhost:5173"
