<% content_for :title, t("pages.contact.meta.title", default: "Contact | aa") %>
<% content_for :meta_description, t("pages.contact.meta.description", default: "Une question ? L'équipe aa vous accompagne au quotidien. Contactez-nous par téléphone, mail ou via le formulaire.") %>
<% content_for :canonical_url, request.original_url.split("?").first %>
<% content_for :structured_data do %>
  <%= combined_json_ld_tag(
    simple_page_schema(
      type: "ContactPage",
      name: t("pages.contact.meta.title", default: "Contact | aa"),
      description: t("pages.contact.meta.description", default: "Contactez l'équipe aa."),
      url: contact_url
    ),
    breadcrumb_schema([
      [ t("breadcrumbs.home", default: "Accueil"), root_url ],
      [ t("pages.contact.breadcrumb", default: "Contact"), contact_url ]
    ])
  ) %>
<% end %>
<%# ===== HERO ===== %>
<section class="relative bg-[#551694] text-white overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_#FFC700_0%,_transparent_60%)] pointer-events-none"></div>
  <div class="container mx-auto px-4 lg:px-[50px] py-14 md:py-20 relative">
    <div class="text-center">
      <h1 class="text-3xl md:text-5xl font-bold leading-tight">
        <%= t("pages.contact.hero.title_part_1", default: "Contactez") %>
        <span class="text-[#FFC700]"><%= t("pages.contact.hero.title_highlight", default: "nous.") %></span>
      </h1>
      <p class="mt-4 text-white/85 text-base md:text-lg max-w-2xl mx-auto">
        <%= t("pages.contact.hero.subtitle", default: "Notre équipe vous répond du lundi au samedi, de 9h à 18h.") %>
      </p>
    </div>
  </div>
</section>
<%# ===== INFO + FORMULAIRE ===== %>
<section class="bg-[#F5F3FB] py-12 md:py-16">
  <div class="container mx-auto px-4 lg:px-[50px]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-6xl mx-auto">
      <%# Colonne gauche : infos %>
      <aside class="lg:col-span-5 bg-white rounded-2xl p-6 md:p-8 shadow-sm">
        <h2 class="text-xl font-semibold text-[#201A40] mb-2">
          <%= t("pages.contact.info.title", default: "Une question ou besoin d'aide ?") %>
        </h2>
        <p class="text-sm text-[#6B7280] mb-6">
          <%= t("pages.contact.info.subtitle", default: "Plusieurs canaux pour nous joindre, choisissez celui qui vous arrange.") %>
        </p>
        <ul class="space-y-5">
          <%# Adresse %>
          <li class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#EEEAF8] flex items-center justify-center">
              <svg class="w-5 h-5 text-[#551694]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2c-3.87 0-7 3.13-7 7 0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-[#551694] font-semibold mb-1">
                <%= t("pages.contact.info.address_label", default: "Adresse") %>
              </p>
              <p class="text-sm text-[#3F4254]">
                Quartier Ouakam, Mamelles, Lot 752,<br>
                Cité El Hadj Malick SY, Dakar
              </p>
            </div>
          </li>
          <%# Téléphone %>
          <li class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#EEEAF8] flex items-center justify-center">
              <svg class="w-5 h-5 text-[#551694]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.58l2.2-2.21a1 1 0 0 0 .25-1.02A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-[#551694] font-semibold mb-1">
                <%= t("pages.contact.info.phone_label", default: "Numéro de téléphone") %>
              </p>
              <a href="tel:+221778818383" class="block text-sm text-[#3F4254] hover:text-[#551694]">+221 77 881 83 83</a>
              <a href="tel:+221338818383" class="block text-sm text-[#3F4254] hover:text-[#551694]">+221 33 881 83 83</a>
            </div>
          </li>
          <%# E-mail %>
          <li class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#EEEAF8] flex items-center justify-center">
              <svg class="w-5 h-5 text-[#551694]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-[#551694] font-semibold mb-1">
                <%= t("pages.contact.info.email_label", default: "E-mail") %>
              </p>
              <a href="mailto:contact@aa.com" class="text-sm text-[#3F4254] hover:text-[#551694]">contact@aa.com</a>
            </div>
          </li>
        </ul>
        <div class="mt-8 pt-6 border-t border-[#EBEEF6]">
          <p class="text-xs text-[#6B7280] mb-3 uppercase tracking-wider"><%= t("pages.contact.info.follow_us", default: "Suivez-nous") %></p>
          <div class="flex items-center gap-3">
            <% [
              { label: "Twitter / X", path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" },
              { label: "Facebook",   path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" },
              { label: "Instagram",  path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" },
              { label: "YouTube",    path: "M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" }
            ].each do |s| %>
              <%= link_to coming_soon_path,
                  class: "w-9 h-9 rounded-full bg-[#551694] flex items-center justify-center hover:bg-[#451384] transition-colors",
                  "aria-label": s[:label] do %>
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="<%= s[:path] %>"/>
                </svg>
              <% end %>
            <% end %>
          </div>
                  </div>
                </aside>
                <%# Colonne droite : formulaire %>
                <div class="lg:col-span-7 bg-white rounded-2xl p-6 md:p-8 shadow-sm">
                  <h2 class="text-xl font-semibold text-[#201A40] mb-1">
                    <%= t("pages.contact.form.title", default: "Envoyez-nous un message") %>
                  </h2>
                  <p class="text-sm text-[#6B7280] mb-6">
                    <%= t("pages.contact.form.subtitle", default: "Nous répondons généralement sous 24h.") %>
                  </p>
                  <%= render "shared/form_errors", object: @contact_message %>
                  <%= form_with model: @contact_message, url: contact_create_path, local: true, class: "space-y-4" do |f| %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <%= f.label :first_name, t("pages.contact.form.first_name", default: "Prénom"),
                  class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                        <%= f.text_field :first_name,
                  required: true,
                  class: "w-full h-11 rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent" %>
                      </div>
                      <div>
                        <%= f.label :last_name, t("pages.contact.form.last_name", default: "Nom"),
                  class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                        <%= f.text_field :last_name,
                  class: "w-full h-11 rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent" %>
                      </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <%= f.label :email, t("pages.contact.form.email", default: "E-mail"),
                  class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                        <%= f.email_field :email,
                  class: "w-full h-11 rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent" %>
                      </div>
                      <div>
                        <%= f.label :phone, t("pages.contact.form.phone", default: "Téléphone"),
                  class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                        <%= f.telephone_field :phone,
                  class: "w-full h-11 rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent" %>
                      </div>
                    </div>
                    <div>
                      <%= f.label :subject, t("pages.contact.form.subject", default: "Sujet"),
                class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                      <%= f.text_field :subject,
                class: "w-full h-11 rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent" %>
                    </div>
                    <div>
                      <%= f.label :message, t("pages.contact.form.message", default: "Message"),
                class: "block text-xs font-medium text-[#3F4254] mb-1" %>
                      <%= f.text_area :message,
                rows: 6,
                required: true,
                class: "w-full rounded-lg border border-[#E4E7E9] bg-[#F9FAFB] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#551694] focus:border-transparent resize-none" %>
                    </div>
                    <p class="text-xs text-[#6B7280]">
                      <%= t("pages.contact.form.required_hint", default: "* Au moins un e-mail ou un téléphone est requis pour que nous puissions vous répondre.") %>
                    </p>
                    <div>
                      <%= f.button type: :submit,
                class: "w-full md:w-auto inline-flex items-center justify-center bg-[#551694] hover:bg-[#451384] text-white font-semibold px-8 py-3 rounded-full transition-colors" do %>
                        <%= t("pages.contact.form.submit", default: "Envoyer") %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </section>
          <%# ===== FAQ ===== %>
          <section class="bg-white py-12 md:py-16">
            <div class="container mx-auto px-4 lg:px-[50px]">
              <div class="max-w-4xl mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold text-[#201A40] mb-8 text-center">
                  <%= t("pages.contact.faq.title", default: "On répond à vos questions") %>
                </h2>
                <% faqs = [
        { q: t("pages.contact.faq.q1", default: "Comment commander sur aa ?"),
          a: t("pages.contact.faq.a1", default: "Parcourez les produits, ajoutez-les au panier puis passez commande en quelques clics. Vous serez livré directement.") },
        { q: t("pages.contact.faq.q2", default: "Comment se passe la livraison ?"),
          a: t("pages.contact.faq.a2", default: "Selon votre zone, la livraison se fait sous 24h à 72h en moyenne, partout au Sénégal.") },
        { q: t("pages.contact.faq.q3", default: "Quels sont les moyens de paiement disponibles ?"),
          a: t("pages.contact.faq.a3", default: "Wave, Orange Money, Free Money, carte bancaire ou paiement à la livraison selon la boutique.") },
        { q: t("pages.contact.faq.q4", default: "Les vendeurs sont-ils vérifiés ?"),
          a: t("pages.contact.faq.a4", default: "Oui, chaque boutique passe par un processus de vérification avant d'être publiée.") }
      ] %>
                <div class="space-y-3" data-controller="accordion">
                  <% faqs.each_with_index do |faq, idx| %>
                    <details class="group bg-white border border-[#EBEEF6] rounded-2xl px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
                      <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                        <h3 class="text-base font-semibold text-[#551694]"><%= faq[:q] %></h3>
                        <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#551694] text-white flex items-center justify-center transition-transform group-open:rotate-45">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/>
                          </svg>
                        </span>
                      </summary>
                      <p class="mt-3 text-sm text-[#4B5675] leading-6"><%= faq[:a] %></p>
                    </details>
                  <% end %>
                </div>
              </div>
            </div>
          </section>
