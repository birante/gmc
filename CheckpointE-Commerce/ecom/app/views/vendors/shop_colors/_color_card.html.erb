<div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow <%= 'opacity-70' if color.archived? %>">
  <div class="h-24 w-full" style="background-color: <%= color.hex_code %>;"></div>
  <div class="p-3">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="text-sm font-medium text-gray-900 truncate" title="<%= color.name %>"><%= color.name %></p>
        <p class="text-xs text-gray-500 font-mono uppercase"><%= color.hex_code %></p>
      </div>
      <% if color.archived? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 flex-shrink-0">Archivée</span>
      <% end %>
    </div>

    <div class="flex items-center gap-2 mt-3">
      <% unless color.archived? %>
        <%= link_to "Éditer", url_with_shop(edit_vendors_color_path(color), @current_shop),
            class: "text-xs text-[#551694] hover:underline" %>

        <%= button_to archive_vendors_color_path(color, shop_slug: @current_shop.slug),
            method: :patch,
            data: { turbo_confirm: "Archiver « #{color.name} » ? Les produits existants qui l'utilisent restent inchangés." },
            class: "text-xs text-red-600 hover:underline bg-transparent border-0 p-0" do %>
          Archiver
        <% end %>
      <% else %>
        <%= button_to restore_vendors_color_path(color, shop_slug: @current_shop.slug),
            method: :patch,
            class: "text-xs text-[#551694] hover:underline bg-transparent border-0 p-0" do %>
          Restaurer
        <% end %>
      <% end %>
    </div>
  </div>
</div>
