<% content_for :title, "Sign in" %>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-8">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Welcome back</h1>
    <p class="text-sm text-slate-500 mb-6">Sign in to continue to EduCMS.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full px-3 py-2 rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-40 text-sm" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="inline-flex items-center gap-2 text-sm text-slate-600">
          <%= f.check_box :remember_me, class: "rounded" %> Remember me
        </label>
      <% end %>
      <div>
        <%= f.submit "Sign in", class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>

  <div class="mt-6 rounded-xl bg-white/60 border border-gray-200 p-4 text-xs text-slate-600">
    <div class="font-medium mb-1 text-slate-800">Try a seeded account (password: <code>password123</code>)</div>
    <ul class="space-y-1">
      <li><code>admin@educms.local</code> — full permissions</li>
      <li><code>editor@educms.local</code> — moderate + edit</li>
      <li><code>author@educms.local</code> — write own posts</li>
    </ul>
  </div>
</div>
