<%= form_with model: address, url: url, local: true, class: "space-y-6" do |form| %>
  <%= render "shared/form_errors", object: address if defined?(address.errors) %>

  <!-- Adresse complète -->
  <div>
    <%= form.label :street_address, t('.street_address'), class: "block text-sm font-semibold text-gray-900 mb-2" %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
      <%= form.text_area :street_address, rows: 3, required: true, class: "block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-[#551694] focus:border-[#551694] transition-colors", placeholder: t('.street_address_placeholder', default: 'Ex: Rue 10, Immeuble XYZ, Appartement 5') %>
    </div>
  </div>

  <!-- Ville et Code postal -->
  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <%= form.label :city, t('.city'), class: "block text-sm font-semibold text-gray-900 mb-2" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <%= form.text_field :city, required: true, class: "block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-[#551694] focus:border-[#551694] transition-colors", placeholder: "Ex: Dakar" %>
      </div>
    </div>

    <div>
      <%= form.label :postal_code, t('.postal_code'), class: "block text-sm font-semibold text-gray-900 mb-2" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <%= form.text_field :postal_code, class: "block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-[#551694] focus:border-[#551694] transition-colors", placeholder: "Ex: 12345" %>
      </div>
    </div>
  </div>

  <!-- Pays -->
  <div>
    <%= form.label :country, t('.country'), class: "block text-sm font-semibold text-gray-900 mb-2" %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <%= form.select :country, [["Sénégal", "SN"]], {}, class: "block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-[#551694] focus:border-[#551694] transition-colors bg-white" %>
    </div>
  </div>

  <!-- Adresse par défaut -->
  <div class="flex items-center p-4 bg-gray-50 rounded-lg border border-gray-200">
    <%= form.check_box :is_default, class: "h-5 w-5 text-[#551694] focus:ring-[#551694] border-gray-300 rounded cursor-pointer" %>
    <%= form.label :is_default, t('.is_default'), class: "ml-3 block text-sm font-medium text-gray-700 cursor-pointer" %>
  </div>

  <!-- Boutons d'action -->
  <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200">
    <%= link_to client_addresses_path, class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all duration-200 font-medium shadow-sm" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      <span><%= t('.cancel', default: 'Annuler') %></span>
    <% end %>
    <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#451384] transition-all duration-200 font-medium shadow-sm hover:shadow-md">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <span><%= t('.save', default: 'Enregistrer') %></span>
    </button>
  </div>
<% end %>
