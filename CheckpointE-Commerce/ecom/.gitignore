# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Node.js dependencies and files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
.npm
.yarn
.pnp
.pnp.js

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# IntelliJ IDEA specific files
.idea/
*.iml
*.iws
*.ipr
*.ids
*.orig

# Version managers
.tool-versions
.ruby-version.local
.node-version
.nvmrc.local

# Rails cache and temporary files
/tmp/cache/
/tmp/pids/
/tmp/sessions/
/tmp/sockets/

# Ignore local development scripts
start_local.sh
LOCAL_DEV.md
POSTGRES_CONNECTIONS.md

# Ignore sitemap.xml.gz
public/sitemap.xml.gz
/config/credentials/development.key

# Kamal secrets (CRITICAL - never commit!)
.kamal/secrets
.kamal/secrets-*
!.kamal/secrets-production-TEMPLATE
.kamal/*.backup

# Local secrets directory
.secrets/

# Docker tokens
.docker/*token*
