<%# Section produits - Contenu principal %>
<% primary_color = local_assigns[:primary_color] || "#551694" %>
<div aria-labelledby="products-heading" class="bg-white rounded-2xl p-3 sm:p-4 md:p-6 border" style="border-color: <%= primary_color %>15;">
  <div class="flex flex-col lg:flex-row gap-6">
    <%# Sidebar filters - masqué sur mobile, bouton pour ouvrir %>
    <aside class="hidden lg:block lg:w-72 flex-shrink-0">
      <div class="lg:sticky lg:top-24 rounded-xl p-4 bg-gray-50/80" style="border: 1px solid <%= primary_color %>20;">
        <h2 class="text-sm font-semibold mb-3" style="color: var(--primary-color);">Filtres</h2>
        <%= render "shops/filters" %>
      </div>
    </aside>

    <!-- Contenu principal -->
    <div class="flex-1 min-w-0">
      <%# Barre: Titre + Tri + Bouton filtres mobile %>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div>
          <h2 id="products-heading" class="text-xl md:text-2xl font-bold" style="color: var(--primary-color);">
            <%= t('shops.products_title', default: 'Tous les produits') %>
          </h2>
          <% total_items_count = items.respond_to?(:total_count) ? items.total_count : items.size %>
          <p class="text-gray-500 text-sm mt-0.5"><%= total_items_count %> article<%= total_items_count > 1 ? 's' : '' %></p>
        </div>
        <div class="flex items-center gap-3">
          <label for="sort" class="text-sm text-gray-600">Trier:</label>
          <%= form_with url: shop_path(@shop.slug), method: :get, local: true, class: "inline-block" do |form| %>
            <%= form.hidden_field :min_price, value: params[:min_price] if params[:min_price].present? %>
            <%= form.hidden_field :max_price, value: params[:max_price] if params[:max_price].present? %>
            <%= form.select :sort,
                options_for_select([
                  ["Les plus pertinents", "relevance"],
                  ["Prix croissant", "price_asc"],
                  ["Prix décroissant", "price_desc"],
                  ["Nouveautés", "newest"],
                  ["Meilleures ventes", "bestsellers"]
                ], params[:sort] || "relevance"),
                {},
                { id: "sort", class: "rounded-lg text-sm py-2 px-3 border bg-white", style: "border-color: #{primary_color}30;", onchange: "this.form.submit()" } %>
          <% end %>
        </div>
      </div>

      <!-- Turbo Frame pour les produits -->
      <turbo-frame id="products-grid">
        <% if items.any? %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-2.5 sm:gap-3 md:gap-4 lg:gap-5">
      <% items.each do |item| %>
        <% variant = item.default_variant || item.variants.first %>
        <% next unless variant %>
        
        <%# Calculer le pourcentage de réduction réel %>
        <% discount_percent = item.on_sale? ? variant.discount_percentage : 0 %>
        <% original_price = variant.original_price %>
        <% current_price = variant.current_price %>

        <article class="border border-[#e5e7eb] rounded-2xl md:rounded-[20px] relative bg-white overflow-hidden group hover:shadow-lg transition-shadow flex flex-col"
                 data-item-id="<%= item.id %>"
                 data-item="true"
                 data-product-subcategory-id="<%= item.product_sub_category_id %>">
          <%# Lien produit uniquement sur visuel + infos (pas de formulaire dans <a> — évite Turbo « Content missing ») %>
          <%= link_to item_path(item), class: "block flex flex-col flex-1 min-h-0", data: { turbo_frame: "_top" } do %>
            <!-- Image produit -->
            <div class="relative bg-[rgba(236,239,241,0.8)] aspect-square sm:aspect-[4/5] md:aspect-square flex items-center justify-center overflow-hidden rounded-t-2xl md:rounded-t-[20px]">
              <% if item.has_image? %>
                <%= storage_image_tag(item.display_image,
                    variant_name: :card,
                    alt: item.name,
                    class: "w-full h-full object-contain p-3",
                    width: 400,
                    height: 400) %>
              <% else %>
                <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              <% end %>

              <!-- Badge de réduction -->
              <% if discount_percent > 0 %>
                <div class="absolute top-1.5 right-1.5 md:top-2 md:right-2 bg-[#dc2626] h-[22px] md:h-[24px] rounded-bl-[14px] rounded-br-[40px] rounded-tl-[14px] rounded-tr-[40px] px-2 flex items-center justify-center">
                  <span class="text-[#fef2f2] text-[10px] font-extrabold uppercase tracking-[-0.32px]">
                    <%= discount_percent %>%
                  </span>
                </div>
              <% end %>

            </div>

            <!-- Informations produit -->
            <div class="flex-1 flex flex-col p-2.5 md:p-3">
              <!-- Nom du produit -->
              <h3 class="text-[13px] sm:text-[14px] md:text-[15px] font-medium text-[#030712] leading-[18px] md:leading-[20px] tracking-[-0.28px] line-clamp-2 mb-1.5 md:mb-2 min-h-[32px] md:min-h-[36px] transition-colors" style="--accent: var(--primary-color);" onmouseover="this.style.color=getComputedStyle(this).getPropertyValue('--accent')" onmouseout="this.style.color='#030712'">
                <%= item.name %>
              </h3>

              <!-- Note et nombre d'avis -->
              <% if item.average_rating.present? %>
                <% rounded_rating = item.average_rating.round %>
                <div class="flex items-center gap-1 mb-1.5 md:mb-2" role="img" aria-label="<%= t('storefront.products.rating', rating: rounded_rating) %>">
                  <div class="flex items-center" aria-hidden="true">
                    <% 5.times do |i| %>
                      <svg class="w-[10px] h-[10px] md:w-[11px] md:h-[11px] <%= i < rounded_rating ? 'text-yellow-400 fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    <% end %>
                  </div>
                  <span class="text-[11px] md:text-[12px] text-[#6b7280] tracking-[-0.32px]"><%= item.average_rating.round(1) %></span>
                </div>
              <% end %>

              <!-- Prix -->
              <div class="flex items-end flex-wrap gap-x-2 gap-y-0.5 mb-1">
                <span class="text-[17px] sm:text-[19px] md:text-[22px] lg:text-[24px] font-bold leading-tight tracking-[-0.44px]" style="color: var(--primary-color);">
                  <%= number_to_currency(current_price, unit: "", precision: 0, delimiter: ".", separator: ",") %> F
                </span>
                <% if discount_percent > 0 && original_price > current_price %>
                  <span class="text-[12px] sm:text-[13px] md:text-[14px] lg:text-[15px] font-medium text-[#111827] line-through leading-tight tracking-[-0.44px]">
                    <%= number_to_currency(original_price, unit: "", precision: 0, delimiter: ".", separator: ",") %> F
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="px-2.5 md:px-3 pb-2.5 md:pb-3 pt-0 mt-auto">
            <%= render "shared/add_to_cart_button", item: item, variant: variant, size: "sm", style: "outline", full_width: true %>
          </div>
        </article>
      <% end %>
        </div>

        <%# Pagination %>
        <% if items.respond_to?(:total_pages) && items.total_pages > 1 %>
          <nav class="mt-4 flex justify-center" aria-label="<%= t('pagination.label', default: 'Pagination') %>">
            <%= paginate items %>
          </nav>
        <% end %>
      <% else %>
        <div class="text-center py-12 bg-white rounded-xl" style="border: 2px solid <%= primary_color %>15;">
          <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
          <p class="text-gray-500 text-lg"><%= t('shops.no_products', default: 'Aucun produit disponible pour le moment') %></p>
        </div>
      <% end %>
      </turbo-frame>
    </div>
  </div>
</div>
