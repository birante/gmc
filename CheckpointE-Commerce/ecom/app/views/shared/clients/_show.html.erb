<%# Partial partagé : détail client (vendor + employees).
     Locals attendus :
       back_to_clients_path  String   URL de retour à la liste clients
       order_path_for        Proc     ->(order) URL d'affichage d'une commande
     Instance vars : @vendor, @client, @orders, @client_total_orders, @client_total_spent,
                     @first_order_date, @last_order_date %>

<% if @vendor && @client %>
  <!-- En-tête avec bouton retour -->
  <div class="mb-6">
    <%= link_to back_to_clients_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-[#551694] mb-3" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <%= t('vendors.clients.show.back_to_clients') %>
    <% end %>

    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
          <%= @client.first_name %> <%= @client.last_name %>
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          <%= t('vendors.clients.show.client_since', date: @first_order_date.strftime("%d/%m/%Y")) if @first_order_date %>
        </p>
      </div>
    </div>
  </div>

  <!-- Détails du client -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Colonne principale : Historique des commandes -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Informations client -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('vendors.clients.show.client_info') %></h2>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="h-16 w-16 bg-[#551694] rounded-full flex items-center justify-center text-white font-semibold text-xl">
              <%= @client.first_name&.first&.upcase || @client.last_name&.first&.upcase || 'C' %>
            </div>
            <div>
              <p class="font-medium text-gray-900">
                <%= @client.first_name %> <%= @client.last_name %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Historique des commandes -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
          <h2 class="text-lg font-semibold text-gray-900"><%= t('vendors.clients.show.orders_history') %></h2>
        </div>
        <div class="divide-y divide-gray-200">
          <% if @orders.any? %>
            <% @orders.each do |order| %>
              <%= link_to order_path_for.call(order), class: "block px-6 py-4 hover:bg-gray-50 transition-colors" do %>
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="font-medium text-gray-900"><%= t('vendors.clients.show.order_number', id: order.id) %></h3>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%=
                        case order.status
                        when 'pending'    then 'bg-yellow-100 text-yellow-800'
                        when 'processing' then 'bg-blue-100 text-blue-800'
                        when 'delivered'  then 'bg-green-100 text-green-800'
                        when 'canceled'   then 'bg-red-100 text-red-800'
                        else                   'bg-gray-100 text-gray-800'
                        end %>">
                        <%= order.status.humanize %>
                      </span>
                    </div>
                    <p class="text-sm text-gray-500">
                      <%= order.created_at.strftime("%d/%m/%Y à %H:%M") %>
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="font-medium text-gray-900">
                      <%= number_with_delimiter(order.final_amount, delimiter: ' ') %> <%= order.currency.code %>
                    </p>
                    <% items_count = order.order_items.size %>
                    <p class="text-sm text-gray-500">
                      <%= items_count %> <%= items_count > 1 ? t('vendors.clients.show.items') : t('vendors.clients.show.item') %>
                    </p>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="px-6 py-8 text-center text-gray-500">
              <%= t('vendors.clients.show.no_orders') %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Colonne latérale : Statistiques -->
    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('vendors.clients.show.statistics') %></h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between pb-4 border-b">
            <span class="text-sm text-gray-600"><%= t('vendors.clients.show.total_orders') %></span>
            <span class="text-lg font-bold text-gray-900"><%= @client_total_orders %></span>
          </div>
          <div class="flex items-center justify-between pb-4 border-b">
            <span class="text-sm text-gray-600"><%= t('vendors.clients.show.total_amount') %></span>
            <span class="text-lg font-bold text-gray-900"><%= number_with_delimiter(@client_total_spent, delimiter: ' ') %> FCFA</span>
          </div>
          <div class="flex items-center justify-between pb-4 border-b">
            <span class="text-sm text-gray-600"><%= t('vendors.clients.show.average_cart') %></span>
            <span class="text-lg font-bold text-gray-900">
              <%= @client_total_orders > 0 ? number_with_delimiter((@client_total_spent / @client_total_orders).round, delimiter: ' ') : 0 %> FCFA
            </span>
          </div>
          <div>
            <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.show.first_order') %></p>
            <p class="text-sm font-medium text-gray-900">
              <%= @first_order_date ? @first_order_date.strftime("%d/%m/%Y") : 'N/A' %>
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 mb-2"><%= t('vendors.clients.show.last_order') %></p>
            <p class="text-sm font-medium text-gray-900">
              <%= @last_order_date ? @last_order_date.strftime("%d/%m/%Y") : 'N/A' %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

<% else %>
  <!-- État d'erreur -->
  <div class="text-center py-12">
    <p class="text-gray-500 mb-4"><%= t('vendors.clients.show.error_client_not_found') %></p>
    <%= link_to t('vendors.clients.show.back_to_clients_button'), back_to_clients_path, class: "inline-block px-6 py-3 bg-[#551694] text-white rounded-md hover:bg-[#451384] transition-colors" %>
  </div>
<% end %>
