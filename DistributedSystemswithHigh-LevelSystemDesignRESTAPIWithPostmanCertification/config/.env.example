# Copy this file to config/.env and set your MongoDB URI + port.
# The value MUST be quoted and have no spaces around the "=" sign.
#
# Note: on macOS, port 5000 is often taken by "AirPlay Receiver".
# Change System Settings → General → AirDrop & Handoff to free it,
# or just pick another port here (5300 works out of the box).
PORT=5300
MONGO_URI="mongodb://127.0.0.1:27017/users_api"
