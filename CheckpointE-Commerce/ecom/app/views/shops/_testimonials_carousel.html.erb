<%# Témoignages Carrousel - Section social proof améliorée %>
<div class="py-6 md:py-8 -mx-4 lg:-mx-[50px] px-4 lg:px-[50px] bg-white">
  <div class="container mx-auto max-w-6xl">
    <%# En-tête avec icône %>
    <div class="text-center mb-5">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full mb-3 mx-auto" style="background-color: <%= primary_color %>15;">
        <svg class="w-6 h-6" style="color: <%= primary_color %>;" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Ce que disent nos clients</h2>
      <p class="text-base text-gray-600 max-w-2xl mx-auto">Des milliers de clients satisfaits font confiance à nous pour leurs achats</p>
    </div>

    <%# Carrousel de témoignages %>
    <div class="relative" data-testimonials-carousel>
      <%# Slide de témoignages (3 colonnes) %>
      <div class="carousel-wrapper overflow-hidden">
        <div class="carousel-track transition-transform duration-500 ease-out flex" style="transform: translateX(0);">
          <%# Ensemble de 3 témoignages par slide %>
          <% testimonials = [
            { 
              name: "Sarah Diop", 
              role: "Cliente fidèle", 
              avatar: "👩‍💼",
              rating: 5, 
              text: "Service exceptionnelle et livraison rapide ! Les produits sont exactement comme décrits. Je recommande vivement cette boutique à tous mes amis." 
            },
            { 
              name: "Mamadou Kant", 
              role: "Client régulier", 
              avatar: "👨‍💼",
              rating: 5, 
              text: "Qualité premium à un prix raisonnable. L'équipe est très professionnelle et toujours prête à aider. Merci pour cette belle expérience !" 
            },
            { 
              name: "Aïssatou Ndiaye", 
              role: "Nouvelle cliente", 
              avatar: "👩",
              rating: 5, 
              text: "J'ai commandé pour la première fois et j'ai été impressionnée. Produits de qualité, emballage soigné et support client réactif." 
            },
            { 
              name: "Jean Sarr", 
              role: "Cliente satisfaire", 
              avatar: "👨",
              rating: 5, 
              text: "Boutique incontournable ! Variété de produits, prix compétitifs et livraison express. Merci beaucoup !" 
            },
            { 
              name: "Fatou Ba", 
              role: "Cliente vérifiée", 
              avatar: "👩‍🦰",
              rating: 4, 
              text: "Bonne expérience globale. Les produits sont de qualité et la livraison était rapide. Légèrement déçue par l'emballage." 
            },
            { 
              name: "Ousmane Faye", 
              role: "Client de longue date", 
              avatar: "👨‍🦱",
              rating: 5, 
              text: "Plus de 20 commandes passées et 0 problème ! Cette boutique mérite une note parfaite. Service impeccable !" 
            }
          ] %>

          <% (testimonials + testimonials.rotate(3)).each_with_index do |testimonial, index| %>
            <div class="testimonial-slide flex-shrink-0 w-full carousel-slide-item" style="flex-basis: 33.333%;">
              <div class="px-2 h-full">
                <div class="bg-white rounded-xl p-4 shadow-md hover:shadow-xl transition-all h-full border-l-4" 
                     style="border-left-color: <%= primary_color %>;">
                  <%# En-tête avec avatar et note %>
                  <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center text-2xl" style="background: linear-gradient(135deg, <%= primary_color %>20, <%= secondary_color %>20);">
                      <%= testimonial[:avatar] %>
                    </div>
                    <div class="flex-1">
                      <h4 class="font-bold text-gray-900"><%= testimonial[:name] %></h4>
                      <p class="text-sm text-gray-600"><%= testimonial[:role] %></p>
                    </div>
                  </div>

                  <%# Étoiles de notation %>
                  <div class="flex gap-1 mb-2">
                    <% testimonial[:rating].times do %>
                      <svg class="w-5 h-5" style="color: <%= primary_color %>;" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    <% end %>
                  </div>

                  <%# Texte du témoignage %>
                  <p class="text-gray-700 leading-relaxed text-sm italic">
                    "<%= testimonial[:text] %>"
                  </p>

                  <%# Séparateur %>
                  <div class="mt-3 pt-3 border-t" style="border-color: <%= primary_color %>15;">
                    <p class="text-xs text-gray-500">✓ Achat vérifié</p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Navigation carousel %>
      <button class="testimonial-prev absolute -left-6 lg:-left-12 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-full p-3 shadow-lg hover:shadow-xl transition-all" aria-label="Témoignages précédents">
        <svg class="w-6 h-6" style="color: <%= primary_color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button class="testimonial-next absolute -right-6 lg:-right-12 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-full p-3 shadow-lg hover:shadow-xl transition-all" aria-label="Témoignages suivants">
        <svg class="w-6 h-6" style="color: <%= primary_color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <%# Indicateurs de position %>
      <div class="flex justify-center gap-2 mt-5">
        <% (testimonials.length / 3).ceil.times do |i| %>
          <button class="testimonial-indicator w-3 h-3 rounded-full transition-all cursor-pointer" 
                  data-slide="<%= i %>"
                  style="background-color: <%= i == 0 ? primary_color : primary_color + '40' %>; width: <%= i == 0 ? '32px' : '12px' %>;"
                  aria-label="Aller aux témoignages <%= i + 1 %>">
          </button>
        <% end %>
      </div>
    </div>

    <%# Call-to-action footer %>
    <div class="mt-6 text-center">
      <div class="inline-flex items-center gap-3 px-4 py-3 rounded-lg" style="background-color: <%= primary_color %>10; border: 2px solid <%= primary_color %>30;">
        <span class="text-2xl">⭐</span>
        <div class="text-left">
          <p class="font-semibold text-gray-900">4.8 / 5 étoiles</p>
          <p class="text-sm text-gray-600">Basé sur 2,847 avis vérifiés</p>
        </div>
      </div>
    </div>
  </div>

  <%# Contrôleur du carrousel testimonial %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const carousel = document.querySelector('[data-testimonials-carousel]');
      if (!carousel) return;

      const track = carousel.querySelector('.carousel-track');
      const indicators = carousel.querySelectorAll('.testimonial-indicator');
      const prevBtn = carousel.querySelector('.testimonial-prev');
      const nextBtn = carousel.querySelector('.testimonial-next');
      const slides = document.querySelectorAll('.carousel-slide-item');
      
      let currentPosition = 0;
      const itemsPerSlide = 3;
      const totalSlides = Math.ceil(slides.length / itemsPerSlide);

      function updateCarousel() {
        const translateValue = -(currentPosition * 100) / itemsPerSlide;
        track.style.transform = `translateX(${translateValue}%)`;

        indicators.forEach((indicator, index) => {
          if (index === currentPosition) {
            indicator.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--primary-color') || '<%= primary_color %>';
            indicator.style.width = '32px';
          } else {
            indicator.style.backgroundColor = 'rgba(0, 0, 0, 0.25)';
            indicator.style.width = '12px';
          }
        });
      }

      function nextSlide() {
        currentPosition = (currentPosition + 1) % totalSlides;
        updateCarousel();
      }

      function prevSlide() {
        currentPosition = (currentPosition - 1 + totalSlides) % totalSlides;
        updateCarousel();
      }

      prevBtn?.addEventListener('click', prevSlide);
      nextBtn?.addEventListener('click', nextSlide);
      
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          currentPosition = index;
          updateCarousel();
        });
      });

      updateCarousel();
    });
  </script>
</div>
