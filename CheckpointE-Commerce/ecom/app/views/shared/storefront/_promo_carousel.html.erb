<%# Promo Carousel - Produits en promotion avec countdown %>
<%
  # Utiliser les produits passés ou charger des produits disponibles
  promo_items = local_assigns[:promo_items] || Item.available_for_sale.includes(:variants, :currency, :shop).limit(8)
  
  # Date de fin de la promo (par défaut: fin de semaine)
  end_date = local_assigns[:end_date] || (Time.current.end_of_week + 1.day).iso8601
%>

<div class="container mx-auto px-4 lg:px-[50px] py-6 md:py-8">
  <!-- Header with Countdown -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 md:gap-4 mb-4 md:mb-6">
    <div>
      <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
        Les promos 🔥 <span class="text-[#551694]">Économisez gros</span>
      </h2>
    </div>
    
    <!-- Countdown Timer -->
    <div class="flex items-center gap-2" data-controller="countdown" data-countdown-end-date-value="<%= end_date %>">
      <span class="text-xs md:text-sm text-gray-600 mr-1 md:mr-2">Se termine dans:</span>
      <div class="flex items-center gap-0.5 md:gap-1">
        <div class="bg-gray-900 text-white px-1.5 md:px-2 py-0.5 md:py-1 rounded text-xs md:text-sm font-mono font-bold min-w-[24px] md:min-w-[32px] text-center" data-countdown-target="days">00</div>
        <span class="text-gray-400 text-xs">:</span>
        <div class="bg-gray-900 text-white px-1.5 md:px-2 py-0.5 md:py-1 rounded text-xs md:text-sm font-mono font-bold min-w-[24px] md:min-w-[32px] text-center" data-countdown-target="hours">00</div>
        <span class="text-gray-400 text-xs">:</span>
        <div class="bg-gray-900 text-white px-1.5 md:px-2 py-0.5 md:py-1 rounded text-xs md:text-sm font-mono font-bold min-w-[24px] md:min-w-[32px] text-center" data-countdown-target="minutes">00</div>
        <span class="text-gray-400 text-xs">:</span>
        <div class="bg-gray-900 text-white px-1.5 md:px-2 py-0.5 md:py-1 rounded text-xs md:text-sm font-mono font-bold min-w-[24px] md:min-w-[32px] text-center" data-countdown-target="seconds">00</div>
      </div>
    </div>
  </div>

  <!-- Products Carousel -->
  <div class="relative" data-controller="horizontal-scroll">
        <div data-horizontal-scroll-target="scrollable" 
          class="flex gap-3 md:gap-4 overflow-x-auto pb-4 px-6 md:px-8 scrollbar-hide" 
         style="scrollbar-width: none; -ms-overflow-style: none;">
      <% promo_items.each do |item| %>
        <% variant = item.variants.first %>
        <div class="flex-shrink-0 w-[160px] sm:w-[200px] md:w-[242px]">
          <%= link_to item_path(item), class: "block bg-white rounded-xl overflow-hidden border border-gray-100 hover:shadow-lg transition-shadow group" do %>
            <!-- Product Image -->
            <div class="relative h-[120px] sm:h-[150px] md:h-[180px] bg-gray-50 flex items-center justify-center overflow-hidden">
              <% if item.has_image? %>
                <%= storage_image_tag(item.display_image,
                    variant_name: :card,
                    alt: item.name,
                    class: "w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-300",
                    width: 400,
                    height: 400) %>
              <% else %>
                <svg class="w-12 h-12 md:w-16 md:h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              <% end %>
              
              <!-- Discount Badge -->
              <div class="absolute top-2 md:top-3 left-2 md:left-3 bg-red-600 text-white text-[8px] md:text-[10px] font-bold px-1.5 md:px-2 py-0.5 md:py-1 rounded">
                -15%
              </div>
            </div>
            
            <!-- Product Info -->
            <div class="p-3 md:p-4">
              <h3 class="text-xs md:text-sm font-medium text-gray-900 line-clamp-2 mb-1 md:mb-2 group-hover:text-[#551694] transition-colors">
                <%= item.name %>
              </h3>
              
              <!-- Price -->
              <div class="flex items-center gap-1 md:gap-2">
                <span class="text-sm md:text-lg font-bold text-[#551694]">
                  <% if variant %>
                    <%= number_to_currency(current_price_for(variant), unit: item.currency&.symbol || "FCFA", precision: 0) %>
                  <% else %>
                    N/A
                  <% end %>
                </span>
                <% if variant %>
                  <% original_price = original_price_for(variant) %>
                  <% current_price = current_price_for(variant) %>
                  <% if original_price > current_price %>
                    <span class="text-[10px] md:text-sm text-gray-400 line-through">
                      <%= number_to_currency(original_price, unit: "", precision: 0) %>
                    </span>
                  <% end %>
                <% end %>
              </div>
              
              <!-- Shop name -->
              <% if item.shop.present? %>
                <div class="mt-1 md:mt-2 text-[10px] md:text-xs text-gray-500 truncate">
                  <%= item.shop.name %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Navigation Buttons (hidden on mobile) -->
    <button type="button"
            data-horizontal-scroll-target="leftButton"
            data-action="click->horizontal-scroll#scrollLeft"
            class="absolute -left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-[#551694] hover:shadow-xl transition-all z-10 hidden lg:flex">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button type="button"
            data-horizontal-scroll-target="rightButton"
            data-action="click->horizontal-scroll#scrollRight"
            class="absolute -right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-[#551694] hover:shadow-xl transition-all z-10 hidden lg:flex">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>

  <!-- See All Link -->
  <div class="text-center mt-4 md:mt-6">
    <%= link_to items_path, class: "inline-flex items-center gap-2 text-[#551694] font-semibold text-sm hover:underline" do %>
      Voir toutes les promos
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    <% end %>
  </div>
</div>
