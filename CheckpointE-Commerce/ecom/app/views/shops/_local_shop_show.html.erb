<%# Vue simplifiée pour les boutiques locales - Juste une vitrine de produits %>
<%# SEO Meta Tags %>
<% content_for :title, @page_title %>
<% content_for :meta_description, @page_description %>
<% content_for :canonical_url, shop_url(@shop) %>
<%# Couleurs aa pour les boutiques locales %>
<% 
  primary_color = "#551694"  # Couleur primaire aa
  secondary_color = "#7C3AED"  # Couleur secondaire aa
%>
<%# Structured Data %>
<% content_for :structured_data do %>
  <%= json_ld_tag(breadcrumb_schema([
    [t('breadcrumbs.home', default: 'Accueil'), root_url],
    [t('breadcrumbs.shops', default: 'Boutiques'), shops_url],
    [@shop.name, shop_url(@shop)]
  ])) %>
  <%= json_ld_tag(shop_schema(@shop)) %>
<% end %>
<div class="bg-gray-50 min-h-screen" style="--primary-color: <%= primary_color %>; --secondary-color: <%= secondary_color %>;">
  <%# Header simple pour boutique locale %>
  <header class="bg-white border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-[50px] py-6">
      <div class="flex items-center gap-4">
        <%# Logo %>
        <% if @shop.logo.attached? %>
          <div class="w-16 h-16 md:w-20 md:h-20 bg-white rounded-lg shadow-sm p-2 flex items-center justify-center border border-gray-200">
            <%= storage_image_tag(@shop.logo,
                variant_name: :logo_small,
                alt: "Logo #{@shop.name}",
                class: "max-w-full max-h-full object-contain",
                width: 80,
                height: 80) %>
          </div>
        <% else %>
          <div class="w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-[#551694] to-[#8B5CF6] rounded-lg flex items-center justify-center">
            <span class="text-2xl md:text-3xl font-bold text-white"><%= @shop.name.first.upcase %></span>
          </div>
        <% end %>
        <div>
          <h1 class="text-xl md:text-2xl font-bold text-gray-900">
            <%= @shop.name %>
          </h1>
          <p class="text-sm text-gray-600 mt-1">
            <%= pluralize(@available_items_count || @shop.items.available_for_sale.count, t('shops.product_available', default: 'produit disponible'), t('shops.products_available', default: 'produits disponibles')) %>
          </p>
        </div>
      </div>
    </div>
  </header>
  <%# Contenu principal - avec filtres et tri alignés sur les boutiques officielles %>
  <main class="bg-gray-50">
    <div class="container mx-auto px-4 lg:px-[50px] py-8">
      <section id="products">
        <%= render "products_section", items: @items %>
      </section>
    </div>
  </main>
</div>
