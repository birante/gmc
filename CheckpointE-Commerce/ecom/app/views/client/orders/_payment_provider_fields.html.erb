<% provider = payment_method.provider.to_s.downcase %>

<div class="space-y-4 sm:space-y-6">
  <% case provider %>
  <% when "paydunya" %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 sm:p-6">
      <h3 class="font-semibold text-blue-900 mb-3 text-base sm:text-lg">💳 Paiement en ligne sécurisé</h3>
      <p class="text-blue-700 mb-4 text-sm sm:text-base">
        Après avoir cliqué sur "Valider et payer", vous serez redirigé vers notre page de paiement sécurisée.
      </p>
      
      <!-- Sélection du mode de retrait -->
      <div class="bg-white rounded-lg p-4 mb-4">
        <label for="withdraw_mode" class="block text-sm font-medium text-gray-900 mb-2">
          Mode de retrait :
        </label>
        <select name="withdraw_mode" id="withdraw_mode" 
                class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-[#551694] focus:ring-[#551694] text-sm" 
                required>
          <option value="">Sélectionnez un mode de retrait</option>
          <option value="orange-money-senegal">🍊 Orange Money Sénégal</option>
          <option value="free-money-senegal">💰 Free Money Sénégal</option>
          <option value="expresso-senegal">📱 Expresso Sénégal</option>
          <option value="wave-senegal">💱 Wave Sénégal</option>
        </select>
      </div>
      
      <div class="bg-white rounded-lg p-4 mb-4">
        <p class="text-sm font-medium text-gray-900 mb-3">Options de paiement disponibles :</p>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex items-center gap-2 text-sm text-gray-700">
            <%= image_tag "payments/wave.png", alt: "Wave", class: "w-7 h-7 object-contain" %>
            <span>Wave Mobile Money</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-700">
            <%= image_tag "payments/om.png", alt: "Orange Money", class: "w-7 h-7 object-contain" %>
            <span>Orange Money</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-700">
            <%= image_tag "payments/yas.png", alt: "Free Money (Yassir)", class: "w-7 h-7 object-contain" %>
            <span>Free Money</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-700">
            <%= image_tag "payments/cash.png", alt: "Cash", class: "w-7 h-7 object-contain" %>
            <span>Carte bancaire</span>
          </div>
        </div>
      </div>
      <ul class="text-xs sm:text-sm text-blue-700 space-y-2 list-disc list-inside">
        <li>Transaction 100% sécurisée</li>
        <li>Choix du mode de paiement sur la page suivante</li>
        <li>Confirmation immédiate de votre commande</li>
      </ul>
    </div>
  <% when "cash_on_delivery", "internal" %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 sm:p-6">
      <h3 class="font-semibold text-yellow-900 mb-3 text-base sm:text-lg"><%= t('.cash_on_delivery_title') %></h3>
      <p class="text-yellow-700 mb-4 text-sm sm:text-base">
        <%= t('.cash_on_delivery_description') %>
      </p>
      <ul class="text-xs sm:text-sm text-yellow-700 space-y-2 list-disc list-inside">
        <li><%= t('.cash_on_delivery_step1') %></li>
        <li><%= t('.cash_on_delivery_step2') %></li>
        <li><%= t('.cash_on_delivery_step3') %></li>
      </ul>
    </div>
  <% when "paydunya" %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 sm:p-6">
      <h3 class="font-semibold text-blue-900 mb-3 text-base sm:text-lg">💳 Paiement sécurisé avec PayDunya</h3>
      <p class="text-blue-700 mb-4 text-sm sm:text-base">
        Après avoir cliqué sur "Valider et payer", vous serez redirigé vers la page de paiement sécurisée PayDunya.
      </p>
      <ul class="text-xs sm:text-sm text-blue-700 space-y-2 list-disc list-inside">
        <li>Paiement par Mobile Money (Wave, Orange Money, Free Money)</li>
        <li>Paiement par carte bancaire</li>
        <li>Transaction 100% sécurisée</li>
        <li>Confirmation immédiate de votre commande</li>
      </ul>
    </div>
  <% else %>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 sm:p-5">
      <p class="text-sm text-gray-600"><%= t('.no_additional_info') %></p>
    </div>
  <% end %>
</div>

