<%# Reusable product card (inline/slider friendly) %>
<%
  item = local_assigns[:item]
  show_discount_badge = local_assigns.fetch(:show_discount_badge, false)
  variant = item&.default_variant || item&.variants&.first
%>

<% if item.present? && variant.present? %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col group">
    <%= link_to item_path(item), class: "block flex-1", data: { turbo_frame: "_top" } do %>
      <!-- Image produit -->
      <div class="relative h-48 bg-[#e3e3ec] flex items-center justify-center overflow-hidden">
        <% if item.has_image? %>
          <%= storage_image_tag(item.display_image, variant_name: :card, alt: item.name, class: "w-full h-full object-contain p-2", width: 400, height: 400) %>
        <% else %>
          <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        <% end %>

        <% if show_discount_badge %>
          <% discount_percent = discount_percentage_for(variant) %>
          <% if discount_percent > 0 %>
            <div class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">
              <%= discount_percent %>%
            </div>
          <% end %>
        <% end %>

        <button class="absolute top-2 right-2 w-8 h-8 bg-white rounded-full flex items-center justify-center hover:bg-gray-50 transition-colors" onclick="event.preventDefault();">
          <svg class="w-5 h-5 text-gray-400 hover:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </button>
      </div>

      <!-- Infos produit -->
      <div class="p-4 flex-1 flex flex-col">
        <h3 class="font-medium text-sm text-gray-900 mb-2 line-clamp-2 group-hover:text-[#551694] transition-colors">
          <%= item.name %>
        </h3>

        <% if item.average_rating.present? %>
          <% rounded_rating = item.average_rating.round %>
          <div class="flex items-center gap-1 mb-2" role="img" aria-label="<%= t('storefront.products.rating', rating: rounded_rating) %>">
            <div class="flex items-center" aria-hidden="true">
              <% 5.times do |i| %>
                <svg class="w-3 h-3 <%= i < rounded_rating ? 'text-yellow-400 fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              <% end %>
            </div>
            <span class="text-xs text-gray-500"><%= item.average_rating.round(1) %></span>
          </div>
        <% end %>

        <% colors = color_values_for(item) %>
        <% if colors.any? %>
          <div class="flex items-center gap-1 mb-2" aria-label="Couleurs disponibles">
            <% colors.first(5).each do |color| %>
              <% hex = color_hex_for(color) %>
              <span class="inline-block w-3.5 h-3.5 rounded-full <%= swatch_needs_dark_border?(hex) ? 'border border-gray-400' : 'border border-gray-200' %>"
                    style="background-color: <%= hex %>;"
                    title="<%= color.value %>"></span>
            <% end %>
            <% if colors.size > 5 %>
              <span class="text-xs text-gray-500 ml-1">+<%= colors.size - 5 %></span>
            <% end %>
          </div>
        <% end %>

        <div class="mt-auto">
          <div class="flex items-center gap-2 mb-3">
            <% current_price = current_price_for(variant) %>
            <% original_price = original_price_for(variant) %>
            <% discount_percent = discount_percentage_for(variant) %>
            <span class="text-base font-bold text-gray-900">
              <%= number_to_currency(current_price, unit: item.currency.symbol, precision: 0, separator: " ", delimiter: " ") %>
            </span>
            <% if discount_percent > 0 && original_price > current_price %>
              <span class="text-sm text-gray-400 line-through">
                <%= number_to_currency(original_price, unit: item.currency.symbol, precision: 0, separator: " ", delimiter: " ") %>
              </span>
            <% end %>
          </div>

          <%= render "shared/add_to_cart_button", item: item, variant: variant, size: "md", style: "outline" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
