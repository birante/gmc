<%= render "shared/auth/auth_header", title: t('vendors.passwords.edit.title'), subtitle: t('vendors.passwords.edit.subtitle') %>

<div class="w-full max-w-md mx-auto">
  <%= form_with model: @vendor, url: vendors_password_path(params[:token]), method: :put, local: true do |f| %>
    <%= render "shared/auth/auth_alert", type: :alert, message: flash[:alert] %>
    <%= render "shared/auth/auth_alert", type: :notice, message: flash[:notice] %>
    <%= render "shared/auth/auth_errors", error_object: f.object %>

    <div class="space-y-5">
      <div>
        <%= f.label :password, t('vendors.passwords.edit.new_password'), class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.password_field :password, placeholder: t('vendors.passwords.edit.new_password_placeholder'), required: true, autocomplete: "new-password", class: "block w-full rounded-md border border-[#E9E9E9] bg-[#F9F9F9] px-3 py-3 text-base focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/20 focus:outline-none transition-colors" %>
      </div>
      <div>
        <%= f.label :password_confirmation, t('vendors.passwords.edit.password_confirmation'), class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.password_field :password_confirmation, placeholder: t('vendors.passwords.edit.password_confirmation_placeholder'), required: true, autocomplete: "new-password", class: "block w-full rounded-md border border-[#E9E9E9] bg-[#F9F9F9] px-3 py-3 text-base focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/20 focus:outline-none transition-colors" %>
      </div>
    </div>

    <div class="mt-6">
      <%= f.submit t('vendors.passwords.edit.submit'), class: "btn w-full rounded-lg bg-[#551694] px-4 py-3 text-base font-medium text-white hover:bg-[#451384] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#551694] focus-visible:ring-offset-2 transition-colors cursor-pointer" %>
    </div>

    <div class="pt-5 mt-5 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-600">
        <%= link_to t('vendors.passwords.edit.back_to_login'), new_vendors_session_path, class: "text-[#551694] hover:text-[#451384] font-medium focus:outline-none focus-visible:underline" %>
      </p>
    </div>
  <% end %>
</div>
