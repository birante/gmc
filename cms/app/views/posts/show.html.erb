<% content_for :title, @post.title %>
<article class="mx-auto max-w-3xl">
  <div class="text-xs text-indigo-600 uppercase tracking-wider mb-2">
    <%= link_to (@post.category&.name || "Uncategorised"), (@post.category ? category_path(@post.category) : "#"), class: "hover:underline" %>
  </div>
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900"><%= @post.title %></h1>
  <div class="mt-3 flex flex-wrap gap-3 items-center text-sm text-slate-500">
    <span><%= @post.author&.full_name || "Anonymous" %></span>
    <span>·</span>
    <span><%= @post.published_at&.strftime("%B %-d, %Y") || "unpublished" %></span>
    <span>·</span>
    <span><%= @post.reading_time %> min read</span>
    <span>·</span>
    <span><%= @post.view_count %> views</span>
    <% if user_signed_in? && current_user.can_edit?(@post) %>
      <span>·</span>
      <%= link_to "Edit", edit_post_path(@post), class: "text-indigo-600 hover:text-indigo-800" %>
      <%= button_to "Delete", @post, method: :delete, form: { data: { turbo_confirm: "Delete this post?" } }, class: "text-red-600 hover:text-red-800 bg-transparent border-0 p-0 underline underline-offset-2" %>
    <% end %>
  </div>

  <div class="prose prose-slate max-w-none mt-8"><%= sanitize @post.content, tags: %w[p br strong em a img h1 h2 h3 h4 ul ol li blockquote code pre hr] %></div>

  <% if @post.tags.any? %>
    <div class="mt-8 flex flex-wrap gap-2">
      <% @post.tags.each do |t| %>
        <%= link_to "##{t.name}", tag_path(t), class: "text-sm text-slate-500 hover:text-indigo-600" %>
      <% end %>
    </div>
  <% end %>

  <% if @post.allow_comments? %>
    <section class="mt-12 border-t border-gray-200 pt-8">
      <h2 class="text-lg font-semibold mb-4">Comments (<%= @post.comments.approved.count %>)</h2>
      <% if user_signed_in? %>
        <%= form_with model: [@post, Comment.new], class: "mb-6" do |f| %>
          <%= f.text_area :content, rows: 3, class: "w-full px-3 py-2 rounded-md border border-gray-300 text-sm", placeholder: "Write a comment…" %>
          <div class="mt-2 text-right">
            <%= f.submit "Post comment", class: "px-3 py-1.5 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-500" %>
          </div>
        <% end %>
      <% else %>
        <p class="mb-6 text-sm text-slate-500"><%= link_to "Sign in", new_user_session_path, class: "underline" %> to leave a comment.</p>
      <% end %>
      <% @post.comments.approved.recent.each do |c| %>
        <div class="mb-4 p-4 rounded-lg bg-white border border-gray-100">
          <div class="text-xs text-slate-500 mb-1"><%= c.user&.full_name || "Guest" %> · <%= time_ago_in_words(c.created_at) %> ago</div>
          <div class="text-sm text-slate-800"><%= simple_format(c.content) %></div>
        </div>
      <% end %>
    </section>
  <% end %>
</article>
