<% content_for :active_tab, 'compte' %>

<%
  target = @pending["target"]
  changes = @pending["changes"] || {}
  new_email = changes["email"]
  new_phone = changes.dig("phone", "phone_number")
  new_cc = changes.dig("phone", "country_code")

  target_label, target_value, channel_label =
    if target == "email"
      [ "Nouvelle adresse email", new_email, "email" ]
    else
      [ "Nouveau numéro de téléphone", "+#{new_cc} #{new_phone}", "SMS" ]
    end
%>

<div class="flex flex-col min-h-screen bg-gray-50">
  <main class="flex-1 px-4 sm:px-6 lg:px-12 xl:px-28 py-6">
    <div class="mb-4">
      <nav class="text-sm text-gray-500 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
        <%= link_to "Dashboard", vendors_dashboard_path, class: "hover:text-[#551694] transition-colors duration-150" %>
        <span class="text-gray-400">/</span>
        <%= link_to "Mon compte", vendors_account_path, class: "hover:text-[#551694] transition-colors duration-150" %>
        <span class="text-gray-400">/</span>
        <span class="text-gray-900 font-medium">Confirmer</span>
      </nav>
    </div>

    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Confirmer le changement</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Un code à 4 chiffres a été envoyé par <%= channel_label %> à <span class="font-semibold text-gray-900"><%= target_value %></span>.
        Saisissez-le ci-dessous pour valider la modification.
      </p>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden max-w-xl">
      <div class="px-4 sm:px-6 py-6 sm:py-8">
        <div class="mb-6">
          <p class="text-sm font-medium text-gray-700 mb-1"><%= target_label %></p>
          <p class="text-base font-semibold text-gray-900"><%= target_value %></p>
        </div>

        <%= form_with url: confirm_change_vendors_account_path, method: :patch, local: true do |f| %>
          <div class="flex flex-col items-center text-center" data-controller="otp">
            <div class="flex w-full max-w-xs items-center justify-center gap-2 sm:gap-3">
              <% 4.times do |i| %>
                <%= text_field_tag "otp_code_#{i}", nil,
                    autocomplete: "one-time-code",
                    maxlength: 1,
                    pattern: "[0-9]",
                    inputmode: "numeric",
                    data: { otp_target: "input", action: "input->otp#handleInput keydown->otp#handleKeydown paste->otp#handlePaste" },
                    class: "h-11 w-11 sm:h-12 sm:w-12 text-center text-lg font-semibold rounded-md border border-[#E9E9E9] bg-[#F9F9F9] focus:border-[#551694] focus:ring-2 focus:ring-[#551694]/20 focus:outline-none transition-colors" %>
              <% end %>
            </div>
            <p class="mt-3 text-sm text-gray-600">
              Vous n'avez pas reçu le code ?
              <%= button_tag "Renvoyer",
                  type: :submit,
                  formaction: resend_change_code_vendors_account_path,
                  formmethod: :post,
                  formnovalidate: true,
                  class: "text-[#551694] hover:text-[#451384] font-medium underline focus:outline-none focus-visible:no-underline" %>
            </p>
          </div>

          <div class="flex flex-col sm:flex-row justify-end gap-3 pt-6 mt-6 border-t border-gray-200">
            <%= link_to "Annuler", vendors_account_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium text-center" %>
            <%= f.submit "Confirmer",
                class: "px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#6a1fa8] hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 font-medium shadow-sm cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>

  <%= render "vendors/shared/footer" %>
</div>
