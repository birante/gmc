<%# Hero Banner Professionnel - Expert UX/UI Design %>
<div class="relative overflow-hidden" style="background: linear-gradient(135deg, <%= primary_color %>, <%= secondary_color %>);">
  <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,<svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><g fill=\"%23ffffff\" fill-opacity=\"0.1\"><path d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/></g></g></svg>');"></div>
  
  <div class="container mx-auto px-4 lg:px-[50px] py-12 md:py-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">
      <%# Contenu texte - Gauche %>
      <div class="text-white space-y-6">
        <%# Breadcrumbs %>
        <nav class="flex items-center gap-2 text-sm text-white/70 mb-4">
          <a href="<%= root_path %>" class="hover:text-white transition-colors">Accueil</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <a href="<%= shops_path %>" class="hover:text-white transition-colors">Boutiques</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-white truncate"><%= shop.name %></span>
        </nav>

        <%# Badge de confiance %>
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <span class="text-sm font-medium">Boutique vérifiée premium</span>
        </div>

        <%# Titre principal %>
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-3"><%= shop.name %></h1>
          <p class="text-xl text-white/90 leading-relaxed max-w-md">
            <%= shop.description.present? ? truncate(shop.description, length: 120) : "" %>
          </p>
        </div>

        <%# Statistiques clés %>
        <div class="grid grid-cols-3 gap-4 pt-6">
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg p-4 hover:bg-white/15 transition-all">
            <div class="text-2xl font-bold text-white"><%= shop.available_items_count %></div>
            <div class="text-sm text-white/70 mt-1">Produits</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg p-4 hover:bg-white/15 transition-all">
            <div class="text-2xl font-bold text-white">4.7★</div>
            <div class="text-sm text-white/70 mt-1">Évaluation</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg p-4 hover:bg-white/15 transition-all">
            <div class="text-2xl font-bold text-white">12K+</div>
            <div class="text-sm text-white/70 mt-1">Clients</div>
          </div>
        </div>

        <%# CTA Buttons %>
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <%= link_to "↓ Découvrir nos offres", "#products", onclick: "document.getElementById('products')?.scrollIntoView({ behavior: 'smooth' })", class: "inline-flex items-center justify-center gap-2 bg-white text-gray-900 px-8 py-4 rounded-lg font-semibold hover:shadow-xl hover:shadow-white/30 transition-all transform hover:scale-[1.02]" %>
          <%= link_to "📞 Nous contacter", "#about", onclick: "document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' })", class: "inline-flex items-center justify-center gap-2 bg-white/20 backdrop-blur-sm text-white px-8 py-4 rounded-lg font-semibold border border-white/30 hover:bg-white/30 transition-all" %>
        </div>
      </div>

      <%# Image Hero - Droite %>
      <div class="relative hidden lg:block">
        <div class="relative h-[500px] rounded-2xl overflow-hidden shadow-2xl">
          <% if shop.banner_image.attached? %>
            <%= storage_image_tag(shop.banner_image,
                variant_name: :banner,
                alt: "Bannière #{shop.name}",
                class: "w-full h-full object-cover",
                eager: true,
                priority: true,
                width: 600,
                height: 500) %>
          <% else %>
            <div class="w-full h-full bg-gradient-to-br from-white/20 to-black/20 flex items-center justify-center">
              <svg class="w-32 h-32 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          <% end %>
          <%# Accent décoratif %>
          <div class="absolute -top-12 -right-12 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
        </div>
        
        <%# Floating cards avec hover effect %>
        <div class="absolute -bottom-6 -left-6 bg-white rounded-xl p-4 shadow-xl transform hover:scale-110 transition-transform">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-gray-600">Paiement sécurisé</div>
              <div class="text-xs text-gray-500">100% garanti</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
