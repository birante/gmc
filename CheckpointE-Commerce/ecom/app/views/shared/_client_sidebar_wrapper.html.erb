<%
  # Variables pour la sidebar
  user ||= current_user
  orders_count = user&.orders&.count || 0
  current_path = request.path
  
  # Déterminer la page active
  active_page = if current_path == client_dashboard_path
    'dashboard'
  elsif current_path.include?('/orders')
    'orders'
  elsif current_path.include?('/addresses')
    'addresses'
  elsif current_path.include?('/account')
    'profile'
  else
    'dashboard'
  end
%>

<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-6 xl:px-8 py-4 sm:py-6 lg:py-8">
  <div class="flex flex-col lg:flex-row gap-4 lg:gap-6">
    <!-- Sidebar -->
    <aside class="lg:w-80 flex-shrink-0">
      <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden lg:sticky lg:top-8 self-start w-full lg:w-auto">
        <!-- En-tête -->
        <details class="group" data-sidebar-details id="sidebar-details" open>
          <summary class="cursor-pointer list-none lg:hidden">
            <div class="p-3 sm:p-4 border-b border-gray-200 flex items-center justify-between">
              <h2 class="text-lg font-semibold text-gray-900">Mon compte</h2>
              <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </summary>
          
          <div class="p-3 sm:p-4 border-b border-gray-200 hidden lg:block">
            <h2 class="text-lg font-semibold text-gray-900">Mon compte</h2>
          </div>

          <div class="px-4">
            <!-- Navigation principale -->
            <nav class="py-2">
              <%= link_to client_dashboard_path, 
                  class: "flex items-center gap-3 px-4 py-3 text-sm transition-all duration-150 rounded-lg #{active_page == 'dashboard' ? 'bg-[#551694]/10 text-[#551694] font-medium' : 'text-gray-500 hover:bg-gray-50 hover:text-[#551694]'}" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span class="truncate">Tableau de bord</span>
              <% end %>

              <%= link_to client_orders_path, 
                  class: "flex items-center gap-3 px-4 py-3 text-sm transition-all duration-150 rounded-lg #{active_page == 'orders' ? 'bg-[#551694]/10 text-[#551694] font-medium' : 'text-gray-500 hover:bg-gray-50 hover:text-[#551694]'}" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span class="truncate">Mes commandes</span>
              <% end %>

              <%= link_to client_account_path, 
                  class: "flex items-center gap-3 px-4 py-3 text-sm transition-all duration-150 rounded-lg #{active_page == 'profile' ? 'bg-[#551694]/10 text-[#551694] font-medium' : 'text-gray-500 hover:bg-gray-50 hover:text-[#551694]'}" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span class="truncate">Mon compte</span>
              <% end %>

              <%= link_to client_addresses_path, 
                  class: "flex items-center gap-3 px-4 py-3 text-sm transition-all duration-150 rounded-lg #{active_page == 'addresses' ? 'bg-[#551694]/10 text-[#551694] font-medium' : 'text-gray-500 hover:bg-gray-50 hover:text-[#551694]'}" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="truncate">Mes adresses</span>
              <% end %>
            </nav>

            <!-- Section "Politique" -->
            <div class="border-t border-gray-200 mt-2">
              <details class="group" open>
                <summary class="cursor-pointer list-none">
                  <div class="px-4 py-3 flex items-center justify-between rounded-lg transition-colors mx-4 #{active_page == 'policy' ? 'bg-[#551694]/10 text-[#551694]' : 'text-gray-500 hover:bg-gray-50'}" onclick="event.preventDefault(); this.closest('details').toggleAttribute('open');">
                    <div class="flex items-center gap-3">
                      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <h4 class="text-sm font-medium">Politique</h4>
                    </div>
                    <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                    </svg>
                  </div>
                </summary>
                <div class="pb-2 px-4">
                  <%= link_to coming_soon_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-[#551694] transition-all duration-150 rounded-lg" do %>
                    <span class="truncate">Livraison</span>
                  <% end %>
                  <%= link_to coming_soon_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-[#551694] transition-all duration-150 rounded-lg" do %>
                    <span class="truncate">Politique de retour</span>
                  <% end %>
                  <%= link_to coming_soon_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-[#551694] transition-all duration-150 rounded-lg" do %>
                    <span class="truncate">Guide d'évaluation</span>
                  <% end %>
                  <%= link_to coming_soon_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-[#551694] transition-all duration-150 rounded-lg" do %>
                    <span class="truncate">Politique de confidentialité & cookies</span>
                  <% end %>
                </div>
              </details>
            </div>

            <!-- Section "Assistance" -->
            <div class="border-t border-gray-200 mt-2 pt-4 pb-4 px-4">
              <div class="bg-gray-50 rounded-lg p-4">
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-2">ASSISTANCE</h4>
                <p class="text-xs text-gray-500 mb-4">Creating or adding new tasks couldn't be easier</p>
                <%= link_to coming_soon_path, class: "flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-[#551694] text-white rounded-lg hover:bg-[#451384] transition-colors text-sm font-medium shadow-sm" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                  </svg>
                  <span>Service Client</span>
                <% end %>
              </div>
            </div>

            <!-- Déconnexion -->
            <div class="border-t border-gray-200 py-4 px-4">
              <%= button_to client_session_path, method: :delete, 
                  class: "flex items-center justify-end gap-2 w-full text-red-600 hover:text-red-700 transition-colors text-sm font-medium",
                  data: { } do %>
                <span>Se Déconnecter</span>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </details>
      </div>
    </aside>

    <!-- Contenu principal -->
    <div class="flex-1 min-w-0">
      <%= yield %>
    </div>
  </div>
</div>

<script>
  // Gérer l'ouverture/fermeture de la sidebar selon la taille d'écran
  document.addEventListener('DOMContentLoaded', function() {
    const sidebarDetails = document.getElementById('sidebar-details');
    if (sidebarDetails) {
      // Ouvrir sur desktop (>= 1024px), fermer sur mobile
      if (window.innerWidth >= 1024) {
        sidebarDetails.setAttribute('open', '');
      } else {
        sidebarDetails.removeAttribute('open');
      }
      
      // Empêcher la fermeture sur desktop
      sidebarDetails.addEventListener('toggle', function() {
        if (window.innerWidth >= 1024 && !this.open) {
          this.open = true;
        }
      });
      
      // Gérer le redimensionnement de la fenêtre
      let resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          if (window.innerWidth >= 1024) {
            sidebarDetails.setAttribute('open', '');
          } else {
            // Sur mobile, on laisse l'utilisateur décider (repliée par défaut)
          }
        }, 100);
      });
    }
  });
</script>

