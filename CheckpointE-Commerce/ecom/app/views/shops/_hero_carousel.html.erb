<%# Hero Carousel - Produits vedettes en défilement %>
<section class="relative overflow-hidden bg-gray-900 rounded-2xl shadow-lg h-[280px] sm:h-[360px] md:h-[420px]" aria-label="<%= t('shops.hero_carousel_label', default: 'Produits vedettes') %>">
  <%# Carrousel des produits/images %>
  <div class="relative w-full h-full group">
    <%# Slides avec défilement automatique via CSS animations %>
    <div class="carousel-container relative w-full h-full" data-carousel>
      <% featured_products = local_assigns[:featured_products] || @featured_products || shop.available_items.includes(:variants, main_image_attachment: :blob, images_attachments: :blob).limit(5) %>
      <% valid_products = featured_products.select { |p| p.default_variant || p.variants.first }.take(5) %>
      <% display_index = 0 %>
      <% valid_products.each do |product| %>
        <% variant = product.default_variant || product.variants.first %>
        <div class="carousel-slide absolute inset-0 transition-opacity duration-1000" data-slide="<%= display_index %>" style="opacity: <%= display_index == 0 ? 1 : 0 %>;">
          <%# Image d'arrière-plan avec overlay dégradé %>
          <div class="absolute inset-0">
            <% if product.images.attached? %>
              <%= image_tag product.images.first, alt: product.name, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="w-full h-full" style="background: linear-gradient(135deg, <%= primary_color %>, <%= secondary_color %>);"></div>
            <% end %>
            <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.3) 100%);"></div>
          </div>

          <%# Contenu centré de la slide %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-full max-w-7xl mx-auto px-4 lg:px-8 z-10">
              <div class="max-w-2xl mx-auto text-center">
                <%# Badge de catégorie %>
                <div class="inline-flex items-center gap-2 mb-3 px-3 py-1.5 rounded-full" style="background-color: <%= primary_color %>CC; color: white;">
                  <span class="text-sm font-semibold">🌟 Produit vedette</span>
                </div>

                <%# Titre et description du produit %>
                <h2 class="text-xl sm:text-2xl md:text-4xl lg:text-5xl font-bold text-white mb-2 leading-tight"><%= product.name %></h2>
                <p class="text-sm sm:text-base md:text-lg text-white/90 mb-2 md:mb-4 leading-relaxed max-w-lg mx-auto line-clamp-2 sm:line-clamp-3"><%= truncate(product.description, length: 150) %></p>

                <%# Prix et CTA %>
                <% currency_symbol = product.currency&.symbol.presence || "F" %>
                <div class="flex items-center gap-4 mb-5">
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl sm:text-3xl md:text-4xl font-bold text-white"><%= number_to_currency(variant.current_price, unit: currency_symbol, precision: 0, format: "%n %u", separator: ",", delimiter: " ") %></span>
                    <% if variant.original_price.present? && variant.original_price > variant.current_price %>
                      <span class="text-xl text-white/60 line-through"><%= number_to_currency(variant.original_price, unit: currency_symbol, precision: 0, format: "%n %u", separator: ",", delimiter: " ") %></span>
                    <% end %>
                  </div>
                </div>

                <%# Boutons d'action %>
                <div class="flex flex-col sm:flex-row flex-wrap gap-2 sm:gap-4 justify-center w-full px-4 sm:px-0">
                  <a href="<%= item_path(product) %>" data-turbo-frame="_top" class="px-4 sm:px-8 py-2.5 sm:py-4 text-sm sm:text-base rounded-lg font-semibold text-white transition-all transform hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2" style="background-color: <%= primary_color %>; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                    Voir le produit →
                  </a>
                  <a href="#products-section" class="px-4 sm:px-8 py-2.5 sm:py-4 text-sm sm:text-base rounded-lg font-semibold text-white bg-white/20 backdrop-blur-sm border border-white/30 hover:bg-white/30 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
                    Explorer tous les produits
                  </a>
                </div>

                <%# Indicateurs de slide %>
                <div class="flex gap-2 mt-6 justify-center">
                  <% valid_products.each_with_index do |_, i| %>
                    <button class="carousel-indicator w-3 h-3 rounded-full transition-all duration-300 cursor-pointer" 
                            data-slide="<%= i %>"
                            style="background-color: <%= i == 0 ? 'white' : 'rgba(255,255,255,0.5)' %>; width: <%= i == 0 ? '32px' : '12px' %>;"
                            aria-label="Aller à la slide <%= i + 1 %>">
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% display_index += 1 %>
      <% end %>

      <%# Boutons navigation carousel %>
      <button type="button" class="carousel-prev absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 bg-white/30 hover:bg-white/50 text-white rounded-full p-3 transition-all backdrop-blur-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2" aria-label="Slide précédente">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button type="button" class="carousel-next absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 bg-white/30 hover:bg-white/50 text-white rounded-full p-3 transition-all backdrop-blur-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2" aria-label="Slide suivante">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <%# Auto-play indicator - barre de progression animée %>
      <div class="absolute bottom-0 left-0 h-1 bg-white/20" style="width: 100%;">
        <div class="h-full bg-gradient-to-r" style="background: linear-gradient(to right, <%= primary_color %>, <%= secondary_color %>); width: 0%; animation: progress 8s linear infinite;"></div>
      </div>
    </div>
  </div>
</section>

  <%# Stimulus Controller pour carousel interactif %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const carousel = document.querySelector('[data-carousel]');
      if (!carousel) return;

      const slides = carousel.querySelectorAll('.carousel-slide');
      const indicators = carousel.querySelectorAll('.carousel-indicator');
      const prevBtn = carousel.querySelector('.carousel-prev');
      const nextBtn = carousel.querySelector('.carousel-next');
      
      let currentSlide = 0;
      let autoplayInterval;

      function showSlide(n) {
        if (n >= slides.length) currentSlide = 0;
        if (n < 0) currentSlide = slides.length - 1;

        slides.forEach((slide, index) => {
          slide.style.opacity = index === currentSlide ? '1' : '0';
        });

        indicators.forEach((indicator, index) => {
          if (index === currentSlide) {
            indicator.style.backgroundColor = 'white';
            indicator.style.width = '32px';
          } else {
            indicator.style.backgroundColor = 'rgba(255,255,255,0.5)';
            indicator.style.width = '12px';
          }
        });
      }

      function nextSlide() {
        currentSlide++;
        showSlide(currentSlide);
        resetAutoplay();
      }

      function prevSlide() {
        currentSlide--;
        showSlide(currentSlide);
        resetAutoplay();
      }

      function startAutoplay() {
        autoplayInterval = setInterval(nextSlide, 8000);
      }

      function resetAutoplay() {
        clearInterval(autoplayInterval);
        startAutoplay();
      }

      prevBtn?.addEventListener('click', prevSlide);
      nextBtn?.addEventListener('click', nextSlide);
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          currentSlide = index;
          showSlide(currentSlide);
          resetAutoplay();
        });
      });

      carousel.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
      carousel.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    });
  </script>

  <style>
    @keyframes progress {
      0% { width: 0%; }
      100% { width: 100%; }
    }
  </style>
