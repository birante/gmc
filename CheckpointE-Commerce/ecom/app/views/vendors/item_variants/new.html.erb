<% content_for :active_tab, 'catalogue' %>
<% is_xof_currency = @item.currency&.code == "XOF" %>

<div class="flex flex-col min-h-screen bg-gray-50">
  <main class="flex-1 px-4 sm:px-6 lg:px-12 xl:px-28 py-6">
    <nav class="mb-4 text-sm" aria-label="Fil d'Ariane">
      <ol class="flex flex-wrap items-center gap-2 text-gray-500">
        <li>
          <%= link_to t('vendors.items.index.title'), url_with_shop(vendors_items_path, @current_shop), class: "hover:text-gray-900 transition-colors" %>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <%= link_to @item.name, url_with_shop(vendors_item_path(@item), @current_shop), class: "hover:text-gray-900 transition-colors truncate max-w-xs" %>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <%= link_to "Variantes", url_with_shop(vendors_item_variants_path(@item), @current_shop), class: "hover:text-gray-900 transition-colors" %>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-700 font-medium">Nouvelle variante</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-4">
        <%= link_to url_with_shop(vendors_item_variants_path(@item), @current_shop),
            class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors text-sm font-medium" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Retour aux variantes
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-gray-900">Ajouter une variante</h1>
      <p class="text-gray-600 mt-2">Produit : <%= @item.name %></p>
    </div>

    <!-- Formulaire -->
    <%= form_with model: @variant, url: url_with_shop(vendors_item_variants_path(@item), @current_shop), method: :post, local: true, class: "w-full" do |f| %>
      <% if @variant.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <h3 class="font-bold mb-2"><%= pluralize(@variant.errors.count, 'erreur') %> :</h3>
          <ul class="list-disc list-inside">
            <% @variant.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-white rounded-lg shadow p-6 space-y-6">
        <!-- Informations de la variante -->
        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations de la variante</h2>
          
          <div class="space-y-4">
            <!-- Sélection des attributs -->
            <% if @item_attributes.any? %>
              <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg mb-4">
                <p class="text-sm text-blue-700 mb-2">
                  💡 Sélectionnez les valeurs d'attributs pour cette variante
                </p>
              </div>

              <% @item_attributes.each do |item_attribute| %>
                <div>
                  <%= label_tag "attribute_#{item_attribute.id}", item_attribute.name, class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <div class="space-y-2">
                    <% item_attribute.attribute_values.each do |attr_value| %>
                      <label class="flex items-center p-3 border border-gray-300 rounded-lg hover:bg-gray-50 cursor-pointer">
                        <%= check_box_tag "item_variant[attribute_value_ids][]", attr_value.id, false, 
                            class: "w-4 h-4 text-[#551694] border-gray-300 rounded focus:ring-[#551694]" %>
                        <span class="ml-3 text-gray-900"><%= attr_value.value %></span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                <p class="text-sm text-yellow-700">
                  ⚠️ Aucun attribut défini. Vous pouvez créer une variante simple sans attributs.
                </p>
              </div>
            <% end %>

            <!-- SKU -->
            <div>
              <%= f.label :sku, "SKU (Référence)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.text_field :sku, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-opacity-20", placeholder: "Ex: PROD-001-ROUGE-M" %>
            </div>

            <!-- Prix -->
            <div>
              <%= f.label :price, "Prix (#{@item.currency.symbol})", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.number_field :price,
                  step: (is_xof_currency ? 1 : 0.01),
                  min: (is_xof_currency ? 1 : 0.01),
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-opacity-20",
                  placeholder: (is_xof_currency ? "0" : "0.00"),
                  required: true %>
            </div>

            <!-- Stock -->
            <div>
              <%= f.label :stock_quantity, "Quantité en stock", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.number_field :stock_quantity, min: 0, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#551694] focus:ring-opacity-20", placeholder: "0", required: true %>
            </div>

            <!-- Variante par défaut -->
            <div class="flex items-center">
              <%= f.check_box :is_default, class: "w-4 h-4 text-[#551694] border-gray-300 rounded focus:ring-[#551694]" %>
              <%= f.label :is_default, "Définir comme variante par défaut", class: "ml-2 text-sm text-gray-700" %>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-3 pt-4 border-t">
          <%= f.submit "Créer la variante", 
              class: "px-6 py-3 bg-[#551694] text-white rounded-lg hover:bg-[#451384] transition-colors font-medium" %>
          <%= link_to "Annuler", 
              url_with_shop(vendors_item_variants_path(@item), @current_shop),
              class: "px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium" %>
        </div>
      </div>
    <% end %>
  </main>

  <%= render "vendors/shared/footer" %>
</div>
