<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "aaapps" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%# Analytics Scripts %>
    <%= render "shared/analytics" %>
    <%= render "shared/recaptcha" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>
  <body class="min-h-screen bg-white">
    <!-- Header mobile avec navigation -->
    <div class="md:hidden flex items-center justify-between px-4 py-3 bg-white border-b border-gray-200 sticky top-0 z-10">
      <%= link_to root_path, class: "flex items-center text-gray-700 hover:text-[#551694] transition-colors" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="text-sm font-medium"><%= t('navigation.back_home') %></span>
      <% end %>
      <% if session[:vendor_id].blank? %>
        <%= link_to new_vendors_session_path, class: "text-[#551694] hover:text-[#8953FF] text-sm font-medium" do %>
          <%= t('navigation.login') %>
        <% end %>
      <% end %>
    </div>
    <div class="flex min-h-screen flex-col md:grid md:min-h-screen md:grid-cols-2">
      <!-- Partie gauche - Formulaire -->
      <div class="w-full bg-white px-4 py-3 md:flex md:min-h-screen md:min-w-0 md:items-center md:justify-center md:overflow-y-auto md:px-8 md:py-6 lg:px-10">
        <div class="w-full max-w-xl pb-6 md:pb-8">
          <%= yield %>
        </div>
      </div>
      <!-- Partie droite - Visuel split (masquée sur mobile) -->
      <div class="relative hidden h-full overflow-hidden md:block md:min-w-0">
        <%= link_to root_path, class: "absolute left-6 top-6 z-10 inline-flex items-center gap-2 rounded-full bg-white/92 px-4 py-2 text-sm font-medium text-[#362526] shadow-sm ring-1 ring-black/5 backdrop-blur-sm transition hover:bg-white hover:text-[#551694]" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span><%= t('navigation.back_home') %></span>
        <% end %>
        <%= image_tag "auth/vendors.svg", alt: "Gérez votre boutique et vos ventes sur aa", class: "w-full h-full object-cover object-center" %>
        <div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent pointer-events-none"></div>
      </div>
    </div>
  </body>
</html>
